// libFuzzer target: libcurl's date parser, securl::date. tools/build-fuzzers.sh builds it, and `make fuzz` runs it.
// A panic, which stops the program, is a crash for libFuzzer.
import core::option;
import std::vec;
import securl::date;

/// The input of libFuzzer as bytes.
fn input_of(data : *const u8, len : i64) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  let mut i = 0i64;
  while i < len {
    bytes.push(unsafe { data[i] });
    i = i + 1i64;
  }
  return bytes;
}

extern fn vx_fuzz_one(data : *const u8, len : i64) -> i32 {
  let input = input_of(data, len);
  match parse_date(&input) {
    Option<i64>::Some(t) => {
      let _c = compact_date(t);
    },
    Option<i64>::None() => {}
  }
  return 0;
}
