// The curl command-line tool: read the command line, run the transfers, write the results.
//
// `tool_main` gets the rights of the program from `main`, in `root`. It gives the network
// right only to the transfer, and it keeps the right to open files for itself: it reads the
// files that the command line names and opens the output files. It reads the proxy variables
// of the environment with the environment right, and gives the transfer only their values. So
// the parsers of the command line, of URLs and of responses can neither open a file nor a
// connection, nor read the environment, and the compiler checks that.
import core::option;
import core::result;
import std::env;
import std::fs;
import std::io;
import std::net;
import std::root;
import std::string;
import std::vec;
import sys::console;
import sys::hash;
import sys::text;
import sys::tls;
import securl::body;
import securl::encode;
import securl::bytes;
import securl::cookie;
import securl::failure;
import securl::form;
import securl::hsts;
import securl::http;
import securl::options;
import securl::output;
import securl::fetch;
import securl::url;
import securl::writeout;
import disk::files;
import sys::files;

/// The words of the command line after the program name, as bytes, which securl parses as curl
/// does.
fn words_of(args : &Vec<String>) -> Vec<Vec<u8>> {
  let mut out = Vec<Vec<u8>>::new();
  let mut i = 1;
  while i < args.len() {
    out.push(args.get_ref(i).to_bytes());
    i = i + 1;
  }
  return out;
}

/// The value of the environment variable `name`, a string literal. Gives an empty list when the
/// variable is not set, is empty, or is not UTF-8. curl takes an empty variable as one that is
/// not set too.
fn env_var(env : &Environment, name : *const i8) -> Vec<u8> {
  match String::from_utf8(&lit(name)) {
    Result<String, Utf8Error>::Ok(key) => {
      match env.var(&key) {
        Result<String, EnvError>::Ok(value) => {
          return value.to_bytes();
        },
        Result<String, EnvError>::Err(_e) => {
          return Vec<u8>::new();
        }
      }
    },
    Result<String, Utf8Error>::Err(_e) => {
      return Vec<u8>::new();
    }
  }
}

/// Add the environment variable `name` to `out` when it has a value.
fn add_env(out : &mut Vec<EnvVar>, env : &Environment, name : *const i8) -> void {
  let value = env_var(env, name);
  if value.len() > 0 {
    out.push(EnvVar {
      name : lit(name),
      value : value
    });
  }
}

/// The width of the terminal for warnings, as curl takes it: `COLUMNS` when it is a number
/// from 21 to 10000, and else 79. curl asks the terminal too, which securl does not yet.
fn columns_of(env : &Environment) -> i32 {
  match parse_u64(&env_var(env, "COLUMNS")) {
    Option<u64>::Some(n) => {
      if n > 20u64 && n <= 10000u64 {
        return n as i32;
      }
    },
    Option<u64>::None() => {}
  }
  return 79;
}

/// The proxy variables of the environment that libcurl reads for HTTP and HTTPS. Only the
/// lower-case `http_proxy`, as in libcurl: a CGI program gets `HTTP_PROXY` from the `Proxy:`
/// header of a request, which anyone can send.
fn proxy_env(env : &Environment) -> Vec<EnvVar> {
  let mut out = Vec<EnvVar>::new();
  add_env(&mut out, env, "http_proxy");
  add_env(&mut out, env, "https_proxy");
  add_env(&mut out, env, "HTTPS_PROXY");
  add_env(&mut out, env, "all_proxy");
  add_env(&mut out, env, "ALL_PROXY");
  add_env(&mut out, env, "no_proxy");
  add_env(&mut out, env, "NO_PROXY");
  return out;
}

/// The program, with the rights of `main` and the words of its command line. It gives the exit
/// code of curl.
pub fn tool_main(root : Root, command_line : Vec<String>) -> i32 {
  ignore_sigpipe();
  // The rights to the terminal. Only the code that gets them can use them.
  let mut console = Console {
    out : root.stdout,
    err : root.stderr
  };
  let mut stdin = root.stdin;
  let args = words_of(&command_line);
  let columns = columns_of(&root.env);
  let mut parser = new_arg_parser();
  match read_command_line(&mut parser, &args, &root.files, &mut stdin, &mut console, columns) {
    Result<i32, Failure>::Ok(_n) => {},
    Result<i32, Failure>::Err(f) => {
      let mut m = lit("curl: ");
      append(&mut m, &f.message);
      push_lit(&mut m, "\ncurl: try 'curl --help' for more information\n");
      console.to_stderr(&m);
      return f.code;
    }
  }
  let mut groups = parser.finish();
  let env_vars = proxy_env(&root.env);
  for cfg in groups.iter_mut() {
    cfg.proxy_env = clone_env(&env_vars);
    cfg.columns = columns;
  }
  // As curl does while it reads the command line: a `--cacert` or `--proxy-cacert` file must
  // exist.
  for cfg in groups.iter() {
    if !cfg.show_help && !cfg.show_version
       && (!file_given_exists(&mut console, &root.files, &cfg.cacert, "cacert")
         || !file_given_exists(&mut console, &root.files, &cfg.proxy_cacert, "proxy-cacert")) {
      return FAILED_INIT;
    }
  }
  return run(&root.network, &root.files, &mut stdin, &mut console, &groups);
}

fn clone_env(vars : &Vec<EnvVar>) -> Vec<EnvVar> {
  let mut out = Vec<EnvVar>::new();
  for v in vars.iter() {
    out.push(EnvVar {
      name : clone_bytes(&v.name),
      value : clone_bytes(&v.value)
    });
  }
  return out;
}

// How deep config files of `-K` may name more config files: curl's CONFIG_MAX_LEVELS.
const CONFIG_MAX_LEVELS : i32 = 5;

/// Read the command line into `parser`, with the config file of each `-K`, which the tool
/// reads with its file right. The parser itself cannot open a file.
fn read_command_line(parser : &mut ArgParser, args : &Vec<Vec<u8>>, files : &Files,
stdin : &mut Stdin, console : &mut Console, columns : i32) -> Result<i32, Failure> {
  let mut at = 0;
  loop {
    let read = parser.words(args, at);
    print_warnings(console, parser, columns);
    let stop = read?;
    if stop.has_config {
      match read_config(parser, &stop.config_file, files, stdin, console, columns,
        CONFIG_MAX_LEVELS - 1) {
        Result<i32, ConfigError>::Ok(_n) => {},
        Result<i32, ConfigError>::Err(e) => {
          let mut m = lit("option ");
          append(&mut m, &stop.config_option);
          push_lit(&mut m, ": ");
          append(&mut m, &e.reason);
          return Result<i32, Failure>::Err(fail_with(e.code, m));
        }
      }
    }
    if stop.finished {
      return Result<i32, Failure>::Ok(0);
    }
    at = stop.at;
  }
}

/// Print the warnings of the parser so far.
fn print_warnings(console : &mut Console, parser : &mut ArgParser, columns : i32) -> void {
  for w in parser.take_warnings().iter() {
    console.to_stderr(&message_lines("Warning: ", w, columns));
  }
}

/// An error line of curl's `errorf`: wrapped at the width of the terminal, and silent with `-s`
/// unless `-S` is given too.
fn error_line(console : &mut Console, parser : &ArgParser, text : &Vec<u8>, columns : i32) -> void {
  if parser.errors_shown() {
    console.to_stderr(&message_lines("curl: ", text, columns));
  }
}

/// Read the config file `name` of `-K` (`-` for standard input) into `parser`, as curl's
/// `parseconfig`. `levels` is how many more files deep it may go. On an error, it prints curl's
/// line about it, and gives the reason for the option that read the file.
fn read_config(parser : &mut ArgParser, name : &Vec<u8>, files : &Files, stdin : &mut Stdin,
console : &mut Console, columns : i32, levels : i32) -> Result<i32, ConfigError> {
  let mut shown = clone_bytes(name);
  if eq_lit(name, "-") {
    shown = lit("<stdin>");
  }
  let mut text = Vec<u8>::new();
  match read_file(files, stdin, name) {
    Result<Vec<u8>, Failure>::Ok(bytes) => {
      text = bytes;
    },
    Result<Vec<u8>, Failure>::Err(_f) => {
      error_line(console, parser, &lit_then("cannot read config from '", &lit_then_lit(&shown, "'")),
        columns);
      return Result<i32, ConfigError>::Err(ConfigError {
        text : Vec<u8>::new(),
        reason : lit("error encountered when reading a file"),
        code : READ_ERROR
      });
    }
  }
  let lines = config_lines(&text, &shown);
  for line in lines.iter() {
    if line.warning.len() > 0 && !parser.silent_now() {
      console.to_stderr(&message_lines("Warning: ", &line.warning, columns));
    }
    let result = parser.config_line(line, &shown);
    print_warnings(console, parser, columns);
    match result {
      Result<Step, ConfigError>::Ok(step) => {
        if step.has_config {
          let mut nested = Result<i32, ConfigError>::Ok(0);
          if levels - 1 < 0 {
            error_line(console, parser, &lit("Max config file recursion level reached (5)"), columns);
            nested = Result<i32, ConfigError>::Err(ConfigError {
              text : Vec<u8>::new(),
              reason : lit("is badly used here"),
              code : FAILED_INIT
            });
          } else {
            nested = read_config(parser, &step.config_file, files, stdin, console, columns,
              levels - 1);
          }
          match nested {
            Result<i32, ConfigError>::Ok(_n) => {},
            Result<i32, ConfigError>::Err(inner) => {
              let outer = config_error(&shown, line.lineno, &line.option, &inner.reason,
                &inner.reason, inner.code);
              error_line(console, parser, &outer.text, columns);
              return Result<i32, ConfigError>::Err(outer);
            }
          }
        }
      },
      Result<Step, ConfigError>::Err(e) => {
        error_line(console, parser, &e.text, columns);
        return Result<i32, ConfigError>::Err(e);
      }
    }
  }
  return Result<i32, ConfigError>::Ok(0);
}

/// `a` and then the string literal `s`.
fn lit_then_lit(a : &Vec<u8>, s : *const i8) -> Vec<u8> {
  let mut out = clone_bytes(a);
  push_lit(&mut out, s);
  return out;
}

/// Print `curl: (code) message` unless `-s` asks for silence and `-S` does not bring errors
/// back.
fn report(console : &mut Console, cfg : &Config, f : &Failure) -> void {
  if cfg.silent && !cfg.show_error {
    return;
  }
  let mut m = lit("curl: (");
  push_i64(&mut m, f.code as i64);
  push_lit(&mut m, ") ");
  append(&mut m, &f.message);
  push_lit(&mut m, "\n");
  if f.code == PEER_FAILED_VERIFICATION {
    // curl's advice after a certificate that it could not check.
    push_lit(&mut m, "More details here: https://curl.se/docs/sslcerts.html\n\n");
    push_lit(&mut m, "curl failed to verify the legitimacy of the server and therefore could not\n");
    push_lit(&mut m, "establish a secure connection to it. To learn more about this situation and\n");
    push_lit(&mut m, "how to fix it, please visit the webpage mentioned above.\n");
  }
  console.to_stderr(&m);
}

fn print_version(console : &mut Console) -> void {
  let mut m = lit("curl ");
  append(&mut m, &securl_version());
  push_lit(&mut m, " (x86_64-pc-linux-gnu) libcurl/");
  append(&mut m, &securl_version());
  push_lit(&mut m, " ");
  append(&mut m, &tls_library_version());
  push_lit(&mut m, "\nRelease-Date: [unreleased]\nProtocols: http https\nFeatures: brotli HSTS HTTP2 HTTPS-proxy IPv6 Largefile libz SSL zstd\n");
  let _ok = console.to_stdout(&m);
}

fn print_help(console : &mut Console) -> void {
  let mut m = Vec<u8>::new();
  push_lit(&mut m, "Usage: curl [options...] <url>\n");
  push_lit(&mut m, "securl: the curl tool for HTTP/1.1 and HTTPS, written in Vx. Options:\n");
  push_lit(&mut m, " -d, --data <data>          HTTP POST data (--data-ascii, --data-raw, --data-binary)\n");
  push_lit(&mut m, "     --data-urlencode <data> HTTP POST data, URL-encoded\n");
  push_lit(&mut m, "     --json <data>          HTTP POST JSON\n");
  push_lit(&mut m, " -F, --form <name=content>  Specify multipart MIME data\n");
  push_lit(&mut m, "     --form-string <name=string> Specify multipart MIME data\n");
  push_lit(&mut m, " -f, --fail                 Fail fast with no output on HTTP errors\n");
  push_lit(&mut m, "     --fail-with-body       Fail on HTTP errors but save the body\n");
  push_lit(&mut m, " -G, --get                  Put the post data in the URL and use GET\n");
  push_lit(&mut m, " -H, --header <header>      Pass a custom header to the server\n");
  push_lit(&mut m, " -I, --head                 Show document info only\n");
  push_lit(&mut m, " -i, --include              Include response headers in the output\n");
  push_lit(&mut m, " -k, --insecure             Allow insecure server connections\n");
  push_lit(&mut m, "     --cacert <file>        CA certificate to verify peer against\n");
  push_lit(&mut m, "     --capath <dir>         CA directory to verify peer against\n");
  push_lit(&mut m, " -L, --location             Follow redirects\n");
  push_lit(&mut m, "     --max-redirs <num>     Maximum number of redirects allowed\n");
  push_lit(&mut m, " -o, --output <file>        Write to file instead of stdout\n");
  push_lit(&mut m, " -O, --remote-name          Write output to a file named as the remote file\n");
  push_lit(&mut m, "     --output-dir <dir>     Directory to save files in\n");
  push_lit(&mut m, " -D, --dump-header <file>   Write the received headers to <file>\n");
  push_lit(&mut m, " -s, --silent               Silent mode\n");
  push_lit(&mut m, " -S, --show-error           Show error even when -s is used\n");
  push_lit(&mut m, " -T, --upload-file <file>   Transfer local FILE to destination\n");
  push_lit(&mut m, " -u, --user <user:password> Server user and password\n");
  push_lit(&mut m, "     --digest               HTTP Digest Authentication\n");
  push_lit(&mut m, "     --basic                HTTP Basic Authentication (the default)\n");
  push_lit(&mut m, "     --anyauth              Pick any authentication method\n");
  push_lit(&mut m, " -A, --user-agent <name>    Send User-Agent <name> to server\n");
  push_lit(&mut m, " -e, --referer <URL>        Referrer URL\n");
  push_lit(&mut m, " -b, --cookie <data|filename> Send cookies from string/load from file\n");
  push_lit(&mut m, " -c, --cookie-jar <filename> Save cookies to <filename> after operation\n");
  push_lit(&mut m, " -j, --junk-session-cookies Ignore session cookies read from file\n");
  push_lit(&mut m, " -r, --range <range>        Retrieve only the bytes within RANGE\n");
  push_lit(&mut m, " -v, --verbose              Make the operation more talkative\n");
  push_lit(&mut m, " -w, --write-out <format>   Use output FORMAT after completion\n");
  push_lit(&mut m, " -X, --request <method>     Specify request method to use\n");
  push_lit(&mut m, " -x, --proxy <proxy>        Use this HTTP proxy\n");
  push_lit(&mut m, " -U, --proxy-user <u:p>     Proxy user and password\n");
  push_lit(&mut m, "     --proxy-digest         Digest Authentication with the proxy\n");
  push_lit(&mut m, "     --proxy-anyauth        Pick any proxy authentication method\n");
  push_lit(&mut m, " -m, --max-time <seconds>   Maximum time allowed for transfer\n");
  push_lit(&mut m, "     --connect-timeout <seconds> Maximum time allowed to connect\n");
  push_lit(&mut m, "     --noproxy <hosts>      List of hosts which do not use a proxy\n");
  push_lit(&mut m, "     --resolve <host:port:addr> Resolve the host+port to this address\n");
  push_lit(&mut m, "     --connect-to <HOST1:PORT1:HOST2:PORT2> Connect to host\n");
  push_lit(&mut m, " -0, --http1.0              Use HTTP 1.0\n");
  push_lit(&mut m, "     --http1.1              Use HTTP/1.1\n");
  push_lit(&mut m, "     --http2                Use HTTP/2 (the default over TLS)\n");
  push_lit(&mut m, "     --http2-prior-knowledge Use HTTP/2 without HTTP/1.1 Upgrade\n");
  push_lit(&mut m, " -h, --help                 Get help for commands\n");
  push_lit(&mut m, " -V, --version              Show version number and quit\n");
  let _ok = console.to_stdout(&m);
}

/// Open the output of transfer number `index`: a `-o` file, a `-O` file, or standard output.
fn open_output(files : &Files, cfg : &Config, index : i32, url_text : &Vec<u8>,
state : &mut OutputState) -> Result<Output, Failure> {
  if index < cfg.outputs.len() {
    let name = cfg.outputs.get_ref(index);
    if eq_lit(name, "-") {
      return Result<Output, Failure>::Ok(stdout_output());
    }
    let file = create_output_file(files, &in_output_dir(cfg, name), state)?;
    return Result<Output, Failure>::Ok(file_output(file));
  }
  if cfg.remote_name_all || index - cfg.outputs.len() < cfg.remote_names {
    let u = parse_url(url_text, cfg.path_as_is)?;
    let name = remote_file_name(&u);
    if name.len() == 0 {
      return Result<Output, Failure>::Err(fail_lit(WRITE_ERROR,
        "Remote filename has no length"));
    }
    let file = create_output_file(files, &in_output_dir(cfg, &name), state)?;
    return Result<Output, Failure>::Ok(file_output(file));
  }
  return Result<Output, Failure>::Ok(stdout_output());
}

/// What the tool knows about the output file of a transfer, to clean up after one that failed.
struct OutputState {
  // The file, or empty for standard output.
  path : Vec<u8>,
  // securl made the file: it was not there before.
  created : bool,
  // A byte went to the file.
  written : bool,
}

/// Create the output file `path`, and note it in `state`.
fn create_output_file(files : &Files, path : &Vec<u8>, state : &mut OutputState)
-> Result<File, Failure> {
  state.created = !file_exists(files, path);
  let file = create_file(files, path)?;
  state.path = clone_bytes(path);
  return Result<File, Failure>::Ok(file);
}

/// Clean up the output file of a transfer that failed. curl opens its output file only when the
/// first byte arrives, and securl opened it before the transfer. So an empty file that securl
/// made goes away again. With `--remove-on-error`, a file with bytes goes too, when it is a
/// regular file, with curl's messages.
fn clean_failed_output(console : &mut Console, files : &Files, cfg : &Config, state : &OutputState)
-> void {
  if state.path.len() == 0 {
    return;
  }
  if !state.written {
    if state.created && is_regular_file(files, &state.path) {
      let _gone = remove_file(files, &state.path);
    }
    return;
  }
  if !cfg.remove_on_error {
    return;
  }
  let quiet = cfg.silent;
  if !is_regular_file(files, &state.path) {
    if !quiet {
      console.to_stderr(&message_lines("Warning: ",
        &lit_then("Skipping removal; not a regular file: ", &state.path), cfg.columns));
    }
    return;
  }
  let removed = remove_file(files, &state.path);
  if removed && (cfg.verbose || cfg.has_trace) && !quiet {
    console.to_stderr(&message_lines("Note: ", &lit_then("Removed output file: ", &state.path),
      cfg.columns));
  }
  if !removed && !quiet {
    console.to_stderr(&message_lines("Warning: ", &lit_then("Failed removing: ", &state.path),
      cfg.columns));
  }
  return;
}


/// The path of an output file: inside `--output-dir` when the name is not absolute.
fn in_output_dir(cfg : &Config, name : &Vec<u8>) -> Vec<u8> {
  if !cfg.has_output_dir || (name.len() > 0 && name.get(0) == 47u8) {
    return clone_bytes(name);
  }
  let mut out = clone_bytes(&cfg.output_dir);
  if out.len() > 0 && out.get(out.len() - 1) != 47u8 {
    out.push(47u8);
  }
  append(&mut out, name);
  return out;
}

/// Open the output of `-D`, or an output that drops what it gets.
fn open_header_output(files : &Files, cfg : &Config) -> Result<Output, Failure> {
  if !cfg.has_dump_header {
    return Result<Output, Failure>::Ok(null_output());
  }
  if eq_lit(&cfg.dump_header, "-") {
    return Result<Output, Failure>::Ok(stdout_output());
  }
  let file = create_file(files, &cfg.dump_header)?;
  return Result<Output, Failure>::Ok(file_output(file));
}

/// The URL of an upload: curl adds the name of the file when the URL ends in `/`.
fn upload_url(url_text : &Vec<u8>, file_name : &Vec<u8>) -> Vec<u8> {
  let mut out = clone_bytes(url_text);
  if eq_lit(file_name, "-") || url_text.len() == 0 {
    return out;
  }
  let slash = rfind_byte(file_name, 47u8);
  let base = url_encode(&rest_from(file_name, slash + 1));
  let scheme_end = find_seq(url_text, &lit("://"), 0);
  let path_start = find_byte(url_text, 47u8, scheme_end + 3);
  if scheme_end >= 0 && path_start < 0 {
    push_lit(&mut out, "/");
    append(&mut out, &base);
    return out;
  }
  if url_text.get(url_text.len() - 1) == 47u8 {
    append(&mut out, &base);
  }
  return out;
}

/// Run every transfer of the command line, and give the exit code.
/// Run the groups of the command line, one after the other, and give the exit code of the last
/// transfer, as curl does. The cookies and the HSTS cache go on from one group to the next, as
/// curl shares them.
fn run(network : &Network, files : &Files, stdin : &mut Stdin, console : &mut Console,
groups : &Vec<Config>) -> i32 {
  let first = groups.get_ref(0);
  if first.show_help {
    print_help(console);
    return 0;
  }
  if first.show_version {
    print_version(console);
    return 0;
  }
  // curl checks the request method of each group while it reads the command line.
  for cfg in groups.iter() {
    if cfg.head && ((cfg.data.len() > 0 && !cfg.get_data) || cfg.has_upload) {
      let mut m = lit("curl: You can only select one HTTP request method! You asked for both POST\n");
      push_lit(&mut m, "curl: (-d, --data) and HEAD (-I, --head).\n");
      push_lit(&mut m, "curl: try 'curl --help' for more information\n");
      console.to_stderr(&m);
      return FAILED_INIT;
    }
  }
  let mut session = Session {
    jar : new_jar(false),
    hsts : new_hsts(false)
  };
  let mut code = 0;
  for cfg in groups.iter() {
    code = run_group(network, files, stdin, console, cfg, &mut session);
    if code == FAILED_INIT {
      break;
    }
  }
  return code;
}

/// Run the transfers of one group of the command line, and give the exit code of the last one.
fn run_group(network : &Network, files : &Files, stdin : &mut Stdin, console : &mut Console,
cfg : &Config, session : &mut Session) -> i32 {
  if cfg.urls.len() == 0 {
    console.to_stderr(&lit("curl: (2) no URL specified\ncurl: try 'curl --help' for more information\n"));
    return FAILED_INIT;
  }

  // Read each file that a data option names. curl warns and sends nothing for a file that it
  // cannot read.
  let mut contents = Vec<Vec<u8>>::new();
  for part in cfg.data.iter() {
    match data_file_name(part) {
      Option<Vec<u8>>::Some(name) => {
        match read_file(files, stdin, &name) {
          Result<Vec<u8>, Failure>::Ok(bytes) => {
            contents.push(bytes);
          },
          Result<Vec<u8>, Failure>::Err(_f) => {
            let mut m = lit("Couldn't read data from file \"");
            append(&mut m, &name);
            push_lit(&mut m, "\", this makes an empty POST.");
            console.to_stderr(&message_lines("Warning: ", &m, cfg.columns));
            contents.push(Vec<u8>::new());
          }
        }
      },
      Option<Vec<u8>>::None() => {
        contents.push(Vec<u8>::new());
      }
    }
  }
  let mut request_body = build_body(&cfg.data, &contents);

  // A form (`-F`): read the files of its fields, and make the multipart body.
  let mut form_boundary = Vec<u8>::new();
  if cfg.forms.len() > 0 {
    let mut parts = Vec<FormPart>::new();
    for arg in cfg.forms.iter() {
      let mut warnings = Vec<u8>::new();
      let parsed_form = parse_form(&arg.text, arg.literal, &mut warnings);
      console.to_stderr(&warnings);
      match parsed_form {
        Result<FormPart, Failure>::Ok(parsed) => {
          let mut part = parsed;
          if reads_file(&part) {
            match read_file(files, stdin, &part.data) {
              Result<Vec<u8>, Failure>::Ok(bytes) => {
                part.content = bytes;
              },
              Result<Vec<u8>, Failure>::Err(_e) => {
                let f = fail_lit(READ_ERROR,
                  "Failed to open/read local data from file/application");
                report(console, cfg, &f);
                return f.code;
              }
            }
          }
          parts.push(part);
        },
        Result<FormPart, Failure>::Err(f) => {
          let mut m = lit("curl: ");
          append(&mut m, &f.message);
          push_lit(&mut m, "\ncurl: try 'curl --help' for more information\n");
          console.to_stderr(&m);
          return f.code;
        }
      }
    }
    form_boundary = make_boundary(&random_bytes(22));
    // A `-H "Content-Type: ..."` gives the type of the whole body.
    let mut form_type = lit("multipart/form-data");
    for line in cfg.headers.iter() {
      let h = split_header(line);
      if !h.ignored && !h.remove && eq_lit_nocase(&h.name, "Content-Type") {
        form_type = trim_blanks(&h.value);
      }
    }
    request_body = multipart_body(&parts, &form_boundary, type_is(&form_type, "multipart/form-data"),
      cfg.form_escape);
  }

  let mut headers = clone_lines(&cfg.headers);
  if has_json(&cfg.data) {
    if !has_custom(&headers, "Content-Type") {
      headers.push(lit("Content-Type: application/json"));
    }
    if !has_custom(&headers, "Accept") {
      headers.push(lit("Accept: application/json"));
    }
  }

  if cfg.outputs.len() > cfg.urls.len() && !cfg.silent {
    console.to_stderr(&message_lines("Warning: ", &lit("Got more output options than URLs"), cfg.columns));
  }
  if cfg.has_upload && cfg.http10 && eq_lit(&cfg.upload, "-") && !has_custom(&headers, "Content-Length") {
    let f = fail_lit(UPLOAD_FAILED, "Chunky upload is not supported by HTTP 1.0");
    report(console, cfg, &f);
    return f.code;
  }

  // The kind of request for the first URL. `-T` uploads only to the first URL, so the other
  // URLs get the kind of request that the other options ask for.
  let mut other_kind = REQ_GET;
  if cfg.head {
    other_kind = REQ_HEAD;
  } else {
    if (cfg.data.len() > 0 && !cfg.get_data) || cfg.forms.len() > 0 {
      other_kind = REQ_POST;
    }
  }
  let mut kind = other_kind;
  let mut upload_body = Vec<u8>::new();
  if !cfg.head {
    if cfg.has_upload {
      kind = REQ_PUT;
      match read_file(files, stdin, &cfg.upload) {
        Result<Vec<u8>, Failure>::Ok(bytes) => {
          upload_body = bytes;
        },
        Result<Vec<u8>, Failure>::Err(f) => {
          report(console, cfg, &f);
          return f.code;
        }
      }
    }
  }

  // The cookie engine runs for this group when `-b` names a file or `-c` a jar. `main` reads
  // the files with its file right, and the transfers get the jar without that right.
  session.jar.enabled = cfg.cookie_files.len() > 0 || cfg.has_cookie_jar;
  for name in cfg.cookie_files.iter() {
    match read_file(files, stdin, name) {
      Result<Vec<u8>, Failure>::Ok(text) => {
        load_cookie_text(&mut session.jar, &text, cfg.junk_session_cookies);
      },
      Result<Vec<u8>, Failure>::Err(_f) => {
        // libcurl ignores a cookie file that it cannot read.
      }
    }
  }
  start_jar(&mut session.jar);

  // The HSTS cache of `--hsts`, which `main` reads and writes with its file right too. libcurl
  // skips a file that it cannot read.
  // A line that is too long fails the first transfer. libcurl reads the file again before
  // each transfer, and by then the first one saved it without that line.
  session.hsts.enabled = cfg.has_hsts;
  let mut hsts_too_long = false;
  if cfg.hsts.len() > 0 {
    match read_path(files, &cfg.hsts) {
      Result<Vec<u8>, Failure>::Ok(text) => {
        hsts_too_long = !load_hsts_text(&mut session.hsts, &text);
      },
      Result<Vec<u8>, Failure>::Err(_f) => {}
    }
  }

  // The TLS settings read the certificate authorities from files, so `main` makes them with its
  // file right. The transfers get them without that right.
  match TlsConfig::new(files, cfg.insecure, &cfg.cacert, &cfg.capath) {
    Result<TlsConfig, TlsError>::Ok(t) => {
      let mut tls = t;
      // The client certificate, read with the file right like the certificate authorities.
      if cfg.cert.len() > 0 {
        tls.use_client_cert(files, &ClientCert {
          cert : clone_bytes(&cfg.cert),
          cert_type : clone_bytes(&cfg.cert_type),
          key : clone_bytes(&cfg.key),
          key_type : clone_bytes(&cfg.key_type),
          has_pass : cfg.has_pass,
          pass : clone_bytes(&cfg.pass)
        });
      }
      // The settings for an HTTPS proxy. curl takes `--capath` for it too when there is no
      // `--proxy-capath`. A run that cannot meet an HTTPS proxy gets settings that load no
      // certificates, and never uses them.
      let mut proxy_capath = clone_bytes(&cfg.proxy_capath);
      if proxy_capath.len() == 0 {
        proxy_capath = clone_bytes(&cfg.capath);
      }
      let skip_proxy_check = cfg.proxy_insecure || !may_use_https_proxy(cfg);
      match TlsConfig::new(files, skip_proxy_check, &cfg.proxy_cacert, &proxy_capath) {
        Result<TlsConfig, TlsError>::Ok(p) => {
          let settings = TlsSettings {
            server : tls,
            proxy : p
          };
          let code = run_all(network, files, console, &settings, cfg, &headers, &request_body,
            &upload_body, kind, other_kind, &form_boundary, session, hsts_too_long);
          save_jar(console, files, cfg, &mut session.jar);
          save_hsts(files, cfg, &session.hsts);
          return code;
        },
        Result<TlsConfig, TlsError>::Err(e) => {
          let f = fail_with(e.code, e.message);
          report(console, cfg, &f);
          return f.code;
        }
      }
    },
    Result<TlsConfig, TlsError>::Err(e) => {
      let f = fail_with(e.code, e.message);
      report(console, cfg, &f);
      return f.code;
    }
  }
}

/// Whether the file `name` of the option `--option` exists, when it is given. curl stops with
/// its message when it does not.
fn file_given_exists(console : &mut Console, files : &Files, name : &Vec<u8>, option : *const i8)
-> bool {
  if name.len() == 0 || file_exists(files, name) {
    return true;
  }
  let mut m = lit("curl: The file '");
  append(&mut m, name);
  push_lit(&mut m, "' provided to --");
  push_lit(&mut m, option);
  push_lit(&mut m, " does not exist\ncurl: option --");
  push_lit(&mut m, option);
  push_lit(&mut m, ": is badly used here\ncurl: try 'curl --help' for more information\n");
  console.to_stderr(&m);
  return false;
}

/// Whether a transfer of the run may go through an HTTPS proxy: `-x` or a proxy variable names
/// one with `https://`.
fn may_use_https_proxy(cfg : &Config) -> bool {
  if starts_lit_nocase(&cfg.proxy, "https://") {
    return true;
  }
  for v in cfg.proxy_env.iter() {
    if starts_lit_nocase(&v.value, "https://") {
      return true;
    }
  }
  return false;
}

/// Write the cookies to the jar file of `-c`, or to standard output for `-`. libcurl only notes
/// a jar that it cannot write.
fn save_jar(console : &mut Console, files : &Files, cfg : &Config, jar : &mut CookieJar) -> void {
  if !cfg.has_cookie_jar {
    return;
  }
  let text = jar_text(jar);
  if eq_lit(&cfg.cookie_jar, "-") {
    let _ok = console.to_stdout(&text);
    return;
  }
  match append_to_file(files, &cfg.cookie_jar, false, &text) {
    Result<i32, Failure>::Ok(_n) => {},
    Result<i32, Failure>::Err(_f) => {
      if cfg.verbose {
        let mut m = lit("* WARNING: failed to save cookies in ");
        append(&mut m, &cfg.cookie_jar);
        push_lit(&mut m, "\n");
        console.to_stderr(&m);
      }
      return;
    }
  }
}

/// Write the HSTS cache to the file of `--hsts`. libcurl says nothing when it cannot.
fn save_hsts(files : &Files, cfg : &Config, hsts : &Hsts) -> void {
  if cfg.hsts.len() == 0 {
    return;
  }
  let _written = append_to_file(files, &cfg.hsts, false, &hsts_text(hsts));
}

/// The URL that `%{url_effective}` shows for `text` before a transfer starts.
fn effective_url(text : &Vec<u8>, path_as_is : bool) -> Vec<u8> {
  match parse_url(text, path_as_is) {
    Result<Url, Failure>::Ok(u) => {
      return url_text(&u);
    },
    Result<Url, Failure>::Err(_f) => {
      return clone_bytes(text);
    }
  }
}

/// Run the transfer of each URL, and give the exit code of the last one.
fn run_all(network : &Network, files : &Files, console : &mut Console, tls : &TlsSettings, cfg : &Config,
headers : &Vec<Vec<u8>>, request_body : &Vec<u8>, upload_body : &Vec<u8>, kind : i32,
other_kind : i32, form_boundary : &Vec<u8>, session : &mut Session, fail_first : bool) -> i32 {
  let mut exit_code = 0;
  let mut i = 0;
  while i < cfg.urls.len() {
    let mut url_text = clone_bytes(cfg.urls.get_ref(i));
    if cfg.get_data && cfg.data.len() > 0 {
      if find_byte(&url_text, 63u8, 0) >= 0 {
        url_text.push(38u8);
      } else {
        url_text.push(63u8);
      }
      append(&mut url_text, request_body);
    }
    let mut this_kind = other_kind;
    if i == 0 {
      this_kind = kind;
    }
    if cfg.has_upload && i == 0 {
      url_text = upload_url(&url_text, &cfg.upload);
    }

    let mut info = new_info();
    let mut state = OutputState {
      path : Vec<u8>::new(),
      created : false,
      written : false
    };
    let mut code = 0;
    let mut message = Vec<u8>::new();
    let mut result = Result<i32, Failure>::Ok(0);
    if i == 0 && fail_first {
      info.url_effective = effective_url(&url_text, cfg.path_as_is);
      result = Result<i32, Failure>::Err(fail_lit(TOO_LARGE,
        "A value or data field grew larger than allowed"));
    } else if this_kind == REQ_PUT {
      result = transfer_one(network, files, console, tls, cfg, headers, &url_text, upload_body, this_kind,
        form_boundary, session, i, &mut info, &mut state);
    } else {
      result = transfer_one(network, files, console, tls, cfg, headers, &url_text, request_body, this_kind,
        form_boundary, session, i, &mut info, &mut state);
    }
    match result {
      Result<i32, Failure>::Ok(_v) => {},
      Result<i32, Failure>::Err(f) => {
        report(console, cfg, &f);
        code = f.code;
        message = f.message;
        clean_failed_output(console, files, cfg, &state);
      }
    }
    if cfg.has_write_out {
      let ctx = WriteOutContext {
        exit_code : code,
        error : message,
        url_index : i
      };
      let mut warnings = Vec<u8>::new();
      let pieces = format_write_out(&cfg.write_out, &info, &ctx, &mut warnings);
      if warnings.len() > 0 {
        console.to_stderr(&warnings);
      }
      write_pieces(console, files, &pieces);
    }
    // As curl: the exit code is the one of the last transfer, and a fatal error stops the rest.
    exit_code = code;
    if code == FAILED_INIT {
      return exit_code;
    }
    i = i + 1;
  }
  return exit_code;
}

/// Write each piece of `-w` text where it goes. A `%output{file}` piece goes to a file, which
/// only `main` can open. When the file cannot be opened, curl writes the piece where the text
/// before it went.
fn write_pieces(console : &mut Console, files : &Files, pieces : &Vec<WriteOutPiece>) -> void {
  let mut last = TO_STDOUT;
  for piece in pieces.iter() {
    let mut where_to = piece.destination;
    if where_to == TO_FILE {
      match append_to_file(files, &piece.file, piece.append, &piece.bytes) {
        Result<i32, Failure>::Ok(_n) => {
          continue;
        },
        Result<i32, Failure>::Err(_f) => {
          where_to = last;
        }
      }
    }
    if where_to == TO_STDERR {
      console.to_stderr(&piece.bytes);
    } else {
      let _ok = console.to_stdout(&piece.bytes);
    }
    last = where_to;
  }
}

fn transfer_one(network : &Network, files : &Files, console : &mut Console, tls : &TlsSettings,
cfg : &Config,
headers : &Vec<Vec<u8>>,
url_text : &Vec<u8>, request_body : &Vec<u8>, kind : i32, form_boundary : &Vec<u8>,
session : &mut Session, index : i32, info : &mut TransferInfo, state : &mut OutputState)
-> Result<i32, Failure> {
  let body_output = open_output(files, cfg, index, url_text, state)?;
  let header_output = open_header_output(files, cfg)?;
  let mut sinks = Sinks {
    body : body_output,
    headers : header_output,
    has_headers : cfg.has_dump_header
  };
  let result = run_transfer(network, tls, cfg, headers, url_text, request_body, kind,
    form_boundary, session, console, &mut sinks, info);
  state.written = sinks.body.written > 0i64;
  return result;
}
