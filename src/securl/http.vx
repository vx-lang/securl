// HTTP/1.1 messages: the request that curl sends, and the head of the response.
//
// The order of the request headers is the order of libcurl's `http_add_hd`: Host,
// Authorization, Range, User-Agent, Accept, Referer, Cookie, the `-H` headers, the body
// headers, and Connection. curl's tests compare the request byte for byte, so the order matters.
import core::option;
import std::vec;
import sys::text;
import securl::auth;
import securl::bytes;
import securl::encode;
import securl::failure;
import securl::url;

/// The text that securl gives as its version, and sends in `User-Agent`.
pub fn securl_version() -> Vec<u8> {
  return lit("0.1.0-securl");
}

// The kinds of request: no body, a POST body, an upload with PUT, or HEAD.
const REQ_GET : i32 = 0;
const REQ_POST : i32 = 1;
const REQ_PUT : i32 = 2;
const REQ_HEAD : i32 = 3;

// The body of a request is larger than this, so curl asks the server first with
// `Expect: 100-continue`.
const EXPECT_100_THRESHOLD : i64 = 1048576i64;

/// One `-H` header split into its name and value. `empty` is true for the `name;` form, which
/// sends a header with no value. `remove` is true for the `name:` form, which only stops curl
/// from sending its own header of that name.
struct CustomHeader {
  name : Vec<u8>,
  value : Vec<u8>,
  empty : bool,
  remove : bool,
  // The header as the user wrote it.
  line : Vec<u8>,
  // The line has neither a `:` nor the `;` form, so curl ignores it.
  ignored : bool,
}

/// Split a `-H` header as libcurl's `Curl_dynhds_add_slist` does.
pub fn split_header(line : &Vec<u8>) -> CustomHeader {
  let colon = find_byte(line, 58u8, 0);
  let semi = find_byte(line, 59u8, 0);
  // `name;` with nothing after the `;` and no `:` in the name sends an empty header.
  if semi >= 0 && semi == line.len() - 1 && (colon < 0 || colon > semi) {
    return CustomHeader {
      name : trim_blanks(&range_of(line, 0, semi)),
      value : Vec<u8>::new(),
      empty : true,
      remove : false,
      line : clone_bytes(line),
      ignored : false
    };
  }
  if colon < 0 {
    return CustomHeader {
      name : Vec<u8>::new(),
      value : Vec<u8>::new(),
      empty : false,
      remove : false,
      line : clone_bytes(line),
      ignored : true
    };
  }
  let mut value = rest_from(line, colon + 1);
  let nl = find_byte(&value, 13u8, 0);
  if nl >= 0 {
    value = range_of(&value, 0, nl);
  }
  let lf = find_byte(&value, 10u8, 0);
  if lf >= 0 {
    value = range_of(&value, 0, lf);
  }
  value = trim_blanks(&value);
  let name = trim_blanks(&range_of(line, 0, colon));
  let remove = value.len() == 0;
  return CustomHeader {
    name : name,
    value : value,
    empty : false,
    remove : remove,
    line : clone_bytes(line),
    ignored : false
  };
}

/// Whether the `-H` headers name the header `name`, in any form. libcurl's
/// `Curl_checkheaders` does this check before it adds a header of its own.
pub fn has_custom(headers : &Vec<Vec<u8>>, name : *const i8) -> bool {
  let want = lit(name);
  for line in headers.iter() {
    if has_at_nocase(line, &want) && line.len() > want.len() {
      let sep = line.get(want.len());
      if sep == 58u8 || sep == 59u8 {
        return true;
      }
    }
  }
  return false;
}

/// The value of the first `-H` header called `name`, if it has one.
fn custom_value(headers : &Vec<Vec<u8>>, name : *const i8) -> Option<Vec<u8>> {
  for line in headers.iter() {
    let h = split_header(line);
    if !h.ignored && eq_lit_nocase(&h.name, name) {
      return Option<Vec<u8>>::Some(h.value);
    }
  }
  return Option<Vec<u8>>::None();
}

fn has_at_nocase(a : &Vec<u8>, prefix : &Vec<u8>) -> bool {
  if prefix.len() > a.len() {
    return false;
  }
  let mut i = 0;
  while i < prefix.len() {
    if ascii_lower(a.get(i)) != ascii_lower(prefix.get(i)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// What a request needs besides the URL.
struct RequestInfo {
  method : Vec<u8>,
  kind : i32,
  body_length : i64,
  http10 : bool,
  // The `-H` headers, with the ones that `--json` adds.
  headers : Vec<Vec<u8>>,
  // The Authorization header (Basic or Digest), which `auth.vx` makes for one origin. It goes
  // only to that origin.
  auth : AuthHeader,
  // Where the cookies of `-b` and the `Authorization` and `Cookie` headers of `-H` may go.
  scope : Scope,
  // A custom Host header may go to this host: it is the first host.
  first_host : bool,
  has_user_agent : bool,
  user_agent : Vec<u8>,
  has_referer : bool,
  referer : Vec<u8>,
  has_range : bool,
  range : Vec<u8>,
  // The cookies of the cookie engine that match the request, or empty.
  cookie : Vec<u8>,
  // The cookies of `-b NAME=VALUE`.
  has_cookie_option : bool,
  cookie_option : Vec<u8>,
  // The request goes to the HTTP proxy `proxy`, so the request line holds the whole URL.
  via_proxy : bool,
  proxy : Url,
  // The Proxy-Authorization header (Basic or Digest) that `auth.vx` made for that proxy.
  proxy_auth : AuthHeader,
  // The body goes in chunks, with no Content-Length.
  chunked : bool,
  // curl adds `Transfer-Encoding: chunked` itself, because the length of the body is unknown.
  add_chunked_header : bool,
  // The request is the probe of an authentication with an empty body: it says
  // `Content-Length: 0`, and a custom Content-Length does not go.
  probe : bool,
  // The boundary of a multipart form (`-F`), or empty.
  form_boundary : Vec<u8>,
  // The request goes over HTTP/2: no `Expect: 100-continue` and no chunks.
  h2 : bool,
  // `--compressed`: ask for the encodings that securl decodes.
  accept_encoding : bool,
  // `--tr-encoding`: ask for gzip as a transfer coding, with `TE: gzip` and `Connection: TE`.
  tr_encoding : bool,
}

fn add_line(out : &mut Vec<u8>, name : *const i8, value : &Vec<u8>) -> void {
  push_lit(out, name);
  append(out, value);
  push_lit(out, "\r\n");
}

/// The bytes of the request line and the headers of a request for `u`, up to and with the
/// empty line that ends them.
///
/// This is the one place that writes the credentials and the cookies of the user into a
/// request, so it decides here, from the URL of the request line, whether they may go: the
/// Authorization header only to the origin that `auth.vx` made it for, and the cookies of `-b`
/// and the `Authorization` and `Cookie` headers of `-H` only where the scope allows.
pub fn build_request(u : &Url, info : &RequestInfo) -> Vec<u8> {
  let trusted = allows(&info.scope, u);
  let mut out = clone_bytes(&info.method);
  push_lit(&mut out, " ");
  if info.via_proxy {
    append(&mut out, &u.scheme);
    push_lit(&mut out, "://");
    append(&mut out, &host_header_value(u));
  }
  append(&mut out, &u.path);
  if info.http10 {
    push_lit(&mut out, " HTTP/1.0\r\n");
  } else {
    push_lit(&mut out, " HTTP/1.1\r\n");
  }

  // Host. A custom Host header goes only to the first host. curl copies it after `Host:` as
  // the user wrote it.
  let mut custom_host = false;
  if info.first_host {
    for line in info.headers.iter() {
      let h = split_header(line);
      if !custom_host && !h.ignored && eq_lit_nocase(&h.name, "Host") {
        custom_host = true;
        if !h.remove {
          let colon = find_byte(line, 58u8, 0);
          if colon >= 0 {
            push_lit(&mut out, "Host:");
            append_range(&mut out, line, colon + 1, line.len());
            push_lit(&mut out, "\r\n");
          } else {
            push_lit(&mut out, "Host:\r\n");
          }
        }
      }
    }
  }
  if !custom_host {
    add_line(&mut out, "Host: ", &host_header_value(u));
  }

  if info.via_proxy && header_fits(&info.proxy_auth, &info.proxy) {
    add_line(&mut out, "Proxy-Authorization: ", &info.proxy_auth.value);
  }

  if header_fits(&info.auth, u) {
    add_line(&mut out, "Authorization: ", &info.auth.value);
  }

  if info.has_range {
    // curl adds the `-` of an open range, so `-r 4` asks for byte 4 to the end.
    let mut range = clone_bytes(&info.range);
    if find_byte(&range, 45u8, 0) < 0 {
      range.push(45u8);
    }
    let uploads = info.kind == REQ_POST || info.kind == REQ_PUT;
    if !uploads && !has_custom(&info.headers, "Range") {
      add_line(&mut out, "Range: bytes=", &range);
    }
    // An upload says which part of the file its body is, and the length of the body.
    if uploads && !has_custom(&info.headers, "Content-Range") {
      push_lit(&mut range, "/");
      push_i64(&mut range, info.body_length);
      add_line(&mut out, "Content-Range: bytes ", &range);
    }
  }

  if !has_custom(&info.headers, "User-Agent") {
    if info.has_user_agent {
      if info.user_agent.len() > 0 {
        add_line(&mut out, "User-Agent: ", &info.user_agent);
      }
    } else {
      add_line(&mut out, "User-Agent: curl/", &securl_version());
    }
  }

  if !has_custom(&info.headers, "Accept") {
    push_lit(&mut out, "Accept: */*\r\n");
  }
  let te = info.tr_encoding && !has_custom(&info.headers, "TE");
  if te {
    push_lit(&mut out, "TE: gzip\r\n");
  }
  if info.accept_encoding && !has_custom(&info.headers, "Accept-Encoding") {
    push_lit(&mut out, "Accept-Encoding: deflate, gzip, br, zstd\r\n");
  }

  if info.has_referer && !has_custom(&info.headers, "Referer") {
    add_line(&mut out, "Referer: ", &info.referer);
  }

  if info.via_proxy && !has_custom(&info.headers, "Proxy-Connection") {
    push_lit(&mut out, "Proxy-Connection: Keep-Alive\r\n");
  }

  if info.add_chunked_header {
    push_lit(&mut out, "Transfer-Encoding: chunked\r\n");
  }

  // The cookies of the cookie engine, and then those of `-b NAME=VALUE`, unless a `-H` gives
  // the Cookie header.
  let mut cookie = clone_bytes(&info.cookie);
  if info.has_cookie_option && trusted && !has_custom(&info.headers, "Cookie") {
    if cookie.len() > 0 {
      push_lit(&mut cookie, "; ");
    }
    append(&mut cookie, &info.cookie_option);
  }
  if cookie.len() > 0 {
    add_line(&mut out, "Cookie: ", &cookie);
  }

  for line in info.headers.iter() {
    let h = split_header(line);
    let skip = h.ignored || h.remove || eq_lit_nocase(&h.name, "Host")
      || eq_lit_nocase(&h.name, "Connection")
      || (info.probe && eq_lit_nocase(&h.name, "Content-Length"))
      || (info.form_boundary.len() > 0 && eq_lit_nocase(&h.name, "Content-Type"))
      || ((eq_lit_nocase(&h.name, "Authorization") || eq_lit_nocase(&h.name, "Cookie"))
          && !trusted);
    if !skip {
      if h.empty {
        append(&mut out, &h.name);
        push_lit(&mut out, ":\r\n");
      } else {
        append(&mut out, line);
        push_lit(&mut out, "\r\n");
      }
    }
  }

  if info.kind == REQ_POST || info.kind == REQ_PUT {
    if info.body_length >= 0i64 && !info.chunked
       && (info.probe || !has_custom(&info.headers, "Content-Length")) {
      let mut n = Vec<u8>::new();
      push_i64(&mut n, info.body_length);
      add_line(&mut out, "Content-Length: ", &n);
    }
    if info.kind == REQ_POST && info.form_boundary.len() > 0 {
      // A form: the type of a `-H "Content-Type: ..."`, or multipart/form-data, and the boundary.
      let mut ct = lit("multipart/form-data");
      for line in info.headers.iter() {
        let h = split_header(line);
        if !h.ignored && !h.remove && eq_lit_nocase(&h.name, "Content-Type") {
          ct = trim_blanks(&h.value);
        }
      }
      push_lit(&mut ct, "; boundary=");
      append(&mut ct, &info.form_boundary);
      add_line(&mut out, "Content-Type: ", &ct);
    }
    if info.kind == REQ_POST && info.form_boundary.len() == 0
       && !has_custom(&info.headers, "Content-Type") {
      push_lit(&mut out, "Content-Type: application/x-www-form-urlencoded\r\n");
    }
    if !info.http10 && !info.h2 && !has_custom(&info.headers, "Expect")
       && (info.body_length > EXPECT_100_THRESHOLD || info.add_chunked_header) {
      push_lit(&mut out, "Expect: 100-continue\r\n");
    }
  }

  // The first custom Connection header with a value comes last, with the `TE` of curl after
  // its value, and the other custom Connection headers after it.
  let mut connection = Vec<u8>::new();
  let mut has_connection = false;
  for line in info.headers.iter() {
    let h = split_header(line);
    if !has_connection && !h.ignored && !h.remove && !h.empty
       && eq_lit_nocase(&h.name, "Connection") {
      connection = clone_bytes(&h.value);
      has_connection = true;
    }
  }
  if te {
    if has_connection {
      push_lit(&mut connection, ", ");
    }
    push_lit(&mut connection, "TE");
    has_connection = true;
  }
  if has_connection {
    add_line(&mut out, "Connection: ", &connection);
  }
  let mut first_connection = true;
  for line in info.headers.iter() {
    let h = split_header(line);
    if !h.ignored && !h.remove && !h.empty && eq_lit_nocase(&h.name, "Connection") {
      if !first_connection {
        append(&mut out, line);
        push_lit(&mut out, "\r\n");
      }
      first_connection = false;
    }
  }

  push_lit(&mut out, "\r\n");
  return out;
}

/// The CONNECT request that asks the HTTP proxy `proxy` for a tunnel to `target`. `auth` is
/// the Proxy-Authorization header that `auth.vx` made for that proxy.
pub fn build_connect_request(target : &Vec<u8>, proxy : &Url, auth : &AuthHeader,
has_user_agent : bool, user_agent : &Vec<u8>) -> Vec<u8> {
  let mut out = lit("CONNECT ");
  append(&mut out, target);
  push_lit(&mut out, " HTTP/1.1\r\n");
  add_line(&mut out, "Host: ", target);
  if header_fits(auth, proxy) {
    add_line(&mut out, "Proxy-Authorization: ", &auth.value);
  }
  if has_user_agent {
    if user_agent.len() > 0 {
      add_line(&mut out, "User-Agent: ", user_agent);
    }
  } else {
    add_line(&mut out, "User-Agent: curl/", &securl_version());
  }
  push_lit(&mut out, "Proxy-Connection: Keep-Alive\r\n\r\n");
  return out;
}

/// The head of a response: its status line and headers.
struct ResponseHead {
  // The status line and the headers as they arrived, with the empty line that ends them. When
  // a header is bad, `raw` ends before it, because curl writes no header after an error.
  raw : Vec<u8>,
  // 10 for HTTP/1.0, 11 for HTTP/1.1.
  version : i32,
  status : i32,
  // -1 when the response has no Content-Length.
  content_length : i64,
  // The response has a Transfer-Encoding header, so curl does not use its Content-Length.
  has_transfer_encoding : bool,
  chunked : bool,
  has_location : bool,
  location : Vec<u8>,
  content_type : Vec<u8>,
  // The server closes the connection after the response: HTTP/1.0 without
  // `Connection: keep-alive`, or `Connection: close`.
  close : bool,
  // `Proxy-Connection: keep-alive` and `Proxy-Connection: close`, which count for a response
  // that comes through an HTTP proxy.
  proxy_keep_alive : bool,
  proxy_close : bool,
  // A Content-Length header held a number too large for 63 bits. libcurl then reads to the end
  // of the connection, or fails with `--max-filesize`.
  length_overflow : bool,
  // The headers, without the status line, each without its line end. For `-w %header{}`.
  headers : Vec<Vec<u8>>,
  // Not 0 when the head is bad: the exit code, with `error` as the message.
  error_code : i32,
  error : Vec<u8>,
  // The request asked for transfer codings (`--tr-encoding`), so the Transfer-Encoding codings
  // other than chunked are decoded: they are in `transfer_codings`, joined with commas.
  // `transfer_count` counts them with chunked, for libcurl's limit of five.
  tr_encoding : bool,
  transfer_codings : Vec<u8>,
  transfer_count : i32,
}

/// An empty response head, before the status line is read.
pub fn empty_head() -> ResponseHead {
  return ResponseHead {
    raw : Vec<u8>::new(),
    version : 11,
    status : 0,
    content_length : -1i64,
    has_transfer_encoding : false,
    chunked : false,
    has_location : false,
    location : Vec<u8>::new(),
    content_type : Vec<u8>::new(),
    close : false,
    proxy_keep_alive : false,
    proxy_close : false,
    length_overflow : false,
    headers : Vec<Vec<u8>>::new(),
    error_code : 0,
    error : Vec<u8>::new(),
    tr_encoding : false,
    transfer_codings : Vec<u8>::new(),
    transfer_count : 0
  };
}

fn set_error(head : &mut ResponseHead, code : i32, message : Vec<u8>) -> void {
  if head.error_code == 0 {
    head.error_code = code;
    head.error = message;
  }
}

/// Whether the header line `line`, with its line end, has no CR but the one before its LF and
/// no NUL byte, as libcurl's `Curl_verify_header` checks each line of a head and each trailer.
/// Else it sets the error of `head`.
pub fn line_is_clean(line : &Vec<u8>, head : &mut ResponseHead) -> bool {
  let nul = find_byte(line, 0u8, 0);
  let mut limit = line.len();
  if nul >= 0 {
    limit = nul;
  }
  let cr = find_byte(&range_of(line, 0, limit), 13u8, 0);
  if cr >= 0 && cr < line.len() - 2 {
    set_error(head, WEIRD_SERVER_REPLY, lit("Carriage return found in header"));
    return false;
  }
  if nul >= 0 {
    set_error(head, WEIRD_SERVER_REPLY, lit("NUL byte in header"));
    return false;
  }
  return true;
}

/// Join the folded line `more`, which starts with a blank, to the header line `line`, as
/// libcurl does: `line` loses its line end and its trailing blanks, and one space takes the
/// place of the blanks at the start of `more` (curl's test 1274).
pub fn unfold(line : &Vec<u8>, more : &Vec<u8>) -> Vec<u8> {
  let mut end = line.len();
  if end > 0 && line.get(end - 1) == 10u8 {
    end = end - 1;
  }
  if end > 0 && line.get(end - 1) == 13u8 {
    end = end - 1;
  }
  while end > 0 && is_blank(line.get(end - 1)) {
    end = end - 1;
  }
  let mut out = range_of(line, 0, end);
  let mut start = 0;
  while start < more.len() && is_blank(more.get(start)) {
    start = start + 1;
  }
  if start < more.len() {
    push_lit(&mut out, " ");
  }
  append_range(&mut out, more, start, more.len());
  return out;
}

/// Read the status line `line` into `head`. Gives false when it is not an HTTP/1.x status line.
/// A status line of another HTTP version sets the error of `head`.
pub fn parse_status_line(line : &Vec<u8>, head : &mut ResponseHead) -> bool {
  let t = trim_newline(line);
  if !starts_lit(&t, "HTTP/") || t.len() < 6 {
    return false;
  }
  if !starts_lit(&t, "HTTP/1.0 ") && !starts_lit(&t, "HTTP/1.1 ") {
    set_error(head, UNSUPPORTED_PROTOCOL, lit("Unsupported HTTP version in response"));
    return true;
  }
  if t.get(7) == 48u8 {
    head.version = 10;
  } else {
    head.version = 11;
  }
  let mut end = 9;
  while end < t.len() && is_digit(t.get(end)) {
    end = end + 1;
  }
  if end - 9 != 3 {
    return false;
  }
  match parse_u64(&range_of(&t, 9, end)) {
    Option<u64>::Some(code) => {
      head.status = code as i32;
    },
    Option<u64>::None() => {
      return false;
    }
  }
  if head.version == 10 {
    head.close = true;
  }
  return true;
}

/// Read the tokens of a Transfer-Encoding header as libcurl's `Curl_build_unencoding_stack`
/// does, for a client that asks for no transfer decoding but `chunked`. With `raw`
/// (`--raw`), curl passes the body on as it arrived.
fn parse_transfer_encoding(value : &Vec<u8>, raw : bool, head : &mut ResponseHead) -> void {
  head.has_transfer_encoding = true;
  let mut start = 0;
  while start < value.len() {
    let mut end = find_byte(value, 44u8, start);
    if end < 0 {
      end = value.len();
    }
    let token = to_lower(&trim_blanks(&range_of(value, start, end)));
    start = end + 1;
    if token.len() == 0 {
      continue;
    }
    if raw {
      if eq_lit(&token, "chunked") {
        head.chunked = true;
        continue;
      }
      return;
    }
    if head.tr_encoding {
      // As libcurl with CURLOPT_TRANSFER_ENCODING: decode each coding, with chunked last.
      if head.transfer_count >= 5 {
        set_error(head, BAD_CONTENT_ENCODING,
          lit("Reject response exceeding limit of 5 transfer encodings"));
        return;
      }
      if eq_lit(&token, "chunked") {
        // A second chunked is ignored.
        if !head.chunked {
          head.chunked = true;
          head.transfer_count = head.transfer_count + 1;
        }
        continue;
      }
      if head.chunked {
        set_error(head, BAD_CONTENT_ENCODING,
          lit("Reject response due to 'chunked' not being the last Transfer-Encoding"));
        return;
      }
      if head.transfer_codings.len() > 0 {
        push_lit(&mut head.transfer_codings, ",");
      }
      append(&mut head.transfer_codings, &token);
      head.transfer_count = head.transfer_count + 1;
      continue;
    }
    if eq_lit(&token, "chunked") {
      head.chunked = true;
      continue;
    }
    if head.chunked {
      let mut m = lit("A Transfer-Encoding (");
      append(&mut m, &token);
      push_lit(&mut m, ") was listed after chunked");
      set_error(head, BAD_CONTENT_ENCODING, m);
      return;
    }
    if !eq_lit(&token, "identity") {
      let mut m = lit("Unsolicited Transfer-Encoding (");
      append(&mut m, &token);
      push_lit(&mut m, ") found");
      set_error(head, BAD_CONTENT_ENCODING, m);
      return;
    }
  }
}

/// Read one header line into `head`. `index` counts the lines of the head: the status line is
/// 1. A bad header sets the error of `head`, as libcurl's checks do.
pub fn parse_header_line(line : &Vec<u8>, index : i32, raw : bool, head : &mut ResponseHead)
-> void {
  if !line_is_clean(line, head) {
    return;
  }
  let t = trim_newline(line);
  let folded = index > 2 && t.len() > 0 && is_blank(t.get(0));
  let colon = find_byte(&t, 58u8, 0);
  if colon < 0 && !folded {
    set_error(head, WEIRD_SERVER_REPLY, lit("Header without colon"));
    return;
  }
  head.headers.push(clone_bytes(&t));
  if colon <= 0 || folded {
    return;
  }
  let name = range_of(&t, 0, colon);
  let value = trim_blanks(&rest_from(&t, colon + 1));
  if eq_lit_nocase(&name, "Content-Length") {
    // A response with no body has no length to check: 1xx, 204 and 304, as libcurl's
    // `http_bodyless`. After a Transfer-Encoding other than chunked, libcurl ignores it too.
    if (head.status >= 100 && head.status < 200) || head.status == 204 || head.status == 304
       || (head.has_transfer_encoding && !head.chunked) {
      return;
    }
    // curl takes a list such as `6, 6` when all values are the same, as browsers do.
    let mut start = 0;
    while start <= value.len() {
      let mut end = find_byte(&value, 44u8, start);
      if end < 0 {
        end = value.len();
      }
      let part = range_of(&value, start, end);
      if too_large_number(&part) {
        // As libcurl: the rest of the list does not count.
        head.length_overflow = true;
        return;
      }
      // A negative length, rubbish, or two lengths that disagree: libcurl stops at this header,
      // after it wrote the headers before it (curl's tests 178 and 415).
      match parse_u64(&part) {
        Option<u64>::Some(n) => {
          if head.content_length >= 0i64 && head.content_length != (n as i64) {
            set_error(head, WEIRD_SERVER_REPLY, lit("Invalid Content-Length: value"));
            return;
          }
          head.content_length = n as i64;
        },
        Option<u64>::None() => {
          set_error(head, WEIRD_SERVER_REPLY, lit("Invalid Content-Length: value"));
          return;
        }
      }
      start = end + 1;
    }
    return;
  }
  if eq_lit_nocase(&name, "Transfer-Encoding") {
    parse_transfer_encoding(&value, raw, head);
    return;
  }
  if eq_lit_nocase(&name, "Location") && head.status >= 200 {
    // An empty Location, or the same one again, changes nothing. A different second one is an
    // error.
    if value.len() == 0 || (head.has_location && same_bytes(&head.location, &value)) {
      return;
    }
    if head.has_location {
      set_error(head, WEIRD_SERVER_REPLY, lit("Multiple Location headers"));
      return;
    }
    head.has_location = true;
    head.location = value;
    return;
  }
  if eq_lit_nocase(&name, "Content-Type") {
    head.content_type = value;
    return;
  }
  if eq_lit_nocase(&name, "Connection") {
    let words = to_lower(&value);
    if find_seq(&words, &lit("close"), 0) >= 0 {
      head.close = true;
    } else if head.version == 10 && find_seq(&words, &lit("keep-alive"), 0) >= 0 {
      head.close = false;
    }
    return;
  }
  if eq_lit_nocase(&name, "Proxy-Connection") {
    let words = to_lower(&value);
    if find_seq(&words, &lit("close"), 0) >= 0 {
      head.proxy_close = true;
    } else if find_seq(&words, &lit("keep-alive"), 0) >= 0 {
      head.proxy_keep_alive = true;
    }
  }
}

/// Whether a response with this status to this request has no body.
pub fn has_no_body(status : i32, kind : i32) -> bool {
  return kind == REQ_HEAD || status == 204 || status == 304 || (status >= 100 && status < 200);
}

/// Whether `a`, with blanks around it, is a decimal number larger than 2^63 - 1, which libcurl
/// takes as an overflow.
fn too_large_number(a : &Vec<u8>) -> bool {
  let t = trim_blanks(a);
  if t.len() == 0 {
    return false;
  }
  let mut v : i64 = 0i64;
  for b in t.iter() {
    if !is_digit(*b) {
      return false;
    }
    let d = (*b - 48u8) as i64;
    if v > (9223372036854775807i64 - d) / 10i64 {
      return true;
    }
    v = v * 10i64 + d;
  }
  return false;
}
