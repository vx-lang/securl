// Checks how securl::options reads a command line.
import core::option;
import core::result;
import std::vec;
import sys::text;
import securl::bytes;
import securl::failure;
import securl::options;

fn words(a : *const i8, b : *const i8, c : *const i8, d : *const i8, e : *const i8) -> Vec<Vec<u8>> {
  let mut v = Vec<Vec<u8>>::new();
  v.push(lit(a));
  v.push(lit(b));
  v.push(lit(c));
  v.push(lit(d));
  v.push(lit(e));
  return v;
}

fn words7(a : *const i8, b : *const i8, c : *const i8, d : *const i8, e : *const i8,
f : *const i8, g : *const i8) -> Vec<Vec<u8>> {
  let mut v = words(a, b, c, d, e);
  v.push(lit(f));
  v.push(lit(g));
  return v;
}

fn parsed(args : &Vec<Vec<u8>>) -> Config {
  match parse_args(args) {
    Result<Config, Failure>::Ok(c) => {
      return c;
    },
    Result<Config, Failure>::Err(_f) => {
      panic("a command line that should parse did not");
    }
  }
}

fn error_of(args : &Vec<Vec<u8>>) -> Vec<u8> {
  match parse_args(args) {
    Result<Config, Failure>::Ok(_c) => {
      return lit("no error");
    },
    Result<Config, Failure>::Err(f) => {
      assert(f.code == FAILED_INIT, "a bad option gives exit code 2");
      return f.message;
    }
  }
}

fn main() -> i32 {
  let a = parsed(&words("-sSL", "-ofile.txt", "-H", "X-A: 1", "http://h/"));
  assert(a.silent && a.show_error && a.follow, "a cluster of short options");
  assert(a.nodes.len() == 1 && eq_lit(&a.nodes.get_ref(0).out, "file.txt"), "-o glued value");
  assert(a.headers.len() == 1 && eq_lit(a.headers.get_ref(0), "X-A: 1"), "-H value");
  assert(a.nodes.get_ref(0).has_url && eq_lit(&a.nodes.get_ref(0).url, "http://h/"), "one URL");

  // Each URL, -o or -O, and -T fills the first node that has none, as curl's nodes.
  let n = parsed(&words7("-O", "http://a/", "-T", "up", "-o", "x", "http://b/"));
  assert(n.nodes.len() == 2, "two nodes");
  assert(n.nodes.get_ref(0).remote && eq_lit(&n.nodes.get_ref(0).url, "http://a/")
    && n.nodes.get_ref(0).has_upload && eq_lit(&n.nodes.get_ref(0).upload, "up"),
    "-O and -T go with the first URL");
  assert(!n.nodes.get_ref(1).remote && eq_lit(&n.nodes.get_ref(1).out, "x")
    && eq_lit(&n.nodes.get_ref(1).url, "http://b/") && !n.nodes.get_ref(1).has_upload,
    "-o goes with the second URL");
  assert(n.has_upload, "some node uploads");
  let r = parsed(&words("--remote-name-all", "--no-remote-name", "http://a/", "http://b/", "-s"));
  assert(!r.nodes.get_ref(0).remote && r.nodes.get_ref(0).has_out && r.nodes.get_ref(1).remote,
    "--no-remote-name takes back --remote-name-all for one URL");
  let g0 = parsed(&words("-g", "http://h/{a}", "-s", "-s", "-s"));
  assert(g0.globoff, "-g");

  let b = parsed(&words("--location", "--no-location", "-d", "a=1", "-i"));
  assert(b.include, "-i");
  assert(!b.follow, "--no-location turns -L off");
  assert(b.data.len() == 1 && b.data.get_ref(0).kind == DATA_ASCII, "-d is ASCII data");

  let c = parsed(&words("-X", "PUT", "--max-time", "2.5", "-e;auto"));
  assert(eq_lit(&c.method, "PUT"), "-X");
  assert(c.max_time_ms == 2500i64, "2.5 seconds");
  assert(c.auto_referer && !c.has_referer, "-e ;auto alone");

  assert(eq_lit(&error_of(&words("--bogus", "a", "b", "c", "d")), "option --bogus: is unknown"),
    "an unknown long option");
  assert(eq_lit(&error_of(&words("-Z", "a", "b", "c", "d")), "option -Z: is unknown"),
    "an unknown short option");
  assert(eq_lit(&error_of(&words("a", "b", "c", "d", "-H")), "option -H: requires parameter"),
    "a missing value");

  // TCP options: TCP_NODELAY and keepalive are on unless the command line says no.
  let d = parsed(&words("http://h/", "-s", "-s", "-s", "-s"));
  assert(d.tcp_nodelay && d.keepalive && d.keepalive_time == 0i64 && d.keepalive_cnt == 0i64,
    "the defaults of curl");
  let e = parsed(&words("--no-tcp-nodelay", "--no-keepalive", "--keepalive-time", "17", "-s"));
  assert(!e.tcp_nodelay && !e.keepalive && e.keepalive_time == 17i64, "--no- and a time");
  let f = parsed(&words("--keepalive-cnt", "3", "--keepalive-time", "-0", "--keepalive"));
  assert(f.keepalive && f.keepalive_cnt == 3i64 && f.keepalive_time == 0i64, "a count, and -0");
  assert(eq_lit(&error_of(&words("--keepalive-time", "-5", "a", "b", "c")),
    "option --keepalive-time: expected a positive numerical parameter"), "a negative time");
  assert(eq_lit(&error_of(&words("--keepalive-cnt", " 5", "a", "b", "c")),
    "option --keepalive-cnt: expected a proper numerical parameter"), "a blank before the number");
  assert(eq_lit(&error_of(&words("--keepalive-time", "5x", "a", "b", "c")),
    "option --keepalive-time: expected a proper numerical parameter"), "a letter after it");
  assert(eq_lit(&error_of(&words("--keepalive-time", "99999999999999999999", "a", "b", "c")),
    "option --keepalive-time: expected a proper numerical parameter"), "a number too large");
  assert(eq_lit(&error_of(&words("--keepalive-time", "", "a", "b", "c")),
    "option --keepalive-time: expected a proper numerical parameter"), "no number");

  // `--name=value`, as in curl. A boolean option ignores its value.
  let g = parsed(&words("--max-filesize=2k", "--max-time=1.5", "--location=no", "-s", "http://h/"));
  assert(g.max_filesize == 2048i64 && g.max_time_ms == 1500i64, "a value after =");
  assert(g.follow && g.nodes.len() == 1, "a boolean option with = and no word taken");
  assert(eq_lit(&error_of(&words("--max-filesize=x", "a", "b", "c", "d")),
    "option --max-filesize=x: expected a proper numerical parameter"), "the word as it was given");
  assert(eq_lit(&error_of(&words("--bogus=1", "a", "b", "c", "d")), "option --bogus=1: is unknown"),
    "an unknown option with =");

  // `--next` makes groups; `-v` and `-s` hold for all of them, wherever they come.
  let mut p = new_arg_parser();
  let stop = p.words(&words("http://a/", "-H", "X: 1", "--next", "-v"), 0);
  assert(stop.is_ok(), "the first words parse");
  let mut tail = Vec<Vec<u8>>::new();
  tail.push(lit("-s"));
  tail.push(lit("http://b/"));
  assert(p.words(&tail, 0).is_ok(), "the second words parse");
  let groups = p.finish();
  assert(groups.len() == 2, "two groups");
  assert(groups.get_ref(0).headers.len() == 1 && groups.get_ref(1).headers.len() == 0,
    "-H only in its group");
  assert(groups.get_ref(0).verbose && groups.get_ref(0).silent && groups.get_ref(1).verbose,
    "-v and -s for every group");
  assert(eq_lit(&error_of(&words("-v", "--next", "a", "b", "c")),
    "missing URL before --next\ncurl: option --next: is badly used here"), "--next first");

  // The lines of a config file of -K.
  let text = lit("# a comment\n  url = \"http://h/a b\"\n-o out\nheader: \"X: \\\"q\\\"\\t\"\nsilent\nmax-time 5 junk\n");
  let lines = config_lines(&text, &lit("f"));
  assert(lines.len() == 5, "the comment is no option");
  assert(eq_lit(&lines.get_ref(0).option, "url") && eq_lit(&lines.get_ref(0).param, "http://h/a b"),
    "a quoted value with a blank");
  assert(lines.get_ref(0).lineno == 2, "the line number counts the comment");
  assert(eq_lit(&lines.get_ref(1).option, "-o") && eq_lit(&lines.get_ref(1).param, "out"),
    "a short option");
  assert(eq_lit(&lines.get_ref(2).param, "X: \"q\"\t"), "the escapes of a quoted value");
  assert(!lines.get_ref(3).has_param, "an option with no value");
  assert(eq_lit(&lines.get_ref(4).param, "5") && lines.get_ref(4).warning.len() > 0,
    "a warning for words after the value");

  return 0;
}
