// Where the bytes of a response go: standard output, a file, or nowhere.
//
// This file cannot open a file, because it never gets a `&Files`. `main` opens each output
// file and gives the open `File` to `file_output`. It writes to standard output and standard
// error only with the rights in a `Console`, which `main` makes from its `Root`.
import core::option;
import core::result;
import std::fs;
import std::io;
import std::vec;
import sys::text;
import securl::bytes;
import securl::failure;
import securl::decoder;

// libcurl's limit of content encodings on one response.
const MAX_ENCODE_STACK : i32 = 5;

/// The rights to write to standard output and to standard error. Only `main` can make one,
/// because only `main` has the rights of the program. So code that gets no `&mut Console`
/// cannot write to the terminal.
struct Console {
  out : Stdout,
  err : Stderr,
}

impl Console {
  /// Write all of `bytes` to standard output. False when the output is closed.
  pub fn to_stdout(self : &mut Console, bytes : &Vec<u8>) -> bool {
    return self.out.write_all(bytes).is_ok();
  }

  /// Write `bytes` to standard error. A closed standard error is not an error for curl.
  pub fn to_stderr(self : &mut Console, bytes : &Vec<u8>) -> void {
    let _r = self.err.write_all(bytes);
  }
}

struct Output {
  to_stdout : bool,
  file : Option<File>,
  // How many bytes went to this output.
  written : i64,
  // The decoders of `--compressed`, in the order that the body goes through them: the last
  // encoding of Content-Encoding first. Empty when the body is written as it came.
  decoders : Vec<Decoder>,
  // Content-Encoding named an encoding that securl does not know. The first byte of the body
  // fails, as in libcurl.
  unknown_encoding : bool,
  // A body is being written: its bytes count in `raw_in` as they come and in `delivered` after
  // any decoding.
  in_body : bool,
  raw_in : i64,
  delivered : i64,
  // `--max-filesize` for the body, or 0.
  limit : i64,
}

// libcurl hands the body to the output in pieces of at most this size (CURL_MAX_WRITE_SIZE),
// and checks `--max-filesize` before each.
const DELIVER_PIECE : i32 = 16384;

/// An output to standard output.
pub fn stdout_output() -> Output {
  return Output {
    to_stdout : true,
    file : Option<File>::None(),
    written : 0i64,
    decoders : Vec<Decoder>::new(),
    unknown_encoding : false,
    in_body : false,
    raw_in : 0i64,
    delivered : 0i64,
    limit : 0i64
  };
}

/// An output to `file`, which `main` opened.
pub fn file_output(file : File) -> Output {
  return Output {
    to_stdout : false,
    file : Option<File>::Some(file),
    written : 0i64,
    decoders : Vec<Decoder>::new(),
    unknown_encoding : false,
    in_body : false,
    raw_in : 0i64,
    delivered : 0i64,
    limit : 0i64
  };
}

/// An output that drops what it gets.
pub fn null_output() -> Output {
  return Output {
    to_stdout : false,
    file : Option<File>::None(),
    written : 0i64,
    decoders : Vec<Decoder>::new(),
    unknown_encoding : false,
    in_body : false,
    raw_in : 0i64,
    delivered : 0i64,
    limit : 0i64
  };
}

/// The names of a list of codings such as `deflate, gzip`, in order.
fn coding_names(list : &Vec<u8>) -> Vec<Vec<u8>> {
  let mut names = Vec<Vec<u8>>::new();
  let mut start = 0;
  while start < list.len() {
    let mut end = find_byte(list, 44u8, start);
    if end < 0 {
      end = list.len();
    }
    let name = trim_blanks(&range_of(list, start, end));
    start = end + 1;
    if name.len() > 0 {
      names.push(name);
    }
  }
  return names;
}

fn write_error() -> Failure {
  return fail_lit(WRITE_ERROR, "Failure writing output to destination");
}

/// Write all of `bytes` in as many writes as the file takes.
fn write_all_to_file(file : &mut File, bytes : &Vec<u8>) -> Result<i32, Failure> {
  let mut rest = clone_bytes(bytes);
  while rest.len() > 0 {
    match file.write(&rest) {
      Result<u64, FileError>::Ok(n) => {
        if n == 0u64 || (n as i32) > rest.len() {
          return Result<i32, Failure>::Err(write_error());
        }
        rest = rest_from(&rest, n as i32);
      },
      Result<u64, FileError>::Err(_e) => {
        return Result<i32, Failure>::Err(write_error());
      }
    }
  }
  return Result<i32, Failure>::Ok(0);
}

impl Output {
  /// What comes next is the body of a response. Decode it as `encodings` says: the value of
  /// its Content-Encoding headers, such as `deflate, gzip`, or empty for none. The last
  /// encoding is decoded first. `identity` and `none` change nothing. As in libcurl, more than
  /// five encodings fail at once, and an encoding that securl does not know fails at the first
  /// byte of the body.
  ///
  /// `transfer_codings` are the codings of `--tr-encoding` other than chunked, which come off
  /// first, and their limit was checked with the headers.
  pub fn start_body(self : &mut Output, transfer_codings : &Vec<u8>, encodings : &Vec<u8>)
  -> Result<i32, Failure> {
    self.in_body = true;
    self.raw_in = 0i64;
    self.delivered = 0i64;
    let mut decoders = Vec<Decoder>::new();
    self.add_decoders(&mut decoders, &coding_names(transfer_codings));
    let names = coding_names(encodings);
    if names.len() > MAX_ENCODE_STACK {
      return Result<i32, Failure>::Err(fail_lit(BAD_CONTENT_ENCODING,
        "Reject response exceeding limit of 5 content encodings"));
    }
    self.add_decoders(&mut decoders, &names);
    self.decoders = decoders;
    return Result<i32, Failure>::Ok(0);
  }

  /// Add the decoders of the codings `names` to `decoders`, the last coding first.
  fn add_decoders(self : &mut Output, decoders : &mut Vec<Decoder>, names : &Vec<Vec<u8>>)
  -> void {
    let mut i = names.len() - 1;
    while i >= 0 {
      let name = names.get_ref(i);
      let coding = coding_of(name);
      if coding != 0 {
        decoders.push(new_decoder(coding));
      } else {
        if !eq_lit_nocase(name, "identity") && !eq_lit_nocase(name, "none") {
          self.unknown_encoding = true;
        }
      }
      i = i - 1;
    }
  }

  /// End the body. Gives how many bytes of it went out, after decoding. A body that ended
  /// inside its compressed data fails, as in libcurl.
  pub fn finish_body(self : &mut Output) -> Result<i64, Failure> {
    self.in_body = false;
    let mut result = Result<i64, Failure>::Ok(self.delivered);
    for d in self.decoders.iter() {
      if result.is_ok() {
        match d.finish() {
          Result<i32, Failure>::Ok(_n) => {},
          Result<i32, Failure>::Err(f) => {
            result = Result<i64, Failure>::Err(f);
          }
        }
      }
    }
    self.decoders = Vec<Decoder>::new();
    self.unknown_encoding = false;
    return result;
  }

  /// `bytes` through the decoders of the body.
  fn decoded(self : &mut Output, bytes : &Vec<u8>) -> Result<Vec<u8>, Failure> {
    if self.unknown_encoding {
      return Result<Vec<u8>, Failure>::Err(fail_lit(BAD_CONTENT_ENCODING,
        "Unrecognized content encoding type"));
    }
    let mut data = clone_bytes(bytes);
    for d in self.decoders.iter_mut() {
      data = d.feed(&data)?;
    }
    return Result<Vec<u8>, Failure>::Ok(data);
  }

  /// The most bytes that the next body may have, before and after decoding, or 0 for no limit.
  pub fn limit_body(self : &mut Output, limit : i64) -> void {
    self.limit = limit;
  }

  /// Write all of `bytes` to the output, decoded when a body is being decoded. `console` has
  /// the right to write to standard output.
  pub fn write(self : &mut Output, console : &mut Console, bytes : &Vec<u8>)
  -> Result<i32, Failure> {
    if bytes.len() == 0 {
      return Result<i32, Failure>::Ok(0);
    }
    if self.in_body && self.limit > 0i64 && self.raw_in + (bytes.len() as i64) > self.limit {
      // As libcurl: the bytes up to the limit go out, and then the transfer fails.
      let allowed = (self.limit - self.raw_in) as i32;
      let _w = self.write_within(console, &range_of(bytes, 0, allowed))?;
      self.raw_in = self.limit;
      let mut m = lit("Exceeded the maximum allowed file size (");
      push_i64(&mut m, self.limit);
      push_lit(&mut m, ") with ");
      push_i64(&mut m, self.limit);
      push_lit(&mut m, " bytes");
      return Result<i32, Failure>::Err(fail_with(FILESIZE_EXCEEDED, m));
    }
    let _w = self.write_within(console, bytes)?;
    if self.in_body {
      self.raw_in = self.raw_in + (bytes.len() as i64);
    }
    return Result<i32, Failure>::Ok(0);
  }

  /// Write `bytes`, which are within the limit of the body, decoded when the body is.
  fn write_within(self : &mut Output, console : &mut Console, bytes : &Vec<u8>)
  -> Result<i32, Failure> {
    if bytes.len() == 0 {
      return Result<i32, Failure>::Ok(0);
    }
    if self.decoders.len() > 0 || self.unknown_encoding {
      let decoded = self.decoded(bytes)?;
      return self.put(console, &decoded);
    }
    return self.put(console, bytes);
  }

  /// Write all of `bytes` to the output as they are.
  fn put(self : &mut Output, console : &mut Console, bytes : &Vec<u8>) -> Result<i32, Failure> {
    if bytes.len() == 0 {
      return Result<i32, Failure>::Ok(0);
    }
    if self.in_body && self.limit > 0i64 && bytes.len() > DELIVER_PIECE {
      // Decoded bytes go in pieces, each checked against the limit before it goes.
      let mut at = 0;
      while at < bytes.len() {
        let mut end = at + DELIVER_PIECE;
        if end > bytes.len() {
          end = bytes.len();
        }
        let _w = self.put(console, &range_of(bytes, at, end))?;
        at = end;
      }
      return Result<i32, Failure>::Ok(0);
    }
    if self.in_body && self.limit > 0i64
       && (bytes.len() as i64) > self.limit - self.delivered {
      return Result<i32, Failure>::Err(fail_lit(FILESIZE_EXCEEDED,
        "Would have exceeded max file size"));
    }
    self.written = self.written + (bytes.len() as i64);
    if self.in_body {
      self.delivered = self.delivered + (bytes.len() as i64);
    }
    if self.to_stdout {
      if !console.to_stdout(bytes) {
        return Result<i32, Failure>::Err(write_error());
      }
      return Result<i32, Failure>::Ok(0);
    }
    // Vx has no `ref mut` pattern yet, so move the file out and put it back.
    match self.file.take() {
      Option<File>::Some(f) => {
        let mut open = f;
        let result = write_all_to_file(&mut open, bytes);
        self.file = Option<File>::Some(open);
        return result;
      },
      Option<File>::None() => {
        return Result<i32, Failure>::Ok(0);
      }
    }
  }
}

/// `text` as curl's warnings and notes print it: each line starts with `prefix`, and text
/// longer than the terminal is cut at its last blank, which stays at the end of the line, or
/// at the width when it has none. `columns` is the width of the terminal.
pub fn message_lines(prefix : *const i8, text : &Vec<u8>, columns : i32) -> Vec<u8> {
  let pre = lit(prefix);
  let mut width = 2147483647;
  if columns > pre.len() {
    width = columns - pre.len();
  }
  let mut out = Vec<u8>::new();
  let mut at = 0;
  while at < text.len() {
    append(&mut out, &pre);
    if text.len() - at > width {
      let mut cut = width - 1;
      while cut > 0 && !is_blank(text.get(at + cut)) {
        cut = cut - 1;
      }
      if cut == 0 {
        cut = width - 1;
      }
      append_range(&mut out, text, at, at + cut + 1);
      at = at + cut + 1;
    } else {
      append_range(&mut out, text, at, text.len());
      at = text.len();
    }
    out.push(10u8);
  }
  return out;
}
