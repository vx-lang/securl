// The handling of SIGPIPE.
//
// TRUSTED CODE. `std` cannot ignore a signal yet, so this file calls `signal` of the C library.
// Writes to standard output and standard error, and reads of standard input, need the rights
// of `std::io` that `main` gets in its `Root`, and are in `securl::output` and `disk::files`.

extern "C" {
  fn signal(signum : i32, handler : u64) -> u64;
}

/// Ignore SIGPIPE, as curl does, so that a write to a closed socket or pipe gives an error and
/// does not end the program.
pub fn ignore_sigpipe() -> void {
  // SIGPIPE is 13 and SIG_IGN is 1 on Linux and on macOS.
  let _old = unsafe { signal(13, 1u64) };
}
