// Generated from RFC 7541 Appendix C by a script: each example is decoded with the decoder
// of the group, and the fields and the size of the dynamic table must match the RFC.
import core::result;
import std::vec;
import sys::text;
import curlvx::bytes;
import curlvx::failure;
import curlvx::hpack;

fn hex(s : *const i8) -> Vec<u8> {
  let t = lit(s);
  let mut out = Vec<u8>::new();
  let mut i = 0;
  while i + 1 < t.len() {
    out.push((hex_value(t.get(i)) * 16 + hex_value(t.get(i + 1))) as u8);
    i = i + 2;
  }
  return out;
}

fn check(h : &mut Hpack, data : *const i8, want : *const i8, size : i32) -> void {
  match decode_block(h, &hex(data)) {
    Result<Vec<HeaderField>, Failure>::Ok(fields) => {
      let mut got = Vec<u8>::new();
      for f in fields.iter() {
        append(&mut got, &f.name);
        push_lit(&mut got, ": ");
        append(&mut got, &f.value);
        push_lit(&mut got, "\n");
      }
      assert(eq_lit(&got, want), "the decoded fields differ from the RFC");
      assert(h.dyn_size == size, "the dynamic table size differs from the RFC");
    },
    Result<Vec<HeaderField>, Failure>::Err(_f) => {
      panic("an example of the RFC did not decode");
    }
  }
}

fn main() -> i32 {
  // Request Examples without Huffman Coding
  let mut h0 = new_hpack();
  h0.max_size = 4096;
  check(&mut h0, "828684410f7777772e6578616d706c652e636f6d",
    ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\n", 57);
  check(&mut h0, "828684be58086e6f2d6361636865",
    ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\ncache-control: no-cache\n", 110);
  check(&mut h0, "828785bf400a637573746f6d2d6b65790c637573746f6d2d76616c7565",
    ":method: GET\n:scheme: https\n:path: /index.html\n:authority: www.example.com\ncustom-key: custom-value\n", 164);
  // Request Examples with Huffman Coding
  let mut h1 = new_hpack();
  h1.max_size = 4096;
  check(&mut h1, "828684418cf1e3c2e5f23a6ba0ab90f4ff",
    ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\n", 57);
  check(&mut h1, "828684be5886a8eb10649cbf",
    ":method: GET\n:scheme: http\n:path: /\n:authority: www.example.com\ncache-control: no-cache\n", 110);
  check(&mut h1, "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf",
    ":method: GET\n:scheme: https\n:path: /index.html\n:authority: www.example.com\ncustom-key: custom-value\n", 164);
  // Response Examples without Huffman Coding
  let mut h2 = new_hpack();
  h2.max_size = 256;
  check(&mut h2, "4803333032580770726976617465611d4d6f6e2c203231204f637420323031332032303a31333a323120474d546e1768747470733a2f2f7777772e6578616d706c652e636f6d",
    ":status: 302\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:21 GMT\nlocation: https://www.example.com\n", 222);
  check(&mut h2, "4803333037c1c0bf",
    ":status: 307\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:21 GMT\nlocation: https://www.example.com\n", 222);
  check(&mut h2, "88c1611d4d6f6e2c203231204f637420323031332032303a31333a323220474d54c05a04677a69707738666f6f3d4153444a4b48514b425a584f5157454f50495541585157454f49553b206d61782d6167653d333630303b2076657273696f6e3d31",
    ":status: 200\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:22 GMT\nlocation: https://www.example.com\ncontent-encoding: gzip\nset-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\n", 215);
  // Response Examples with Huffman Coding
  let mut h3 = new_hpack();
  h3.max_size = 256;
  check(&mut h3, "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",
    ":status: 302\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:21 GMT\nlocation: https://www.example.com\n", 222);
  check(&mut h3, "4883640effc1c0bf",
    ":status: 307\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:21 GMT\nlocation: https://www.example.com\n", 222);
  check(&mut h3, "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",
    ":status: 200\ncache-control: private\ndate: Mon, 21 Oct 2013 20:13:22 GMT\nlocation: https://www.example.com\ncontent-encoding: gzip\nset-cookie: foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1\n", 215);
  return 0;
}
