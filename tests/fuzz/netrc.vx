// libFuzzer target: the `.netrc` file, securl::netrc. tools/build-fuzzers.sh builds it, and
// `make fuzz` runs it. A panic, which stops the program, is a crash for libFuzzer.
import core::option;
import core::result;
import std::vec;
import sys::text;
import securl::netrc;

/// The input of libFuzzer as bytes.
fn input_of(data : *const u8, len : i64) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  let mut i = 0i64;
  while i < len {
    bytes.push(unsafe { data[i] });
    i = i + 1i64;
  }
  return bytes;
}

extern fn vx_fuzz_one(data : *const u8, len : i64) -> i32 {
  let input = input_of(data, len);
  match netrc_text(&input) {
    Result<Vec<u8>, i32>::Ok(text) => {
      let _any = netrc_find(&text, &lit("example.com"), &Vec<u8>::new());
      let _user = netrc_find(&text, &lit("example.com"), &lit("admin"));
    },
    Result<Vec<u8>, i32>::Err(_code) => {}
  }
  return 0;
}
