// libFuzzer target: the URL parser and the resolution of a Location against a base URL, securl::url. tools/build-fuzzers.sh builds it, and `make fuzz` runs it.
// A panic, which stops the program, is a crash for libFuzzer.
import core::option;
import core::result;
import std::vec;
import sys::text;
import securl::failure;
import securl::url;

/// The input of libFuzzer as bytes.
fn input_of(data : *const u8, len : i64) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  let mut i = 0i64;
  while i < len {
    bytes.push(unsafe { data[i] });
    i = i + 1i64;
  }
  return bytes;
}

extern fn vx_fuzz_one(data : *const u8, len : i64) -> i32 {
  let input = input_of(data, len);
  match parse_url(&input, false) {
    Result<Url, Failure>::Ok(u) => {
      let _t = url_text(&u);
      let _h = host_header_value(&u);
    },
    Result<Url, Failure>::Err(_f) => {}
  }
  let _p = parse_url(&input, true);
  match parse_url(&lit("http://user:pw@example.com:8080/a/b/c?q=1#f"), false) {
    Result<Url, Failure>::Ok(base) => {
      let _next = resolve_location(&base, &input);
    },
    Result<Url, Failure>::Err(_f) => {}
  }
  return 0;
}
