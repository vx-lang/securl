// The removal of a file, and the check that a path is a regular file, for the output of a
// transfer that failed.
//
// TRUSTED CODE. `std::fs` cannot remove a file or tell its kind yet, so this file calls
// `statx` and `unlink` of the C library. Each function takes the file right, as `std::fs`
// would. `statx` has the same layout on each Linux architecture, unlike `stat`.
import std::fs;
import std::vec;

extern "C" {
  fn statx(dirfd : i32, path : *const i8, flags : i32, mask : u32, buf : *mut u8) -> i32;
  fn unlink(path : *const i8) -> i32;
}

// Values from the Linux headers.
const AT_FDCWD : i32 = -100;
const STATX_TYPE : u32 = 1u32;
// `struct statx` is 256 bytes. `stx_mode`, a 16-bit number, is at byte 28.
const STATX_SIZE : i32 = 256;
const STX_MODE_AT : i32 = 28;
const S_IFREG_KIND : i32 = 8;

/// `name` as a C string, or None when it holds a zero byte.
fn c_path(name : &Vec<u8>) -> Option<Vec<i8>> {
  let mut out = Vec<i8>::new();
  for b in name.iter() {
    if *b == 0u8 {
      return Option<Vec<i8>>::None;
    }
    out.push(*b as i8);
  }
  out.push(0i8);
  return Option<Vec<i8>>::Some(out);
}

/// Whether `name` is a regular file, after symbolic links, as `stat` and `S_ISREG` tell it.
pub fn is_regular_file(_files : &Files, name : &Vec<u8>) -> bool {
  match c_path(name) {
    Option<Vec<i8>>::Some(path) => {
      let mut p = path;
      let mut info = unsafe { Vec<u8>::zeroed(STATX_SIZE) };
      let r = unsafe {
        statx(AT_FDCWD, p.as_mut_ptr() as *const i8, 0, STATX_TYPE, info.as_mut_ptr())
      };
      if r != 0 {
        return false;
      }
      // The kind of file is in bits 12 to 15 of the mode: 8 (S_IFREG) for a regular file.
      let mode = (info.get(STX_MODE_AT) as i32) + (info.get(STX_MODE_AT + 1) as i32) * 256;
      return (mode / 4096) % 16 == S_IFREG_KIND;
    },
    Option<Vec<i8>>::None() => {
      return false;
    }
  }
}

/// Remove the file `name`. False when the system says no.
pub fn remove_file(_files : &Files, name : &Vec<u8>) -> bool {
  match c_path(name) {
    Option<Vec<i8>>::Some(path) => {
      let mut p = path;
      return unsafe { unlink(p.as_mut_ptr() as *const i8) } == 0;
    },
    Option<Vec<i8>>::None() => {
      return false;
    }
  }
}
