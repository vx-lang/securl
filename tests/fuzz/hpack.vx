// libFuzzer target: the HPACK decoder of HTTP/2 header blocks, securl::hpack. tools/build-fuzzers.sh builds it, and `make fuzz` runs it.
// A panic, which stops the program, is a crash for libFuzzer.
import core::option;
import core::result;
import std::vec;
import securl::failure;
import securl::hpack;

/// The input of libFuzzer as bytes.
fn input_of(data : *const u8, len : i64) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  let mut i = 0i64;
  while i < len {
    bytes.push(unsafe { data[i] });
    i = i + 1i64;
  }
  return bytes;
}

extern fn vx_fuzz_one(data : *const u8, len : i64) -> i32 {
  let input = input_of(data, len);
  let mut h = new_hpack();
  // Twice, so that the second block sees the dynamic table that the first one left.
  let _first = decode_block(&mut h, &input);
  let _second = decode_block(&mut h, &input);
  return 0;
}
