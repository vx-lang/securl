// The command line of curl: which options securl knows, and the `Config` they make.
//
// This file needs no right at all: it reads only the argument bytes. Options that name a file,
// such as `-d @file` or `-o file`, keep the name here. `main` opens the file, because only
// `main` has the right to open files.
import core::mem;
import core::option;
import core::result;
import std::vec;
import sys::text;
import securl::auth;
import securl::bytes;
import securl::failure;
import securl::socks;

// The kinds of request body option. `-d` and `--data-ascii` read a file after `@` and drop its
// CR and LF bytes. `--data-raw` never reads a file. `--data-binary` and `--json` keep the
// bytes of the file as they are. `--data-urlencode` encodes its value.
const DATA_ASCII : i32 = 0;
const DATA_RAW : i32 = 1;
const DATA_BINARY : i32 = 2;
const DATA_URLENCODE : i32 = 3;
const DATA_JSON : i32 = 4;

/// One `-d`-like option: its kind and its value as the user wrote it.
struct DataPart {
  kind : i32,
  text : Vec<u8>,
}

/// One `-F` or `--form-string` value. `literal` is for `--form-string`.
struct FormArg {
  literal : bool,
  text : Vec<u8>,
}

/// An environment variable and its value, which is not empty.
struct EnvVar {
  name : Vec<u8>,
  value : Vec<u8>,
}

/// One URL of the command line and what goes with it, as curl's `struct getout`. A URL, an
/// `-o` or `-O`, and a `-T` each fill the first node that has none yet, so that the first `-o`
/// goes with the first URL in whatever order they come.
struct UrlNode {
  has_url : bool,
  url : Vec<u8>,
  // `-o NAME`, or `-O` (`remote`), came for this node.
  has_out : bool,
  out : Vec<u8>,
  // The file name comes from the URL: `-O`, or `--remote-name-all` before the node.
  remote : bool,
  // `-T FILE` came for this node. `-T ""` uploads nothing.
  has_upload : bool,
  upload : Vec<u8>,
  // The URL came from the file of `--url @FILE`, and has no globs.
  noglob : bool,
  // The number of the node on the command line, from 0, for `%{urlnum}`.
  num : i32,
}

/// What the command line asks for.
struct Config {
  // The URLs, each with its output and upload.
  nodes : Vec<UrlNode>,
  // `--remote-name-all`: each node from here on names its file after its URL.
  remote_name_all : bool,
  // `-g`: no URL globbing.
  globoff : bool,
  has_method : bool,
  method : Vec<u8>,
  headers : Vec<Vec<u8>>,
  data : Vec<DataPart>,
  get_data : bool,
  head : bool,
  include : bool,
  follow : bool,
  location_trusted : bool,
  max_redirs : i64,
  silent : bool,
  show_error : bool,
  verbose : bool,
  fail : bool,
  fail_with_body : bool,
  has_user : bool,
  user : Vec<u8>,
  has_user_agent : bool,
  user_agent : Vec<u8>,
  has_referer : bool,
  referer : Vec<u8>,
  auto_referer : bool,
  has_cookie : bool,
  cookie : Vec<u8>,
  has_write_out : bool,
  write_out : Vec<u8>,
  has_dump_header : bool,
  dump_header : Vec<u8>,
  http10 : bool,
  // Some node uploads a file (`-T`).
  has_upload : bool,
  has_range : bool,
  range : Vec<u8>,
  resolve : Vec<Vec<u8>>,
  connect_to : Vec<Vec<u8>>,
  // `--unix-socket`: connect to this socket file, and to no proxy.
  has_unix_socket : bool,
  unix_socket : Vec<u8>,
  max_time_ms : i64,
  connect_timeout_ms : i64,
  has_trace : bool,
  trace : Vec<u8>,
  path_as_is : bool,
  raw : bool,
  show_help : bool,
  show_version : bool,
  show_manual : bool,
  has_proxy : bool,
  proxy : Vec<u8>,
  has_proxy_user : bool,
  proxy_user : Vec<u8>,
  noproxy : Vec<u8>,
  has_output_dir : bool,
  output_dir : Vec<u8>,
  // `-k`: do not check the certificate of the server.
  insecure : bool,
  cacert : Vec<u8>,
  capath : Vec<u8>,
  // The same for an HTTPS proxy: `--proxy-insecure`, `--proxy-cacert`, `--proxy-capath`.
  proxy_insecure : bool,
  proxy_cacert : Vec<u8>,
  proxy_capath : Vec<u8>,
  // The authentication methods of `--basic`, `--digest` and `--anyauth`, as `AUTH_` bits. 0
  // means Basic, libcurl's default.
  auth_type : i32,
  // The same for the proxy: `--proxy-basic`, `--proxy-digest` and `--proxy-anyauth`.
  proxy_auth_type : i32,
  // The fields of a multipart form, in order.
  forms : Vec<FormArg>,
  // `--form-escape`: escape names and file names with backslashes.
  form_escape : bool,
  // The files of `-b` values with no `=`, which the cookie engine reads.
  cookie_files : Vec<Vec<u8>>,
  // `-c`: where the cookie engine writes its cookies at the end.
  has_cookie_jar : bool,
  cookie_jar : Vec<u8>,
  // `-j`: do not read session cookies from the files.
  junk_session_cookies : bool,
  // `--http1.1` or `--http1.0`: no HTTP/2, which curl uses by default over TLS.
  no_h2 : bool,
  // `--http2-prior-knowledge`: HTTP/2 over plain TCP with no upgrade.
  h2_prior_knowledge : bool,
  // `--tcp-nodelay`, on by default: send small packets at once (TCP_NODELAY).
  tcp_nodelay : bool,
  // `--keepalive`, on by default: TCP keepalive probes on an idle connection.
  keepalive : bool,
  // `--keepalive-time`: the seconds before the first probe and between probes, or 0 for the
  // 60 of libcurl.
  keepalive_time : i64,
  // `--keepalive-cnt`: the probes with no answer before the connection is dropped, or 0 for
  // the 9 of libcurl.
  keepalive_cnt : i64,
  // `--compressed`: ask for gzip and deflate, and decode them.
  compressed : bool,
  // `--tr-encoding`: ask for gzip as a transfer coding, and decode the transfer codings.
  tr_encoding : bool,
  // `-p`: reach the server through a CONNECT tunnel of the HTTP proxy, for `http://` too.
  proxytunnel : bool,
  // `-x` was given, perhaps with an empty value, which turns the proxy variables off.
  proxy_set : bool,
  // The kind of proxy when its URL has no scheme: PROXY_HTTP for `-x`, or a kind of SOCKS
  // proxy for `--socks4`, `--socks4a`, `--socks5` and `--socks5-hostname` (securl::socks).
  proxy_kind : i32,
  // `--noproxy` was given, perhaps with an empty value, which turns `no_proxy` off.
  has_noproxy : bool,
  // `--cert` (`-E`), `--cert-type`, `--key`, `--key-type` and `--pass`: the client
  // certificate for TLS. A password after the file name of `--cert` sets `pass` too.
  cert : Vec<u8>,
  cert_type : Vec<u8>,
  key : Vec<u8>,
  key_type : Vec<u8>,
  has_pass : bool,
  pass : Vec<u8>,
  // `--hsts`: the HSTS cache is on, and its file, which may be empty for none.
  has_hsts : bool,
  // `--suppress-connect-headers`: `-i` and `-D` leave out the reply of a CONNECT proxy.
  suppress_connect_headers : bool,
  // `--remove-on-error`: remove the output file of a transfer that fails.
  remove_on_error : bool,
  // The width of the terminal for warnings, from `COLUMNS`, which the tool reads, or 79.
  columns : i32,
  // `--limit-rate`: bytes per second for each direction of a transfer, or 0.
  limit_rate : i64,
  // `--max-filesize`: the most bytes of a body, before and after decoding, or 0.
  max_filesize : i64,
  // `--retry` and its options: how many times to try a transfer again after a transient
  // error, the wait between tries (0 for curl's 1 second that doubles), the most time for all
  // tries (0 for no limit), and whether a refused connection or any error counts too.
  retry : i64,
  retry_delay_ms : i64,
  retry_max_time_ms : i64,
  retry_connrefused : bool,
  retry_all_errors : bool,
  // `-C`: go on from byte `resume_from` of the output, or (`-C -`) from the size of the output
  // file.
  use_resume : bool,
  resume_from : i64,
  resume_current : bool,
  // `-J`: with `-O`, the file name comes from the Content-Disposition of the response.
  remote_header_name : bool,
  hsts : Vec<u8>,
  // The proxy variables of the environment that are set, such as `https_proxy`. The tool
  // reads them. This package gets their values, and not the right to read the environment.
  proxy_env : Vec<EnvVar>,
}

/// A `Config` with curl's defaults.
pub fn default_config() -> Config {
  return Config {
    nodes : Vec<UrlNode>::new(),
    remote_name_all : false,
    globoff : false,
    has_method : false,
    method : Vec<u8>::new(),
    headers : Vec<Vec<u8>>::new(),
    data : Vec<DataPart>::new(),
    get_data : false,
    head : false,
    include : false,
    follow : false,
    location_trusted : false,
    max_redirs : 50i64,
    silent : false,
    show_error : false,
    verbose : false,
    fail : false,
    fail_with_body : false,
    has_user : false,
    user : Vec<u8>::new(),
    has_user_agent : false,
    user_agent : Vec<u8>::new(),
    has_referer : false,
    referer : Vec<u8>::new(),
    auto_referer : false,
    has_cookie : false,
    cookie : Vec<u8>::new(),
    has_write_out : false,
    write_out : Vec<u8>::new(),
    has_dump_header : false,
    dump_header : Vec<u8>::new(),
    http10 : false,
    has_upload : false,
    has_range : false,
    range : Vec<u8>::new(),
    resolve : Vec<Vec<u8>>::new(),
    connect_to : Vec<Vec<u8>>::new(),
    has_unix_socket : false,
    unix_socket : Vec<u8>::new(),
    max_time_ms : 0i64,
    connect_timeout_ms : 0i64,
    has_trace : false,
    trace : Vec<u8>::new(),
    path_as_is : false,
    raw : false,
    show_help : false,
    show_version : false,
    show_manual : false,
    has_proxy : false,
    proxy : Vec<u8>::new(),
    has_proxy_user : false,
    proxy_user : Vec<u8>::new(),
    noproxy : Vec<u8>::new(),
    has_output_dir : false,
    output_dir : Vec<u8>::new(),
    insecure : false,
    cacert : Vec<u8>::new(),
    capath : Vec<u8>::new(),
    proxy_insecure : false,
    proxy_cacert : Vec<u8>::new(),
    proxy_capath : Vec<u8>::new(),
    auth_type : 0,
    proxy_auth_type : 0,
    forms : Vec<FormArg>::new(),
    form_escape : false,
    cookie_files : Vec<Vec<u8>>::new(),
    has_cookie_jar : false,
    cookie_jar : Vec<u8>::new(),
    junk_session_cookies : false,
    no_h2 : false,
    h2_prior_knowledge : false,
    tcp_nodelay : true,
    keepalive : true,
    keepalive_time : 0i64,
    keepalive_cnt : 0i64,
    compressed : false,
    tr_encoding : false,
    proxytunnel : false,
    proxy_set : false,
    proxy_kind : PROXY_HTTP,
    has_noproxy : false,
    cert : Vec<u8>::new(),
    cert_type : Vec<u8>::new(),
    key : Vec<u8>::new(),
    key_type : Vec<u8>::new(),
    has_pass : false,
    pass : Vec<u8>::new(),
    has_hsts : false,
    suppress_connect_headers : false,
    remove_on_error : false,
    columns : 79,
    limit_rate : 0i64,
    max_filesize : 0i64,
    retry : 0i64,
    retry_delay_ms : 0i64,
    retry_max_time_ms : 0i64,
    retry_connrefused : false,
    retry_all_errors : false,
    use_resume : false,
    resume_from : 0i64,
    resume_current : false,
    remote_header_name : false,
    hsts : Vec<u8>::new(),
    proxy_env : Vec<EnvVar>::new()
  };
}

// The options securl knows. An option that is in curl but not here is "unknown".
const OPT_UNKNOWN : i32 = 0;
const OPT_USER_AGENT : i32 = 1;
const OPT_COOKIE : i32 = 2;
const OPT_DATA : i32 = 3;
const OPT_DATA_ASCII : i32 = 4;
const OPT_DATA_RAW : i32 = 5;
const OPT_DATA_BINARY : i32 = 6;
const OPT_DATA_URLENCODE : i32 = 7;
const OPT_JSON : i32 = 8;
const OPT_DUMP_HEADER : i32 = 9;
const OPT_REFERER : i32 = 10;
const OPT_HEADER : i32 = 11;
const OPT_MAX_TIME : i32 = 12;
const OPT_CONNECT_TIMEOUT : i32 = 13;
const OPT_OUTPUT : i32 = 14;
const OPT_RANGE : i32 = 15;
const OPT_UPLOAD_FILE : i32 = 16;
const OPT_USER : i32 = 17;
const OPT_WRITE_OUT : i32 = 18;
const OPT_REQUEST : i32 = 19;
const OPT_URL : i32 = 20;
const OPT_MAX_REDIRS : i32 = 21;
const OPT_RESOLVE : i32 = 22;
const OPT_CONNECT_TO : i32 = 23;
const OPT_TRACE_ASCII : i32 = 24;
const OPT_TRACE : i32 = 25;
const OPT_PROXY : i32 = 26;
const OPT_PROXY_USER : i32 = 27;
const OPT_NOPROXY : i32 = 28;
const OPT_OUTPUT_DIR : i32 = 29;
const OPT_HTTP10 : i32 = 30;
const OPT_HTTP11 : i32 = 31;
const OPT_FAIL : i32 = 32;
const OPT_FAIL_WITH_BODY : i32 = 33;
const OPT_GET : i32 = 34;
const OPT_INCLUDE : i32 = 35;
const OPT_HEAD : i32 = 36;
const OPT_INSECURE : i32 = 37;
const OPT_LOCATION : i32 = 38;
const OPT_LOCATION_TRUSTED : i32 = 39;
const OPT_REMOTE_NAME : i32 = 40;
const OPT_REMOTE_NAME_ALL : i32 = 41;
const OPT_DISABLE : i32 = 42;
const OPT_SILENT : i32 = 43;
const OPT_SHOW_ERROR : i32 = 44;
const OPT_VERBOSE : i32 = 45;
const OPT_VERSION : i32 = 46;
const OPT_HELP : i32 = 47;
const OPT_GLOBOFF : i32 = 48;
const OPT_PATH_AS_IS : i32 = 49;
const OPT_TRACE_TIME : i32 = 50;
const OPT_PROGRESS_BAR : i32 = 51;
const OPT_NO_PROGRESS_METER : i32 = 52;
const OPT_NO_BUFFER : i32 = 53;
const OPT_RAW : i32 = 54;
const OPT_COMPRESSED : i32 = 55;
const OPT_DIGEST : i32 = 56;
const OPT_BASIC : i32 = 57;
const OPT_ANYAUTH : i32 = 58;
const OPT_PROXY_DIGEST : i32 = 59;
const OPT_PROXY_BASIC : i32 = 62;
const OPT_PROXY_ANYAUTH : i32 = 63;
const OPT_FORM : i32 = 64;
const OPT_FORM_STRING : i32 = 65;
const OPT_FORM_ESCAPE : i32 = 66;
const OPT_COOKIE_JAR : i32 = 67;
const OPT_JUNK_SESSION_COOKIES : i32 = 68;
const OPT_HTTP2 : i32 = 69;
const OPT_HTTP2_PRIOR_KNOWLEDGE : i32 = 70;
const OPT_TCP_NODELAY : i32 = 71;
const OPT_KEEPALIVE : i32 = 72;
const OPT_KEEPALIVE_TIME : i32 = 73;
const OPT_KEEPALIVE_CNT : i32 = 74;
const OPT_PROXYTUNNEL : i32 = 75;
const OPT_SOCKS4 : i32 = 76;
const OPT_SOCKS4A : i32 = 77;
const OPT_SOCKS5 : i32 = 78;
const OPT_SOCKS5_HOSTNAME : i32 = 79;
const OPT_CERT : i32 = 80;
const OPT_CERT_TYPE : i32 = 81;
const OPT_KEY : i32 = 82;
const OPT_KEY_TYPE : i32 = 83;
const OPT_PASS : i32 = 84;
const OPT_TR_ENCODING : i32 = 85;
const OPT_HSTS : i32 = 86;
const OPT_SUPPRESS_CONNECT_HEADERS : i32 = 87;
const OPT_PROXY_INSECURE : i32 = 88;
const OPT_PROXY_CACERT : i32 = 89;
const OPT_PROXY_CAPATH : i32 = 90;
const OPT_REMOVE_ON_ERROR : i32 = 91;
const OPT_LIMIT_RATE : i32 = 92;
const OPT_MAX_FILESIZE : i32 = 93;
// `--next` and `-K`, which the parser handles itself.
const OPT_NEXT : i32 = 94;
const OPT_CONFIG : i32 = 95;
const OPT_RETRY : i32 = 96;
const OPT_RETRY_DELAY : i32 = 97;
const OPT_RETRY_MAX_TIME : i32 = 98;
const OPT_RETRY_CONNREFUSED : i32 = 99;
const OPT_RETRY_ALL_ERRORS : i32 = 100;
const OPT_CONTINUE_AT : i32 = 101;
const OPT_MANUAL : i32 = 102;
const OPT_REMOTE_HEADER_NAME : i32 = 103;
const OPT_UNIX_SOCKET : i32 = 104;
// `--stderr`, which the parser hands to the tool, as `-K`.
const OPT_STDERR : i32 = 105;
// Options with a value that came after the booleans.
const OPT_CACERT : i32 = 60;
const OPT_CAPATH : i32 = 61;

/// The option of a long name such as `header`, without the leading `--`.
fn long_option(name : &Vec<u8>) -> i32 {
  if eq_lit(name, "user-agent") { return OPT_USER_AGENT; }
  if eq_lit(name, "cookie") { return OPT_COOKIE; }
  if eq_lit(name, "data") { return OPT_DATA; }
  if eq_lit(name, "data-ascii") { return OPT_DATA_ASCII; }
  if eq_lit(name, "data-raw") { return OPT_DATA_RAW; }
  if eq_lit(name, "data-binary") { return OPT_DATA_BINARY; }
  if eq_lit(name, "data-urlencode") { return OPT_DATA_URLENCODE; }
  if eq_lit(name, "json") { return OPT_JSON; }
  if eq_lit(name, "dump-header") { return OPT_DUMP_HEADER; }
  if eq_lit(name, "referer") { return OPT_REFERER; }
  if eq_lit(name, "header") { return OPT_HEADER; }
  if eq_lit(name, "max-time") { return OPT_MAX_TIME; }
  if eq_lit(name, "connect-timeout") { return OPT_CONNECT_TIMEOUT; }
  if eq_lit(name, "output") { return OPT_OUTPUT; }
  if eq_lit(name, "range") { return OPT_RANGE; }
  if eq_lit(name, "upload-file") { return OPT_UPLOAD_FILE; }
  if eq_lit(name, "user") { return OPT_USER; }
  if eq_lit(name, "write-out") { return OPT_WRITE_OUT; }
  if eq_lit(name, "request") { return OPT_REQUEST; }
  if eq_lit(name, "url") { return OPT_URL; }
  if eq_lit(name, "max-redirs") { return OPT_MAX_REDIRS; }
  if eq_lit(name, "resolve") { return OPT_RESOLVE; }
  if eq_lit(name, "connect-to") { return OPT_CONNECT_TO; }
  if eq_lit(name, "trace-ascii") { return OPT_TRACE_ASCII; }
  if eq_lit(name, "trace") { return OPT_TRACE; }
  if eq_lit(name, "proxy") { return OPT_PROXY; }
  if eq_lit(name, "proxy-user") { return OPT_PROXY_USER; }
  if eq_lit(name, "noproxy") { return OPT_NOPROXY; }
  if eq_lit(name, "output-dir") { return OPT_OUTPUT_DIR; }
  if eq_lit(name, "http1.0") { return OPT_HTTP10; }
  if eq_lit(name, "http1.1") { return OPT_HTTP11; }
  if eq_lit(name, "fail") { return OPT_FAIL; }
  if eq_lit(name, "fail-with-body") { return OPT_FAIL_WITH_BODY; }
  if eq_lit(name, "get") { return OPT_GET; }
  if eq_lit(name, "include") { return OPT_INCLUDE; }
  if eq_lit(name, "show-headers") { return OPT_INCLUDE; }
  if eq_lit(name, "head") { return OPT_HEAD; }
  if eq_lit(name, "insecure") { return OPT_INSECURE; }
  if eq_lit(name, "location") { return OPT_LOCATION; }
  if eq_lit(name, "location-trusted") { return OPT_LOCATION_TRUSTED; }
  if eq_lit(name, "remote-name") { return OPT_REMOTE_NAME; }
  if eq_lit(name, "remote-name-all") { return OPT_REMOTE_NAME_ALL; }
  if eq_lit(name, "disable") { return OPT_DISABLE; }
  if eq_lit(name, "silent") { return OPT_SILENT; }
  if eq_lit(name, "show-error") { return OPT_SHOW_ERROR; }
  if eq_lit(name, "verbose") { return OPT_VERBOSE; }
  if eq_lit(name, "version") { return OPT_VERSION; }
  if eq_lit(name, "help") { return OPT_HELP; }
  if eq_lit(name, "globoff") { return OPT_GLOBOFF; }
  if eq_lit(name, "path-as-is") { return OPT_PATH_AS_IS; }
  if eq_lit(name, "trace-time") { return OPT_TRACE_TIME; }
  if eq_lit(name, "progress-bar") { return OPT_PROGRESS_BAR; }
  if eq_lit(name, "no-progress-meter") { return OPT_NO_PROGRESS_METER; }
  if eq_lit(name, "buffer") { return OPT_NO_BUFFER; }
  if eq_lit(name, "raw") { return OPT_RAW; }
  if eq_lit(name, "compressed") { return OPT_COMPRESSED; }
  if eq_lit(name, "digest") { return OPT_DIGEST; }
  if eq_lit(name, "basic") { return OPT_BASIC; }
  if eq_lit(name, "anyauth") { return OPT_ANYAUTH; }
  if eq_lit(name, "proxy-digest") { return OPT_PROXY_DIGEST; }
  if eq_lit(name, "proxy-basic") { return OPT_PROXY_BASIC; }
  if eq_lit(name, "proxy-anyauth") { return OPT_PROXY_ANYAUTH; }
  if eq_lit(name, "form") { return OPT_FORM; }
  if eq_lit(name, "form-string") { return OPT_FORM_STRING; }
  if eq_lit(name, "form-escape") { return OPT_FORM_ESCAPE; }
  if eq_lit(name, "cookie-jar") { return OPT_COOKIE_JAR; }
  if eq_lit(name, "junk-session-cookies") { return OPT_JUNK_SESSION_COOKIES; }
  if eq_lit(name, "http2") { return OPT_HTTP2; }
  if eq_lit(name, "http2-prior-knowledge") { return OPT_HTTP2_PRIOR_KNOWLEDGE; }
  if eq_lit(name, "cacert") { return OPT_CACERT; }
  if eq_lit(name, "capath") { return OPT_CAPATH; }
  if eq_lit(name, "tcp-nodelay") { return OPT_TCP_NODELAY; }
  if eq_lit(name, "keepalive") { return OPT_KEEPALIVE; }
  if eq_lit(name, "keepalive-time") { return OPT_KEEPALIVE_TIME; }
  if eq_lit(name, "keepalive-cnt") { return OPT_KEEPALIVE_CNT; }
  if eq_lit(name, "proxytunnel") { return OPT_PROXYTUNNEL; }
  if eq_lit(name, "socks4") { return OPT_SOCKS4; }
  if eq_lit(name, "socks4a") { return OPT_SOCKS4A; }
  if eq_lit(name, "socks5") { return OPT_SOCKS5; }
  if eq_lit(name, "socks5-hostname") { return OPT_SOCKS5_HOSTNAME; }
  if eq_lit(name, "cert") { return OPT_CERT; }
  if eq_lit(name, "cert-type") { return OPT_CERT_TYPE; }
  if eq_lit(name, "key") { return OPT_KEY; }
  if eq_lit(name, "key-type") { return OPT_KEY_TYPE; }
  if eq_lit(name, "pass") { return OPT_PASS; }
  if eq_lit(name, "tr-encoding") { return OPT_TR_ENCODING; }
  if eq_lit(name, "hsts") { return OPT_HSTS; }
  if eq_lit(name, "suppress-connect-headers") { return OPT_SUPPRESS_CONNECT_HEADERS; }
  if eq_lit(name, "proxy-insecure") { return OPT_PROXY_INSECURE; }
  if eq_lit(name, "proxy-cacert") { return OPT_PROXY_CACERT; }
  if eq_lit(name, "proxy-capath") { return OPT_PROXY_CAPATH; }
  if eq_lit(name, "remove-on-error") { return OPT_REMOVE_ON_ERROR; }
  if eq_lit(name, "limit-rate") { return OPT_LIMIT_RATE; }
  if eq_lit(name, "max-filesize") { return OPT_MAX_FILESIZE; }
  if eq_lit(name, "next") { return OPT_NEXT; }
  if eq_lit(name, "config") { return OPT_CONFIG; }
  if eq_lit(name, "retry") { return OPT_RETRY; }
  if eq_lit(name, "retry-delay") { return OPT_RETRY_DELAY; }
  if eq_lit(name, "retry-max-time") { return OPT_RETRY_MAX_TIME; }
  if eq_lit(name, "retry-connrefused") { return OPT_RETRY_CONNREFUSED; }
  if eq_lit(name, "retry-all-errors") { return OPT_RETRY_ALL_ERRORS; }
  if eq_lit(name, "continue-at") { return OPT_CONTINUE_AT; }
  if eq_lit(name, "manual") { return OPT_MANUAL; }
  if eq_lit(name, "remote-header-name") { return OPT_REMOTE_HEADER_NAME; }
  if eq_lit(name, "unix-socket") { return OPT_UNIX_SOCKET; }
  if eq_lit(name, "stderr") { return OPT_STDERR; }
  return OPT_UNKNOWN;
}

/// The option of a short letter such as `H`.
fn short_option(letter : u8) -> i32 {
  if letter == 65u8 { return OPT_USER_AGENT; }      // A
  if letter == 70u8 { return OPT_FORM; }            // F
  if letter == 99u8 { return OPT_COOKIE_JAR; }      // c
  if letter == 106u8 { return OPT_JUNK_SESSION_COOKIES; } // j
  if letter == 98u8 { return OPT_COOKIE; }          // b
  if letter == 100u8 { return OPT_DATA; }           // d
  if letter == 68u8 { return OPT_DUMP_HEADER; }     // D
  if letter == 101u8 { return OPT_REFERER; }        // e
  if letter == 72u8 { return OPT_HEADER; }          // H
  if letter == 109u8 { return OPT_MAX_TIME; }       // m
  if letter == 111u8 { return OPT_OUTPUT; }         // o
  if letter == 114u8 { return OPT_RANGE; }          // r
  if letter == 67u8 { return OPT_CONTINUE_AT; }     // C
  if letter == 77u8 { return OPT_MANUAL; }          // M
  if letter == 74u8 { return OPT_REMOTE_HEADER_NAME; } // J
  if letter == 84u8 { return OPT_UPLOAD_FILE; }     // T
  if letter == 117u8 { return OPT_USER; }           // u
  if letter == 119u8 { return OPT_WRITE_OUT; }      // w
  if letter == 88u8 { return OPT_REQUEST; }         // X
  if letter == 120u8 { return OPT_PROXY; }          // x
  if letter == 85u8 { return OPT_PROXY_USER; }      // U
  if letter == 48u8 { return OPT_HTTP10; }          // 0
  if letter == 102u8 { return OPT_FAIL; }           // f
  if letter == 71u8 { return OPT_GET; }             // G
  if letter == 105u8 { return OPT_INCLUDE; }        // i
  if letter == 73u8 { return OPT_HEAD; }            // I
  if letter == 107u8 { return OPT_INSECURE; }       // k
  if letter == 76u8 { return OPT_LOCATION; }        // L
  if letter == 79u8 { return OPT_REMOTE_NAME; }     // O
  if letter == 113u8 { return OPT_DISABLE; }        // q
  if letter == 58u8 { return OPT_NEXT; }            // :
  if letter == 75u8 { return OPT_CONFIG; }          // K
  if letter == 115u8 { return OPT_SILENT; }         // s
  if letter == 83u8 { return OPT_SHOW_ERROR; }      // S
  if letter == 118u8 { return OPT_VERBOSE; }        // v
  if letter == 86u8 { return OPT_VERSION; }         // V
  if letter == 104u8 { return OPT_HELP; }           // h
  if letter == 103u8 { return OPT_GLOBOFF; }        // g
  if letter == 35u8 { return OPT_PROGRESS_BAR; }    // #
  if letter == 78u8 { return OPT_NO_BUFFER; }       // N
  if letter == 112u8 { return OPT_PROXYTUNNEL; }    // p
  if letter == 69u8 { return OPT_CERT; }            // E
  return OPT_UNKNOWN;
}

/// Whether the option takes a value.
fn takes_value(id : i32) -> bool {
  return (id >= OPT_USER_AGENT && id <= OPT_OUTPUT_DIR) || id == OPT_CACERT || id == OPT_CAPATH
    || id == OPT_FORM || id == OPT_FORM_STRING || id == OPT_COOKIE_JAR
    || id == OPT_KEEPALIVE_TIME || id == OPT_KEEPALIVE_CNT
    || (id >= OPT_SOCKS4 && id <= OPT_PASS) || id == OPT_HSTS || id == OPT_PROXY_CACERT
    || id == OPT_PROXY_CAPATH || id == OPT_LIMIT_RATE || id == OPT_MAX_FILESIZE || id == OPT_CONFIG
    || (id >= OPT_RETRY && id <= OPT_RETRY_MAX_TIME) || id == OPT_CONTINUE_AT
    || id == OPT_UNIX_SOCKET || id == OPT_STDERR;
}

/// Whether the value of the option names a file, as curl's `ARG_FILE` options.
fn takes_file(id : i32) -> bool {
  return id == OPT_CACERT || id == OPT_CAPATH || id == OPT_CERT || id == OPT_CONFIG
    || id == OPT_DUMP_HEADER || id == OPT_KEY || id == OPT_OUTPUT || id == OPT_PROXY_CACERT
    || id == OPT_PROXY_CAPATH || id == OPT_TRACE || id == OPT_TRACE_ASCII
    || id == OPT_UNIX_SOCKET || id == OPT_UPLOAD_FILE || id == OPT_STDERR;
}

/// A time in seconds, such as `2` or `2.5`, as milliseconds. None when it is not a number.
pub fn seconds_to_ms(text : &Vec<u8>) -> Option<i64> {
  let dot = find_byte(text, 46u8, 0);
  let mut whole = clone_bytes(text);
  let mut frac = Vec<u8>::new();
  if dot >= 0 {
    whole = range_of(text, 0, dot);
    frac = rest_from(text, dot + 1);
  }
  let mut ms : i64 = 0i64;
  if whole.len() > 0 {
    match parse_u64(&whole) {
      Option<u64>::Some(s) => {
        // As curl's `secs2ms`: at most LONG_MAX / 1000 - 1 seconds.
        if s > 9223372036854774u64 {
          return Option<i64>::None();
        }
        ms = (s as i64) * 1000i64;
      },
      Option<u64>::None() => {
        return Option<i64>::None();
      }
    }
  }
  let mut scale : i64 = 100i64;
  let mut i = 0;
  while i < frac.len() {
    let b = frac.get(i);
    if !is_digit(b) {
      return Option<i64>::None();
    }
    ms = ms + ((b - 48u8) as i64) * scale;
    scale = scale / 10i64;
    i = i + 1;
  }
  return Option<i64>::Some(ms);
}

fn done() -> Result<i32, Failure> {
  return Result<i32, Failure>::Ok(0);
}

/// curl's error for an option that does not go with another one: its `errorf` line, and then
/// "is badly used here".
fn bad_use(name : &Vec<u8>, why : *const i8) -> Failure {
  let mut m = lit(why);
  push_lit(&mut m, "\ncurl: option ");
  append(&mut m, name);
  push_lit(&mut m, ": is badly used here");
  return fail_with(FAILED_INIT, m);
}

fn all_digits(v : &Vec<u8>) -> bool {
  for b in v.iter() {
    if !is_digit(*b) {
      return false;
    }
  }
  return true;
}

fn option_error(name : &Vec<u8>, what : *const i8) -> Failure {
  let mut m = lit("option ");
  append(&mut m, name);
  push_lit(&mut m, ": ");
  push_lit(&mut m, what);
  return fail_with(FAILED_INIT, m);
}

/// The value of an option that takes a number of 0 or more, as curl's `str2unum` reads it: an
/// optional `-`, then decimal digits that fit in 63 bits, and nothing else.
fn unsigned_arg(value : &Vec<u8>, shown : &Vec<u8>) -> Result<i64, Failure> {
  let negative = value.len() > 0 && value.get(0) == 45u8;
  let mut digits = clone_bytes(value);
  if negative {
    digits = rest_from(value, 1);
  }
  let mut n : i64 = 0i64;
  let mut ok = digits.len() > 0;
  for b in digits.iter() {
    if !is_digit(*b) || n > 922337203685477579i64 {
      ok = false;
      break;
    }
    n = n * 10i64 + ((*b - 48u8) as i64);
  }
  if !ok {
    return Result<i64, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
  }
  if negative && n > 0i64 {
    return Result<i64, Failure>::Err(option_error(shown, "expected a positive numerical parameter"));
  }
  return Result<i64, Failure>::Ok(n);
}

const I64_MAX : i64 = 9223372036854775807i64;

/// The decimal number at `at` of `s`, as curl's `curlx_str_number` reads it: digits only. Gives
/// the index after it and puts the number in `out`, or -1 for no digits and -2 for a number
/// above the largest 64-bit one.
fn number_at(s : &Vec<u8>, at : i32, out : &mut i64) -> i32 {
  let mut i = at;
  let mut n = 0i64;
  while i < s.len() && is_digit(s.get(i)) {
    let d = (s.get(i) - 48u8) as i64;
    if n > (I64_MAX - d) / 10i64 {
      return -2;
    }
    n = n * 10i64 + d;
    i = i + 1;
  }
  if i == at {
    return -1;
  }
  *out = n;
  return i;
}

/// The multiplier of a size unit letter (K, M, G, T or P, in any case), and how many digits
/// it has, or 0.
fn size_unit(b : u8, digits : &mut i32) -> i64 {
  let u = ascii_lower(b);
  if u == 107u8 {
    *digits = 4;
    return 1024i64;
  }
  if u == 109u8 {
    *digits = 7;
    return 1048576i64;
  }
  if u == 103u8 {
    *digits = 10;
    return 1073741824i64;
  }
  if u == 116u8 {
    *digits = 13;
    return 1099511627776i64;
  }
  if u == 112u8 {
    *digits = 16;
    return 1125899906842624i64;
  }
  return 0i64;
}

/// A size such as `100`, `2k` or `1.5M`, as curl's `GetSizeParameter` reads it for
/// `--limit-rate`: a number of bytes, with a fraction only before a unit letter.
fn size_arg(value : &Vec<u8>, shown : &Vec<u8>) -> Result<i64, Failure> {
  let mut number = 0i64;
  let mut at = number_at(value, 0, &mut number);
  if at == -2 {
    return Result<i64, Failure>::Err(option_error(shown, "too large number"));
  }
  if at < 0 {
    return Result<i64, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
  }
  let mut prec = 0i64;
  let mut plen = 0;
  if at < value.len() && value.get(at) == 46u8 {
    let after = number_at(value, at + 1, &mut prec);
    if after < 0 {
      return Result<i64, Failure>::Err(option_error(shown,
        "expected a proper numerical parameter"));
    }
    plen = after - at - 1;
    at = after;
  }
  let rest = value.len() - at;
  if rest > 1 {
    return Result<i64, Failure>::Err(option_error(shown, "is badly used here"));
  }
  let mut mul = 1i64;
  let mut add = 0i64;
  if rest == 0 || ascii_lower(value.get(at)) == 98u8 {
    if plen > 0 {
      // No part of a byte.
      return Result<i64, Failure>::Err(option_error(shown, "is badly used here"));
    }
  } else {
    let mut unit_digits = 0;
    mul = size_unit(value.get(at), &mut unit_digits);
    if mul == 0i64 {
      return Result<i64, Failure>::Err(option_error(shown, "is badly used here"));
    }
    if prec > 0i64 {
      // More digits of the fraction than the unit has are cut.
      while unit_digits <= plen {
        prec = prec / 10i64;
        plen = plen - 1;
      }
      let mut frac = 1i64;
      while plen > 0 {
        frac = frac * 10i64;
        plen = plen - 1;
      }
      if I64_MAX / mul > prec {
        add = mul * prec / frac;
      } else {
        add = (mul / frac) * prec;
      }
    }
  }
  if number > (I64_MAX - add) / mul {
    return Result<i64, Failure>::Err(option_error(shown, "too large number"));
  }
  return Result<i64, Failure>::Ok(number * mul + add);
}

/// The value of `--cert`, split into the file name and the password after it.
struct CertParameter {
  name : Vec<u8>,
  has_password : bool,
  password : Vec<u8>,
}

/// Split the value of `--cert` as curl's `parse_cert_parameter` does: the first `:` that no
/// backslash escapes ends the name, and the rest is the password. `\:` is a colon and `\\` a
/// backslash in the name, and a backslash before anything else stays. A value that starts with
/// `pkcs11:` is a PKCS#11 URI and stays whole.
pub fn split_cert_parameter(value : &Vec<u8>) -> CertParameter {
  let mut name = Vec<u8>::new();
  if starts_lit_nocase(value, "pkcs11:") {
    return CertParameter {
      name : clone_bytes(value),
      has_password : false,
      password : Vec<u8>::new()
    };
  }
  let mut i = 0;
  while i < value.len() {
    let b = value.get(i);
    if b == 92u8 {
      if i + 1 >= value.len() {
        name.push(92u8);
        i = i + 1;
        continue;
      }
      let next = value.get(i + 1);
      if next != 92u8 && next != 58u8 {
        name.push(92u8);
      }
      name.push(next);
      i = i + 2;
      continue;
    }
    if b == 58u8 {
      // An empty password counts as none.
      let rest = rest_from(value, i + 1);
      return CertParameter {
        name : name,
        has_password : rest.len() > 0,
        password : rest
      };
    }
    name.push(b);
    i = i + 1;
  }
  return CertParameter {
    name : name,
    has_password : false,
    password : Vec<u8>::new()
  };
}

fn add_data(cfg : &mut Config, kind : i32, value : &Vec<u8>) -> void {
  cfg.data.push(DataPart {
    kind : kind,
    text : clone_bytes(value)
  });
}

/// Apply option `id` with `value` to `cfg`. `enable` is false for the `--no-` form of an option.
/// `shown` is the option as the user wrote it, for error messages.
fn apply(cfg : &mut Config, id : i32, value : &Vec<u8>, enable : bool, shown : &Vec<u8>)
-> Result<i32, Failure> {
  if id == OPT_USER_AGENT {
    cfg.has_user_agent = true;
    cfg.user_agent = clone_bytes(value);
    return done();
  }
  if id == OPT_COOKIE {
    // A value with `=` is a cookie string: each one adds to the Cookie header, after a `; `.
    // A value with no `=` names a file for the cookie engine.
    if find_byte(value, 61u8, 0) < 0 {
      cfg.cookie_files.push(clone_bytes(value));
      return done();
    }
    if cfg.has_cookie {
      push_lit(&mut cfg.cookie, "; ");
      append(&mut cfg.cookie, value);
    } else {
      cfg.has_cookie = true;
      cfg.cookie = clone_bytes(value);
    }
    return done();
  }
  if id == OPT_HSTS {
    cfg.has_hsts = true;
    cfg.hsts = clone_bytes(value);
    return done();
  }
  if id == OPT_COOKIE_JAR {
    cfg.has_cookie_jar = true;
    cfg.cookie_jar = clone_bytes(value);
    return done();
  }
  if id == OPT_JUNK_SESSION_COOKIES {
    cfg.junk_session_cookies = enable;
    return done();
  }
  if id == OPT_DATA || id == OPT_DATA_ASCII {
    add_data(cfg, DATA_ASCII, value);
    return done();
  }
  if id == OPT_DATA_RAW {
    add_data(cfg, DATA_RAW, value);
    return done();
  }
  if id == OPT_DATA_BINARY {
    add_data(cfg, DATA_BINARY, value);
    return done();
  }
  if id == OPT_DATA_URLENCODE {
    add_data(cfg, DATA_URLENCODE, value);
    return done();
  }
  if id == OPT_JSON {
    add_data(cfg, DATA_JSON, value);
    return done();
  }
  if id == OPT_DUMP_HEADER {
    cfg.has_dump_header = true;
    cfg.dump_header = clone_bytes(value);
    return done();
  }
  if id == OPT_REFERER {
    // `-e "url;auto"` also sets the Referer of each redirect.
    let semi = find_seq(value, &lit(";auto"), 0);
    if semi >= 0 && semi + 5 == value.len() {
      cfg.auto_referer = true;
      cfg.referer = range_of(value, 0, semi);
      cfg.has_referer = semi > 0;
    } else {
      cfg.has_referer = true;
      cfg.referer = clone_bytes(value);
    }
    return done();
  }
  if id == OPT_HEADER {
    cfg.headers.push(clone_bytes(value));
    return done();
  }
  if id == OPT_FORM || id == OPT_FORM_STRING {
    cfg.forms.push(FormArg {
      literal : id == OPT_FORM_STRING,
      text : clone_bytes(value)
    });
    return done();
  }
  if id == OPT_MAX_TIME || id == OPT_CONNECT_TIMEOUT {
    match seconds_to_ms(value) {
      Option<i64>::Some(ms) => {
        if id == OPT_MAX_TIME {
          cfg.max_time_ms = ms;
        } else {
          cfg.connect_timeout_ms = ms;
        }
      },
      Option<i64>::None() => {
        return Result<i32, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
      }
    }
    return done();
  }
  if id == OPT_OUTPUT {
    let at = out_slot(cfg);
    cfg.nodes[at].has_out = true;
    cfg.nodes[at].out = clone_bytes(value);
    cfg.nodes[at].remote = false;
    return done();
  }
  if id == OPT_RANGE {
    if cfg.use_resume {
      return Result<i32, Failure>::Err(bad_use(shown, "--continue-at is mutually exclusive with --range"));
    }
    cfg.has_range = true;
    cfg.range = clone_bytes(value);
    return done();
  }
  if id == OPT_UPLOAD_FILE {
    let at = upload_slot(cfg);
    cfg.nodes[at].has_upload = true;
    cfg.nodes[at].upload = clone_bytes(value);
    if value.len() > 0 {
      cfg.has_upload = true;
    }
    return done();
  }
  if id == OPT_USER {
    cfg.has_user = true;
    cfg.user = clone_bytes(value);
    return done();
  }
  if id == OPT_WRITE_OUT {
    cfg.has_write_out = true;
    cfg.write_out = clone_bytes(value);
    return done();
  }
  if id == OPT_REQUEST {
    cfg.has_method = true;
    cfg.method = clone_bytes(value);
    return done();
  }
  if id == OPT_URL {
    add_url(cfg, value);
    return done();
  }
  if id == OPT_MAX_REDIRS {
    let neg = eq_lit(value, "-1");
    if neg {
      cfg.max_redirs = -1i64;
    } else {
      match parse_u64(value) {
        Option<u64>::Some(n) => {
          cfg.max_redirs = n as i64;
        },
        Option<u64>::None() => {
          return Result<i32, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
        }
      }
    }
    return done();
  }
  if id == OPT_RESOLVE {
    cfg.resolve.push(clone_bytes(value));
    return done();
  }
  if id == OPT_CONNECT_TO {
    cfg.connect_to.push(clone_bytes(value));
    return done();
  }
  if id == OPT_UNIX_SOCKET {
    if value.len() == 0 {
      return Result<i32, Failure>::Err(option_error(shown,
        "blank argument where content is expected"));
    }
    cfg.has_unix_socket = true;
    cfg.unix_socket = clone_bytes(value);
    return done();
  }
  if id == OPT_TRACE_ASCII || id == OPT_TRACE {
    cfg.has_trace = true;
    cfg.trace = clone_bytes(value);
    return done();
  }
  if id >= OPT_SOCKS4 && id <= OPT_SOCKS5_HOSTNAME {
    // As `-x`, with the kind of proxy for a value with no scheme. The value may not be empty.
    if value.len() == 0 {
      return Result<i32, Failure>::Err(option_error(shown,
        "blank argument where content is expected"));
    }
    cfg.proxy_set = true;
    cfg.has_proxy = true;
    cfg.proxy = clone_bytes(value);
    cfg.proxy_kind = PROXY_SOCKS5H;
    if id == OPT_SOCKS4 {
      cfg.proxy_kind = PROXY_SOCKS4;
    }
    if id == OPT_SOCKS4A {
      cfg.proxy_kind = PROXY_SOCKS4A;
    }
    if id == OPT_SOCKS5 {
      cfg.proxy_kind = PROXY_SOCKS5;
    }
    return done();
  }
  if id == OPT_PROXY {
    cfg.proxy_set = true;
    cfg.proxy_kind = PROXY_HTTP;
    cfg.has_proxy = value.len() > 0;
    cfg.proxy = clone_bytes(value);
    return done();
  }
  if id == OPT_PROXY_USER {
    cfg.has_proxy_user = true;
    cfg.proxy_user = clone_bytes(value);
    return done();
  }
  if id == OPT_NOPROXY {
    cfg.has_noproxy = true;
    cfg.noproxy = clone_bytes(value);
    return done();
  }
  if id == OPT_OUTPUT_DIR {
    cfg.has_output_dir = true;
    cfg.output_dir = clone_bytes(value);
    return done();
  }
  if id == OPT_INSECURE {
    cfg.insecure = enable;
    return done();
  }
  if id == OPT_CACERT {
    cfg.cacert = clone_bytes(value);
    return done();
  }
  if id == OPT_CAPATH {
    cfg.capath = clone_bytes(value);
    return done();
  }
  if id == OPT_PROXY_INSECURE {
    cfg.proxy_insecure = enable;
    return done();
  }
  if id == OPT_PROXY_CACERT {
    cfg.proxy_cacert = clone_bytes(value);
    return done();
  }
  if id == OPT_PROXY_CAPATH {
    cfg.proxy_capath = clone_bytes(value);
    return done();
  }
  if id == OPT_HTTP10 {
    cfg.http10 = enable;
    cfg.no_h2 = enable;
    cfg.h2_prior_knowledge = false;
    return done();
  }
  if id == OPT_HTTP11 {
    cfg.http10 = false;
    cfg.no_h2 = true;
    cfg.h2_prior_knowledge = false;
    return done();
  }
  if id == OPT_HTTP2 {
    cfg.http10 = false;
    cfg.no_h2 = false;
    cfg.h2_prior_knowledge = false;
    return done();
  }
  if id == OPT_HTTP2_PRIOR_KNOWLEDGE {
    cfg.http10 = false;
    cfg.no_h2 = false;
    cfg.h2_prior_knowledge = true;
    return done();
  }
  if id >= OPT_CERT && id <= OPT_PASS {
    if value.len() == 0 {
      return Result<i32, Failure>::Err(option_error(shown,
        "blank argument where content is expected"));
    }
    if id == OPT_CERT {
      let split = split_cert_parameter(value);
      cfg.cert = split.name;
      if split.has_password {
        cfg.has_pass = true;
        cfg.pass = split.password;
      }
    }
    if id == OPT_CERT_TYPE {
      cfg.cert_type = clone_bytes(value);
    }
    if id == OPT_KEY {
      cfg.key = clone_bytes(value);
    }
    if id == OPT_KEY_TYPE {
      cfg.key_type = clone_bytes(value);
    }
    if id == OPT_PASS {
      cfg.has_pass = true;
      cfg.pass = clone_bytes(value);
    }
    return done();
  }
  if id == OPT_PROXYTUNNEL {
    cfg.proxytunnel = enable;
    return done();
  }
  if id == OPT_TCP_NODELAY {
    cfg.tcp_nodelay = enable;
    return done();
  }
  if id == OPT_KEEPALIVE {
    cfg.keepalive = enable;
    return done();
  }
  if id == OPT_KEEPALIVE_TIME {
    cfg.keepalive_time = unsigned_arg(value, shown)?;
    return done();
  }
  if id == OPT_LIMIT_RATE {
    cfg.limit_rate = size_arg(value, shown)?;
    return done();
  }
  if id == OPT_MAX_FILESIZE {
    cfg.max_filesize = size_arg(value, shown)?;
    return done();
  }
  if id == OPT_REMOTE_HEADER_NAME {
    cfg.remote_header_name = enable;
    return done();
  }
  if id == OPT_CONTINUE_AT {
    if cfg.has_range {
      return Result<i32, Failure>::Err(bad_use(shown, "--continue-at is mutually exclusive with --range"));
    }
    if cfg.remove_on_error {
      return Result<i32, Failure>::Err(bad_use(shown,
        "--continue-at is mutually exclusive with --remove-on-error"));
    }
    if eq_lit(value, "-") {
      cfg.resume_current = true;
      cfg.resume_from = 0i64;
    } else {
      // curl's `str2offset`: digits only.
      let digits = value.len() > 0 && all_digits(value);
      match parse_u64(value) {
        Option<u64>::Some(n) => {
          if !digits || n > 9223372036854775807u64 {
            return Result<i32, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
          }
          cfg.resume_from = n as i64;
        },
        Option<u64>::None() => {
          return Result<i32, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
        }
      }
      cfg.resume_current = false;
    }
    cfg.use_resume = true;
    return done();
  }
  if id == OPT_RETRY {
    cfg.retry = unsigned_arg(value, shown)?;
    return done();
  }
  if id == OPT_RETRY_DELAY || id == OPT_RETRY_MAX_TIME {
    match seconds_to_ms(value) {
      Option<i64>::Some(ms) => {
        if id == OPT_RETRY_DELAY {
          cfg.retry_delay_ms = ms;
        } else {
          cfg.retry_max_time_ms = ms;
        }
      },
      Option<i64>::None() => {
        return Result<i32, Failure>::Err(option_error(shown, "expected a proper numerical parameter"));
      }
    }
    return done();
  }
  if id == OPT_RETRY_CONNREFUSED {
    cfg.retry_connrefused = enable;
    return done();
  }
  if id == OPT_RETRY_ALL_ERRORS {
    cfg.retry_all_errors = enable;
    return done();
  }
  if id == OPT_KEEPALIVE_CNT {
    cfg.keepalive_cnt = unsigned_arg(value, shown)?;
    return done();
  }
  if id == OPT_FAIL {
    cfg.fail = enable;
    return done();
  }
  if id == OPT_FAIL_WITH_BODY {
    cfg.fail_with_body = enable;
    return done();
  }
  if id == OPT_GET {
    cfg.get_data = enable;
    return done();
  }
  if id == OPT_INCLUDE {
    cfg.include = enable;
    return done();
  }
  if id == OPT_HEAD {
    cfg.head = enable;
    return done();
  }
  if id == OPT_LOCATION {
    cfg.follow = enable;
    return done();
  }
  if id == OPT_LOCATION_TRUSTED {
    cfg.follow = enable;
    cfg.location_trusted = enable;
    return done();
  }
  if id == OPT_REMOTE_NAME {
    // `--no-remote-name` matters only after `--remote-name-all`, as in curl.
    if enable || cfg.remote_name_all {
      let at = out_slot(cfg);
      cfg.nodes[at].has_out = true;
      cfg.nodes[at].out = Vec<u8>::new();
      cfg.nodes[at].remote = enable;
    }
    return done();
  }
  if id == OPT_REMOTE_NAME_ALL {
    cfg.remote_name_all = enable;
    return done();
  }
  if id == OPT_SILENT {
    cfg.silent = enable;
    return done();
  }
  if id == OPT_SHOW_ERROR {
    cfg.show_error = enable;
    return done();
  }
  if id == OPT_VERBOSE {
    cfg.verbose = enable;
    return done();
  }
  if id == OPT_VERSION {
    cfg.show_version = true;
    return done();
  }
  if id == OPT_HELP {
    cfg.show_help = true;
    return done();
  }
  if id == OPT_PATH_AS_IS {
    cfg.path_as_is = enable;
    return done();
  }
  if id == OPT_RAW {
    cfg.raw = enable;
    return done();
  }
  if id == OPT_FORM_ESCAPE {
    cfg.form_escape = enable;
    return done();
  }
  if id == OPT_DIGEST {
    cfg.auth_type = toggle_bit(cfg.auth_type, AUTH_DIGEST, enable);
    return done();
  }
  if id == OPT_BASIC {
    cfg.auth_type = toggle_bit(cfg.auth_type, AUTH_BASIC, enable);
    return done();
  }
  if id == OPT_ANYAUTH {
    cfg.auth_type = AUTH_ANY;
    return done();
  }
  if id == OPT_PROXY_DIGEST {
    cfg.proxy_auth_type = toggle_bit(cfg.proxy_auth_type, AUTH_DIGEST, enable);
    return done();
  }
  if id == OPT_PROXY_BASIC {
    cfg.proxy_auth_type = toggle_bit(cfg.proxy_auth_type, AUTH_BASIC, enable);
    return done();
  }
  if id == OPT_PROXY_ANYAUTH {
    cfg.proxy_auth_type = toggle_bit(cfg.proxy_auth_type, AUTH_ANY, enable);
    return done();
  }
  if id == OPT_COMPRESSED {
    cfg.compressed = enable;
    return done();
  }
  if id == OPT_TR_ENCODING {
    cfg.tr_encoding = enable;
    return done();
  }
  if id == OPT_SUPPRESS_CONNECT_HEADERS {
    cfg.suppress_connect_headers = enable;
    return done();
  }
  if id == OPT_REMOVE_ON_ERROR {
    if cfg.use_resume && enable {
      return Result<i32, Failure>::Err(bad_use(shown,
        "--continue-at is mutually exclusive with --remove-on-error"));
    }
    cfg.remove_on_error = enable;
    return done();
  }
  if id == OPT_GLOBOFF {
    cfg.globoff = enable;
    return done();
  }
  // OPT_DISABLE,
  // OPT_TRACE_TIME, OPT_PROGRESS_BAR, OPT_NO_PROGRESS_METER and OPT_NO_BUFFER change nothing
  // that securl does.
  return Result<i32, Failure>::Ok(0);
}

fn new_node(remote : bool) -> UrlNode {
  return UrlNode {
    has_url : false,
    url : Vec<u8>::new(),
    has_out : false,
    out : Vec<u8>::new(),
    remote : remote,
    has_upload : false,
    upload : Vec<u8>::new(),
    noglob : false,
    num : 0
  };
}

/// The first node with no URL, made when there is none.
fn url_slot(cfg : &mut Config) -> i32 {
  let mut i = 0;
  while i < cfg.nodes.len() {
    if !cfg.nodes.get_ref(i).has_url {
      return i;
    }
    i = i + 1;
  }
  cfg.nodes.push(new_node(cfg.remote_name_all));
  return cfg.nodes.len() - 1;
}

/// The first node with no `-o` or `-O`, made when there is none.
fn out_slot(cfg : &mut Config) -> i32 {
  let mut i = 0;
  while i < cfg.nodes.len() {
    if !cfg.nodes.get_ref(i).has_out {
      return i;
    }
    i = i + 1;
  }
  cfg.nodes.push(new_node(cfg.remote_name_all));
  return cfg.nodes.len() - 1;
}

/// The first node with no `-T`, made when there is none.
fn upload_slot(cfg : &mut Config) -> i32 {
  let mut i = 0;
  while i < cfg.nodes.len() {
    if !cfg.nodes.get_ref(i).has_upload {
      return i;
    }
    i = i + 1;
  }
  cfg.nodes.push(new_node(cfg.remote_name_all));
  return cfg.nodes.len() - 1;
}

/// Put the URL `url` in the first node that has none.
fn add_url(cfg : &mut Config, url : &Vec<u8>) -> void {
  let at = url_slot(cfg);
  cfg.nodes[at].has_url = true;
  cfg.nodes[at].url = clone_bytes(url);
}

/// Whether some node of `cfg` has a URL.
pub fn has_url(cfg : &Config) -> bool {
  for n in cfg.nodes.iter() {
    if n.has_url {
      return true;
    }
  }
  return false;
}

/// `bits` with `bit` set when `enable`, and cleared when not (curl's `togglebit`).
fn toggle_bit(bits : i32, bit : i32, enable : bool) -> i32 {
  if enable {
    return bits | bit;
  }
  return bits & (AUTH_ANY - bit);
}

// Options of curl that hold for all transfers, whichever `--next` group gives them: curl keeps
// them in its GlobalConfig. The last one given counts.
struct Globals {
  silent : bool,
  show_error : bool,
  verbose : bool,
  has_trace : bool,
  trace : Vec<u8>,
}

/// What an option asks of the caller besides the change to the configuration.
struct Step {
  // The option took the next word as its value.
  used_next : bool,
  // `--next`: the options that come after it make a new group.
  next_group : bool,
  // `-K FILE`: the caller reads FILE and gives its lines to `config_line`.
  has_config : bool,
  config_file : Vec<u8>,
  // `--stderr FILE`: the caller sends standard error to FILE from here on.
  has_stderr : bool,
  stderr_file : Vec<u8>,
  // `--url @FILE`: the caller reads the URLs of FILE, or of standard input for `-`, and gives
  // each to `add_file_url`.
  has_url_file : bool,
  url_file : Vec<u8>,
  // `-h` or `-V`: curl stops reading the command line and shows the help or the version.
  stop : bool,
}

/// Reads a command line, and the config files of `-K`, into the groups of `--next`.
struct ArgParser {
  groups : Vec<Config>,
  current : Config,
  globals : Globals,
  // After `--`, every word is a URL.
  still_flags : bool,
  show_help : bool,
  show_version : bool,
  show_manual : bool,
  // Warnings of curl about the options so far, for the caller to print.
  warnings : Vec<Vec<u8>>,
}

/// A parser with one group of the defaults of curl.
pub fn new_arg_parser() -> ArgParser {
  return ArgParser {
    groups : Vec<Config>::new(),
    current : default_config(),
    globals : Globals {
      silent : false,
      show_error : false,
      verbose : false,
      has_trace : false,
      trace : Vec<u8>::new()
    },
    still_flags : true,
    show_help : false,
    show_version : false,
    show_manual : false,
    warnings : Vec<Vec<u8>>::new()
  };
}

/// Where the reading of the command line stopped.
struct WordsStop {
  // The index of the next word to read.
  at : i32,
  // A `-K` option: the file to read before the next word, and the option as it was written.
  has_config : bool,
  config_file : Vec<u8>,
  config_option : Vec<u8>,
  // A `--stderr` option: where standard error goes from the next word on.
  has_stderr : bool,
  stderr_file : Vec<u8>,
  // A `--url @FILE` option: the file of URLs to read before the next word.
  has_url_file : bool,
  url_file : Vec<u8>,
  // The words ended, or `-h` or `-V` stopped the reading.
  finished : bool,
}

fn no_step() -> Step {
  return Step {
    used_next : false,
    next_group : false,
    has_config : false,
    config_file : Vec<u8>::new(),
    has_stderr : false,
    stderr_file : Vec<u8>::new(),
    has_url_file : false,
    url_file : Vec<u8>::new(),
    stop : false
  };
}

impl ArgParser {
  /// The warnings so far, which the caller prints. It leaves none.
  pub fn take_warnings(self : &mut ArgParser) -> Vec<Vec<u8>> {
    return replace(&mut self.warnings, Vec<Vec<u8>>::new());
  }

  /// curl's warning for a value that starts with a Unicode character such as a curly quote,
  /// which is often a mistake for an ASCII one. It does not show a password.
  fn check_unicode(self : &mut ArgParser, id : i32, value : &Vec<u8>) -> void {
    if self.globals.silent || value.len() < 3 || value.get(0) != 226u8 || value.get(1) != 128u8
       || value.get(2) < 128u8 {
      return;
    }
    let mut m = Vec<u8>::new();
    if id == OPT_USER || id == OPT_PROXY_USER || id == OPT_PASS {
      push_lit(&mut m, "The argument to --");
      if id == OPT_USER {
        push_lit(&mut m, "user");
      }
      if id == OPT_PROXY_USER {
        push_lit(&mut m, "proxy-user");
      }
      if id == OPT_PASS {
        push_lit(&mut m, "pass");
      }
      push_lit(&mut m, " starts with a Unicode character. Maybe ASCII was intended?");
    } else {
      push_lit(&mut m, "The argument '");
      append(&mut m, value);
      push_lit(&mut m, "' starts with a Unicode character. Maybe ASCII was intended?");
    }
    self.warnings.push(m);
  }

  /// Apply option `id` to the current group, and keep the global ones aside.
  fn apply_option(self : &mut ArgParser, id : i32, value : &Vec<u8>, enable : bool, shown : &Vec<u8>,
  step : &mut Step) -> Result<i32, Failure> {
    if takes_value(id) {
      self.check_unicode(id, value);
    }
    if takes_file(id) && !self.globals.silent && value.len() > 1 && value.get(0) == 45u8 {
      let mut m = lit("The filename argument '");
      append(&mut m, value);
      push_lit(&mut m, "' looks like a flag.");
      self.warnings.push(m);
    }
    if id == OPT_NEXT {
      step.next_group = true;
      return done();
    }
    if id == OPT_MANUAL {
      // securl has no built-in manual, as a curl built without one.
      self.show_manual = true;
      step.stop = true;
      return done();
    }
    if id == OPT_CONFIG {
      step.has_config = true;
      step.config_file = clone_bytes(value);
      return done();
    }
    if id == OPT_STDERR {
      step.has_stderr = true;
      step.stderr_file = clone_bytes(value);
      return done();
    }
    if id == OPT_URL && value.len() > 0 && value.get(0) == 64u8 {
      // As curl: the URLs of a file, each as with `-O` and with no globbing.
      step.has_url_file = true;
      step.url_file = rest_from(value, 1);
      return done();
    }
    let _applied = apply(&mut self.current, id, value, enable, shown)?;
    if id == OPT_SILENT {
      self.globals.silent = enable;
    }
    if id == OPT_SHOW_ERROR {
      self.globals.show_error = enable;
    }
    if id == OPT_VERBOSE {
      self.globals.verbose = enable;
    }
    if id == OPT_TRACE_ASCII || id == OPT_TRACE {
      self.globals.has_trace = true;
      self.globals.trace = clone_bytes(value);
    }
    if id == OPT_HELP {
      self.show_help = true;
      step.stop = true;
    }
    if id == OPT_VERSION {
      self.show_version = true;
      step.stop = true;
    }
    return done();
  }

  /// One option, as curl's `getparameter`: `flag` is a long option (`--name`, or `name` in a
  /// config file) or a cluster of short ones (`-sSL`), and `next` the word after it when there
  /// is one. `shown` names the option in errors.
  fn option(self : &mut ArgParser, flag : &Vec<u8>, next : &Vec<u8>, has_next : bool,
  shown : &Vec<u8>) -> Result<Step, Failure> {
    let mut step = no_step();
    let long = flag.len() == 0 || flag.get(0) != 45u8 || (flag.len() > 1 && flag.get(1) == 45u8);
    if long {
      // A long option, such as `--header` or `--no-location`. As in curl, `--name=value` gives
      // the value in the same word; a boolean option ignores it.
      let mut name = clone_bytes(flag);
      if flag.len() > 0 && flag.get(0) == 45u8 {
        name = rest_from(flag, 2);
      }
      let mut inline_value = false;
      let mut given = Vec<u8>::new();
      let eq = find_byte(&name, 61u8, 0);
      if eq >= 0 {
        inline_value = true;
        given = rest_from(&name, eq + 1);
        name = range_of(&name, 0, eq);
      }
      let mut enable = true;
      let mut id = long_option(&name);
      if id == OPT_UNKNOWN && starts_lit(&name, "no-") {
        let rest = rest_from(&name, 3);
        let base = long_option(&rest);
        if base != OPT_UNKNOWN && !takes_value(base) {
          id = base;
          enable = false;
        }
      }
      if id == OPT_UNKNOWN {
        return Result<Step, Failure>::Err(option_error(shown, "is unknown"));
      }
      let mut value = Vec<u8>::new();
      if takes_value(id) && inline_value {
        value = given;
      } else if takes_value(id) {
        if !has_next {
          return Result<Step, Failure>::Err(option_error(shown, "requires parameter"));
        }
        value = clone_bytes(next);
        step.used_next = true;
      }
      let _applied = self.apply_option(id, &value, enable, shown, &mut step)?;
      return Result<Step, Failure>::Ok(step);
    }
    // One or more short options, such as `-sSL` or `-ofile`.
    let mut j = 1;
    if flag.len() == 1 {
      return Result<Step, Failure>::Err(option_error(shown, "is unknown"));
    }
    while j < flag.len() && !step.stop {
      let letter = flag.get(j);
      let id = short_option(letter);
      let mut letter_shown = lit("-");
      letter_shown.push(letter);
      if id == OPT_UNKNOWN {
        return Result<Step, Failure>::Err(option_error(&letter_shown, "is unknown"));
      }
      if takes_value(id) {
        let mut value = Vec<u8>::new();
        if j + 1 < flag.len() {
          value = rest_from(flag, j + 1);
        } else {
          if !has_next {
            return Result<Step, Failure>::Err(option_error(&letter_shown, "requires parameter"));
          }
          value = clone_bytes(next);
          step.used_next = true;
        }
        let _applied = self.apply_option(id, &value, true, &letter_shown, &mut step)?;
        j = flag.len();
      } else {
        let none = Vec<u8>::new();
        let _applied = self.apply_option(id, &none, true, &letter_shown, &mut step)?;
        j = j + 1;
      }
    }
    return Result<Step, Failure>::Ok(step);
  }

  /// Add a URL of the file of `--url @FILE`: as with `-O`, and with no globbing.
  pub fn add_file_url(self : &mut ArgParser, url : &Vec<u8>) -> void {
    let at = url_slot(&mut self.current);
    self.current.nodes[at].has_url = true;
    self.current.nodes[at].url = clone_bytes(url);
    self.current.nodes[at].remote = true;
    self.current.nodes[at].noglob = true;
  }

  /// Start a new group after `--next`. False when the current group has no URL yet.
  fn next_group(self : &mut ArgParser) -> bool {
    if !has_url(&self.current) {
      return false;
    }
    let group = replace(&mut self.current, default_config());
    self.groups.push(group);
    return true;
  }

  /// Whether `-s` is in force so far, for the warnings while the command line is read.
  pub fn silent_now(self : &ArgParser) -> bool {
    return self.globals.silent;
  }

  /// Whether curl's error lines show so far: not with `-s`, unless `-S` brings them back.
  pub fn errors_shown(self : &ArgParser) -> bool {
    return !self.globals.silent || self.globals.show_error;
  }

  /// Read the words of the command line from `at`. It stops after a `-K` option, so that the
  /// caller reads its file, after a `--stderr` option, so that the caller opens its file, at the
  /// end of the words, and at `-h` or `-V`.
  pub fn words(self : &mut ArgParser, args : &Vec<Vec<u8>>, at : i32) -> Result<WordsStop, Failure> {
    let mut i = at;
    while i < args.len() {
      let word = args.get_ref(i);
      if self.still_flags && word.len() > 0 && word.get(0) == 45u8 {
        if eq_lit(word, "--") {
          // The end of the options: the words after it are URLs.
          self.still_flags = false;
          i = i + 1;
          continue;
        }
        let has_next = i + 1 < args.len();
        let mut next = Vec<u8>::new();
        if has_next {
          next = clone_bytes(args.get_ref(i + 1));
        }
        let step = self.option(word, &next, has_next, word)?;
        if step.next_group && !self.next_group() {
          return Result<WordsStop, Failure>::Err(fail_lit(FAILED_INIT,
            "missing URL before --next\ncurl: option --next: is badly used here"));
        }
        if step.used_next {
          i = i + 1;
        }
        i = i + 1;
        if step.stop {
          return Result<WordsStop, Failure>::Ok(words_stop(i, true));
        }
        if step.has_config {
          let mut stop = words_stop(i, false);
          stop.has_config = true;
          stop.config_file = step.config_file;
          stop.config_option = clone_bytes(word);
          return Result<WordsStop, Failure>::Ok(stop);
        }
        if step.has_stderr {
          let mut stop = words_stop(i, false);
          stop.has_stderr = true;
          stop.stderr_file = step.stderr_file;
          return Result<WordsStop, Failure>::Ok(stop);
        }
        if step.has_url_file {
          let mut stop = words_stop(i, false);
          stop.has_url_file = true;
          stop.url_file = step.url_file;
          stop.config_option = clone_bytes(word);
          return Result<WordsStop, Failure>::Ok(stop);
        }
      } else {
        add_url(&mut self.current, word);
        i = i + 1;
      }
    }
    return Result<WordsStop, Failure>::Ok(words_stop(i, true));
  }

  /// One line of a config file of `-K`, as curl's `parseconfig` gives it to `getparameter`.
  /// Gives the step, with a `-K` in it for a nested file.
  pub fn config_line(self : &mut ArgParser, line : &ConfigLine, file : &Vec<u8>)
  -> Result<Step, ConfigError> {
    match self.option(&line.option, &line.param, line.has_param, &line.option) {
      Result<Step, Failure>::Ok(step) => {
        if line.has_param && line.param.len() > 0 && !step.used_next {
          let reason = lit("had unsupported trailing garbage");
          return Result<Step, ConfigError>::Err(config_error(file, line.lineno, &line.option,
            &reason, &reason, FAILED_INIT));
        }
        if step.next_group {
          // In a config file, `next` before any URL changes nothing.
          let _started = self.next_group();
        }
        return Result<Step, ConfigError>::Ok(step);
      },
      Result<Step, Failure>::Err(f) => {
        let reason = reason_of(&f);
        let mut outer = clone_bytes(&reason);
        if eq_lit(&reason, "is unknown") {
          outer = lit("found an unknown config option");
        }
        return Result<Step, ConfigError>::Err(config_error(file, line.lineno, &line.option,
          &reason, &outer, f.code));
      }
    }
  }

  /// The groups of the command line, each with the global options.
  pub fn finish(self : &mut ArgParser) -> Vec<Config> {
    let last = replace(&mut self.current, default_config());
    self.groups.push(last);
    let mut groups = replace(&mut self.groups, Vec<Config>::new());
    // curl numbers the nodes in the order it makes them, across the groups.
    let mut num = 0;
    for g in groups.iter_mut() {
      for n in g.nodes.iter_mut() {
        n.num = num;
        num = num + 1;
      }
      g.silent = self.globals.silent;
      g.show_error = self.globals.show_error;
      g.verbose = self.globals.verbose;
      g.has_trace = self.globals.has_trace;
      g.trace = clone_bytes(&self.globals.trace);
      g.show_help = self.show_help;
      g.show_version = self.show_version;
      g.show_manual = self.show_manual;
    }
    return groups;
  }
}

fn words_stop(at : i32, finished : bool) -> WordsStop {
  return WordsStop {
    at : at,
    has_config : false,
    config_file : Vec<u8>::new(),
    config_option : Vec<u8>::new(),
    has_stderr : false,
    stderr_file : Vec<u8>::new(),
    has_url_file : false,
    url_file : Vec<u8>::new(),
    finished : finished
  };
}

/// A failure while reading a config file of `-K`: the lines that curl prints, the reason that
/// the option that read the file gives in turn, and the exit code.
struct ConfigError {
  text : Vec<u8>,
  reason : Vec<u8>,
  code : i32,
}

/// The error of the option `option` on line `lineno` of `file`, as curl prints it.
pub fn config_error(file : &Vec<u8>, lineno : i32, option : &Vec<u8>, reason : &Vec<u8>,
outer : &Vec<u8>, code : i32) -> ConfigError {
  let mut m = clone_bytes(file);
  m.push(58u8);
  push_i64(&mut m, lineno as i64);
  push_lit(&mut m, " config file option '");
  append(&mut m, option);
  push_lit(&mut m, "' ");
  append(&mut m, reason);
  return ConfigError {
    text : m,
    reason : clone_bytes(outer),
    code : code
  };
}

/// The reason of an option error "option NAME: REASON".
fn reason_of(f : &Failure) -> Vec<u8> {
  let at = find_seq(&f.message, &lit(": "), 0);
  if starts_lit(&f.message, "option ") && at >= 0 {
    return rest_from(&f.message, at + 2);
  }
  return clone_bytes(&f.message);
}

/// One option of a config file: its name as written (`url`, `--url` or `-o`), and its value,
/// which may be missing. `warning` is a warning of curl about the line, or empty.
struct ConfigLine {
  lineno : i32,
  option : Vec<u8>,
  has_param : bool,
  param : Vec<u8>,
  warning : Vec<u8>,
}

fn is_space(b : u8) -> bool {
  return b == 32u8 || (b >= 9u8 && b <= 13u8);
}

/// The options of the config file `text`, named `file` in warnings, as curl's `parseconfig`
/// reads them: one option on a line, a `#` line is a comment, a name without a dash may have
/// `=` or `:` before its value, and a value in double quotes takes backslash escapes.
pub fn config_lines(text : &Vec<u8>, file : &Vec<u8>) -> Vec<ConfigLine> {
  let mut out = Vec<ConfigLine>::new();
  let mut start = 0;
  let mut lineno = 0;
  while start < text.len() {
    let mut end = find_byte(text, 10u8, start);
    if end < 0 {
      end = text.len();
    }
    let line = range_of(text, start, end);
    start = end + 1;
    lineno = lineno + 1;
    let mut i = 0;
    while i < line.len() && is_space(line.get(i)) {
      i = i + 1;
    }
    if i >= line.len() || line.get(i) == 35u8 {
      continue;
    }
    let dashed = line.get(i) == 45u8;
    let opt_start = i;
    while i < line.len() && !is_space(line.get(i))
          && !(!dashed && (line.get(i) == 61u8 || line.get(i) == 58u8)) {
      i = i + 1;
    }
    let option = range_of(&line, opt_start, i);
    if i < line.len() {
      i = i + 1;
    }
    while i < line.len() && (line.get(i) == 32u8 || line.get(i) == 9u8
          || (!dashed && (line.get(i) == 61u8 || line.get(i) == 58u8))) {
      i = i + 1;
    }
    let mut param = Vec<u8>::new();
    let mut has_param = false;
    let mut warning = Vec<u8>::new();
    if i < line.len() && line.get(i) == 34u8 {
      // A quoted value, up to the next quote that no backslash escapes.
      has_param = true;
      i = i + 1;
      while i < line.len() && line.get(i) != 34u8 {
        let mut b = line.get(i);
        if b == 92u8 {
          i = i + 1;
          if i >= line.len() {
            break;
          }
          b = line.get(i);
          if b == 116u8 {
            b = 9u8;
          }
          if b == 110u8 {
            b = 10u8;
          }
          if b == 114u8 {
            b = 13u8;
          }
          if b == 118u8 {
            b = 11u8;
          }
        }
        param.push(b);
        i = i + 1;
      }
    } else {
      let mut quote_warning = false;
      if i < line.len() && line.get(i) == 39u8 {
        quote_warning = true;
      }
      let p_start = i;
      while i < line.len() && !is_space(line.get(i)) {
        i = i + 1;
      }
      param = range_of(&line, p_start, i);
      has_param = param.len() > 0;
      let mut k = i;
      if k < line.len() {
        k = k + 1;
      }
      while k < line.len() && (line.get(k) == 32u8 || line.get(k) == 9u8) {
        k = k + 1;
      }
      let mut trailing = false;
      if k < line.len() {
        let c = line.get(k);
        trailing = c != 13u8 && c != 35u8;
      }
      if quote_warning {
        warning = config_warning(file, lineno, &option,
          "uses argument with leading single quote. It is probably a mistake. Consider double quotes.");
      }
      if trailing {
        warning = config_warning(file, lineno, &option,
          "uses argument with unquoted whitespace. This may cause side-effects. Consider double quotes.");
      }
    }
    out.push(ConfigLine {
      lineno : lineno,
      option : option,
      has_param : has_param,
      param : param,
      warning : warning
    });
  }
  return out;
}

fn config_warning(file : &Vec<u8>, lineno : i32, option : &Vec<u8>, what : *const i8) -> Vec<u8> {
  let mut m = clone_bytes(file);
  m.push(58u8);
  push_i64(&mut m, lineno as i64);
  push_lit(&mut m, " Option '");
  append(&mut m, option);
  push_lit(&mut m, "' ");
  push_lit(&mut m, what);
  return m;
}

/// Parse a command line with no `-K`, without the program name, into its first group. For the
/// unit tests.
pub fn parse_args(args : &Vec<Vec<u8>>) -> Result<Config, Failure> {
  let mut p = new_arg_parser();
  let stop = p.words(args, 0)?;
  if stop.has_config {
    return Result<Config, Failure>::Err(fail_lit(FAILED_INIT, "-K needs the tool"));
  }
  let mut groups = p.finish();
  if groups.len() != 1 {
    return Result<Config, Failure>::Err(fail_lit(FAILED_INIT, "--next needs the tool"));
  }
  match groups.pop() {
    Option<Config>::Some(c) => {
      return Result<Config, Failure>::Ok(c);
    },
    Option<Config>::None() => {
      return Result<Config, Failure>::Err(fail_lit(FAILED_INIT, "no group"));
    }
  }
}
