// libFuzzer target: the Strict-Transport-Security header and the HSTS cache file, securl::hsts. tools/build-fuzzers.sh builds it, and `make fuzz` runs it.
// A panic, which stops the program, is a crash for libFuzzer.
import core::option;
import std::vec;
import sys::text;
import securl::hsts;

/// The input of libFuzzer as bytes.
fn input_of(data : *const u8, len : i64) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  let mut i = 0i64;
  while i < len {
    bytes.push(unsafe { data[i] });
    i = i + 1i64;
  }
  return bytes;
}

extern fn vx_fuzz_one(data : *const u8, len : i64) -> i32 {
  let input = input_of(data, len);
  let mut h = new_hsts(true);
  let _header = hsts_header(&mut h, &lit("example.com"), &input);
  let _loaded = load_hsts_text(&mut h, &input);
  let _applies = hsts_applies(&mut h, &lit("www.example.com"));
  let _text = hsts_text(&h);
  return 0;
}
