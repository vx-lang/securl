  t.push(0i64);
  t.push(0i64);
  t.push(10i64);
  t.push(20i64);
  t.push(10i64);
  t.push(26i64);
  t.push(92i64);
  t.push(36i64);
  t.push(32i64);
  t.push(248i64);
