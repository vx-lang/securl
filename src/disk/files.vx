// The files that securl reads and writes. Each function takes the right to open files, a
// `&Files`, which only `main` and `cli::tool` have. The `securl` package never gets it.
import core::option;
import core::result;
import std::fs;
import std::io;
import std::string;
import std::vec;
import sys::text;
import securl::bytes;
import securl::failure;

fn path_string(name : &Vec<u8>) -> Option<String> {
  return to_string(name);
}

/// Whether a file or a folder has the path `name`, as curl's `stat` check of `--cacert` asks. A
/// file that the program may not read exists too.
pub fn file_exists(files : &Files, name : &Vec<u8>) -> bool {
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, OpenMode::Read()) {
        Result<File, FileError>::Ok(_f) => {
          return true;
        },
        Result<File, FileError>::Err(e) => {
          match e {
            FileError::NotFound() => {
              return false;
            },
            FileError::BadPath() => {
              return false;
            },
            _ => {
              return true;
            }
          }
        }
      }
    },
    Option<String>::None() => {
      return false;
    }
  }
}

/// All bytes of the file `name`. `-` means standard input, which `stdin` gives the right to
/// read.
pub fn read_file(files : &Files, stdin : &mut Stdin, name : &Vec<u8>) -> Result<Vec<u8>, Failure> {
  if eq_lit(name, "-") {
    return Result<Vec<u8>, Failure>::Ok(read_stdin(stdin));
  }
  return read_path(files, name);
}

/// All of standard input, until its end. A read error ends it too, as for curl.
fn read_stdin(stdin : &mut Stdin) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  let mut chunk = Vec<u8>::with_capacity(16384);
  while chunk.len() < 16384 {
    chunk.push(0u8);
  }
  loop {
    match stdin.read(&mut chunk) {
      Result<u64, StdioError>::Ok(n) => {
        if n == 0u64 {
          break;
        }
        let mut i = 0;
        while i < (n as i32) {
          out.push(chunk.get(i));
          i = i + 1;
        }
      },
      Result<u64, StdioError>::Err(_e) => {
        break;
      }
    }
  }
  return out;
}

/// All bytes of the file `name`, where `-` is a file too.
pub fn read_path(files : &Files, name : &Vec<u8>) -> Result<Vec<u8>, Failure> {
  let failure = fail_lit(READ_ERROR, "Failed to open/read local data from file/application");
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, OpenMode::Read()) {
        Result<File, FileError>::Ok(f) => {
          let mut file = f;
          let mut out = Vec<u8>::new();
          let mut chunk = Vec<u8>::new();
          let mut i = 0;
          while i < 65536 {
            chunk.push(0u8);
            i = i + 1;
          }
          loop {
            match file.read(&mut chunk) {
              Result<u64, FileError>::Ok(n) => {
                if n == 0u64 {
                  return Result<Vec<u8>, Failure>::Ok(out);
                }
                append_range(&mut out, &chunk, 0, n as i32);
              },
              Result<u64, FileError>::Err(_e) => {
                return Result<Vec<u8>, Failure>::Err(failure);
              }
            }
          }
        },
        Result<File, FileError>::Err(_e) => {
          return Result<Vec<u8>, Failure>::Err(failure);
        }
      }
    },
    Option<String>::None() => {
      return Result<Vec<u8>, Failure>::Err(failure);
    }
  }
}

/// Why the file `name` does not open for reading, as the C library's `strerror` says it, for
/// curl's "Failed to open" warnings. Empty when it opens.
pub fn open_error_text(files : &Files, name : &Vec<u8>) -> Vec<u8> {
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, OpenMode::Read()) {
        Result<File, FileError>::Ok(_f) => {
          return Vec<u8>::new();
        },
        Result<File, FileError>::Err(e) => {
          match e {
            FileError::NotFound() => {
              return lit("No such file or directory");
            },
            FileError::PermissionDenied() => {
              return lit("Permission denied");
            },
            FileError::Os(code) => {
              if code == 21 {
                return lit("Is a directory");
              }
              let mut m = lit("Unknown error ");
              push_i64(&mut m, code as i64);
              return m;
            },
            _ => {
              return lit("Invalid argument");
            }
          }
        }
      }
    },
    Option<String>::None() => {
      return lit("Invalid argument");
    }
  }
}

/// Make the file `name`, or make an existing one empty, for writing.
pub fn create_file(files : &Files, name : &Vec<u8>) -> Result<File, Failure> {
  let mut m = lit("Failed to open the file ");
  append(&mut m, name);
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, OpenMode::Write()) {
        Result<File, FileError>::Ok(f) => {
          return Result<File, Failure>::Ok(f);
        },
        Result<File, FileError>::Err(_e) => {
          return Result<File, Failure>::Err(fail_with(WRITE_ERROR, m));
        }
      }
    },
    Option<String>::None() => {
      return Result<File, Failure>::Err(fail_with(WRITE_ERROR, m));
    }
  }
}

/// The size of the file `name` in bytes, or -1 when it cannot be opened.
pub fn file_size(files : &Files, name : &Vec<u8>) -> i64 {
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, OpenMode::Read()) {
        Result<File, FileError>::Ok(f) => {
          let mut file = f;
          let end = file.seek(0i64, 2);
          if end < 0i64 {
            return -1i64;
          }
          return end;
        },
        Result<File, FileError>::Err(_e) => {
          return -1i64;
        }
      }
    },
    Option<String>::None() => {
      return -1i64;
    }
  }
}

/// Open the file `name` to write after the bytes that it has, or make it.
pub fn open_to_append(files : &Files, name : &Vec<u8>) -> Result<File, Failure> {
  let mut m = lit("Failed to open the file ");
  append(&mut m, name);
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, OpenMode::ReadWriteCreate()) {
        Result<File, FileError>::Ok(f) => {
          let mut file = f;
          let _end = file.seek(0i64, 2);
          return Result<File, Failure>::Ok(file);
        },
        Result<File, FileError>::Err(_e) => {
          return Result<File, Failure>::Err(fail_with(WRITE_ERROR, m));
        }
      }
    },
    Option<String>::None() => {
      return Result<File, Failure>::Err(fail_with(WRITE_ERROR, m));
    }
  }
}

/// Write `bytes` to the file `name`. With `add`, they go after the bytes the file has, and else
/// the file starts empty.
pub fn append_to_file(files : &Files, name : &Vec<u8>, add : bool, bytes : &Vec<u8>)
-> Result<i32, Failure> {
  let failure = fail_lit(WRITE_ERROR, "Failure writing output to destination");
  let mut mode = OpenMode::Write();
  if add {
    mode = OpenMode::ReadWriteCreate();
  }
  match path_string(name) {
    Option<String>::Some(path) => {
      match File::open(files, &path, mode) {
        Result<File, FileError>::Ok(f) => {
          let mut file = f;
          if add {
            let _end = file.seek(0i64, 2);
          }
          match file.write(bytes) {
            Result<u64, FileError>::Ok(_n) => {
              return Result<i32, Failure>::Ok(0);
            },
            Result<u64, FileError>::Err(_e) => {
              return Result<i32, Failure>::Err(failure);
            }
          }
        },
        Result<File, FileError>::Err(_e) => {
          return Result<i32, Failure>::Err(failure);
        }
      }
    },
    Option<String>::None() => {
      return Result<i32, Failure>::Err(failure);
    }
  }
}

/// Whether `name` is a regular file, after symbolic links, as curl's `stat` and `S_ISREG` check
/// before it removes an output file. A device such as `/dev/null` is not one.
pub fn is_regular_file(files : &Files, name : &Vec<u8>) -> bool {
  match path_string(name) {
    Option<String>::Some(path) => {
      match file_kind(files, &path) {
        Result<FileKind, FileError>::Ok(kind) => {
          match kind {
            FileKind::Regular() => {
              return true;
            },
            _ => {
              return false;
            }
          }
        },
        Result<FileKind, FileError>::Err(_e) => {
          return false;
        }
      }
    },
    Option<String>::None() => {
      return false;
    }
  }
}

/// Remove the file `name`. False when the system says no.
pub fn delete_file(files : &Files, name : &Vec<u8>) -> bool {
  match path_string(name) {
    Option<String>::Some(path) => {
      match remove_file(files, &path) {
        Result<i32, FileError>::Ok(_n) => {
          return true;
        },
        Result<i32, FileError>::Err(_e) => {
          return false;
        }
      }
    },
    Option<String>::None() => {
      return false;
    }
  }
}
