// The command-line arguments and the environment variables of the program, as byte lists.
//
// TRUSTED CODE. `fn main(root : Root, args : Vec<String>)` gives the arguments as `String`
// values, and `Environment::var` gives a variable as a `String`. But `std` has no safe way yet
// to read the bytes of a `String`, and securl parses bytes, as curl does. So this file reads
// the arguments from the Rust core, and the bytes of a variable through the pointer of its
// `String`. An argument that is not UTF-8 stops the program in the Rust core, before `main`.
import core::ptr;
import core::result;
import std::env;
import std::string;
import std::vec;
import sys::text;

extern {
  fn vx_env_args_count() -> i32;
  fn vx_env_arg(idx : i32) -> *const i8;
}

/// The command-line arguments without the program name. Each argument is a list of bytes.
pub fn args() -> Vec<Vec<u8>> {
  let mut out = Vec<Vec<u8>>::new();
  let count = unsafe { vx_env_args_count() };
  let mut i = 1;
  while i < count {
    // The Rust core gives a NUL-terminated copy that stays valid. It never frees the copy.
    let p = unsafe { vx_env_arg(i) };
    let mut arg = Vec<u8>::new();
    let mut j : i64 = 0i64;
    loop {
      let b = unsafe { p[j] } as u8;
      if b == 0u8 {
        break;
      }
      arg.push(b);
      j = j + 1i64;
    }
    out.push(arg);
    i = i + 1;
  }
  return out;
}

/// The bytes of `s`.
fn bytes_of(s : &String) -> Vec<u8> {
  let n = s.len();
  // The Rust core keeps the `n` bytes of the text at this pointer while `s` lives.
  let p = unsafe { vx_string_as_mut_ptr(s.ptr) } as *const i8;
  let mut out = Vec<u8>::with_capacity(n);
  let mut i = 0;
  while i < n {
    out.push(unsafe { p[i] } as u8);
    i = i + 1;
  }
  return out;
}

/// The value of the environment variable `name`, a string literal. Gives an empty list when the
/// variable is not set, is empty, or is not UTF-8. curl takes an empty variable as one that is
/// not set too.
pub fn env_var(env : &Environment, name : *const i8) -> Vec<u8> {
  match String::from_utf8(&lit(name)) {
    Result<String, Utf8Error>::Ok(key) => {
      match env.var(&key) {
        Result<String, EnvError>::Ok(value) => {
          return bytes_of(&value);
        },
        Result<String, EnvError>::Err(_e) => {
          return Vec<u8>::new();
        }
      }
    },
    Result<String, Utf8Error>::Err(_e) => {
      return Vec<u8>::new();
    }
  }
}
