// libFuzzer target: the lines of a response head: the status line and the header lines, folded and checked as securl::http reads them. tools/build-fuzzers.sh builds it, and `make fuzz` runs it.
// A panic, which stops the program, is a crash for libFuzzer.
import core::option;
import core::result;
import std::vec;
import sys::text;
import securl::bytes;
import securl::http;

/// The input of libFuzzer as bytes.
fn input_of(data : *const u8, len : i64) -> Vec<u8> {
  let mut bytes = Vec<u8>::new();
  let mut i = 0i64;
  while i < len {
    bytes.push(unsafe { data[i] });
    i = i + 1i64;
  }
  return bytes;
}

extern fn vx_fuzz_one(data : *const u8, len : i64) -> i32 {
  let input = input_of(data, len);
  let mut head = empty_head();
  let mut start = 0;
  let mut index = 0;
  let mut pending = Vec<u8>::new();
  while start < input.len() && head.error_code == 0 {
    let mut end = find_byte(&input, 10u8, start);
    if end < 0 {
      end = input.len() - 1;
    }
    let line = range_of(&input, start, end + 1);
    start = end + 1;
    index = index + 1;
    if index == 1 {
      if !parse_status_line(&line, &mut head) {
        return 0;
      }
      let _clean = line_is_clean(&line, &mut head);
    } else {
      if pending.len() > 0 && line.len() > 0 && is_blank(line.get(0)) {
        pending = unfold(&pending, &line);
      } else {
        if pending.len() > 0 {
          parse_header_line(&pending, index, false, &mut head);
        }
        pending = line;
      }
    }
  }
  if pending.len() > 0 && head.error_code == 0 {
    parse_header_line(&pending, index, true, &mut head);
  }
  return 0;
}
