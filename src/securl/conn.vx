// A connection with a read buffer, for reading a response line by line and then its body. The
// connection is plain TCP, or TLS after `start_tls`.
import core::option;
import core::result;
import std::net;
import std::string;
import std::time;
import std::vec;
import sys::socket;
import sys::text;
import sys::tls;
import securl::bytes;
import securl::failure;

const READ_BUFFER_SIZE : i32 = 16384;

struct Conn {
  stream : NetStream,
  buffer : Vec<u8>,
  // The next byte of `buffer` to give.
  start : i32,
  // The end of the bytes in `buffer` that are not given yet.
  end : i32,
  // The peer closed the connection.
  closed : bool,
}

/// The options that curl sets on each socket, in the order that libcurl sets them.
struct SocketOptions {
  // TCP_NODELAY.
  nodelay : bool,
  // TCP keepalive, with the seconds before the first probe and between probes, and the
  // probes with no answer before the system drops the connection.
  keepalive : bool,
  idle : i32,
  interval : i32,
  count : i32,
}

/// The failure of curl for a TLS or socket error.
fn failure_of(e : TlsError) -> Failure {
  return fail_with(e.code, e.message);
}

/// Connect to `address`, written as `host:port`, and set the socket options `options`. `host`
/// and `port` are for the messages. The connect, and each wait of the connection after it, give
/// up at `deadline`, which `Instant::never()` turns off. The caller needs the network right.
pub fn open_conn(network : &Network, address : &Vec<u8>, host : &Vec<u8>, port : i32,
deadline : Instant, options : &SocketOptions) -> Result<Conn, Failure> {
  let mut target = String::new();
  match to_string(address) {
    Option<String>::Some(s) => {
      target = s;
    },
    Option<String>::None() => {
      return Result<Conn, Failure>::Err(fail_lit(URL_MALFORMAT,
        "URL rejected: Malformed input to a URL function"));
    }
  }
  match connect_by(network, &target, deadline) {
    Result<TcpStream, NetError>::Ok(stream) => {
      if options.nodelay {
        set_nodelay(&stream);
      }
      if options.keepalive {
        set_keepalive(&stream, options.idle, options.interval, options.count);
      }
      let mut buffer = Vec<u8>::new();
      let mut i = 0;
      while i < READ_BUFFER_SIZE {
        buffer.push(0u8);
        i = i + 1;
      }
      let mut net = NetStream::plain(stream);
      net.set_deadline(deadline);
      return Result<Conn, Failure>::Ok(Conn {
        stream : net,
        buffer : buffer,
        start : 0,
        end : 0,
        closed : false
      });
    },
    Result<TcpStream, NetError>::Err(e) => {
      match e {
        NetError::BadAddress() => {
          let mut m = lit("Could not resolve host: ");
          append(&mut m, host);
          return Result<Conn, Failure>::Err(fail_with(COULDNT_RESOLVE_HOST, m));
        },
        NetError::Cancelled() => {
          // The time limit of the caller ended the wait. The caller words the message.
          return Result<Conn, Failure>::Err(fail_lit(OPERATION_TIMEDOUT, "Operation timed out"));
        },
        _ => {
          let mut m = lit("Failed to connect to ");
          append(&mut m, host);
          push_lit(&mut m, " port ");
          push_u64(&mut m, port as u64);
          push_lit(&mut m, ": Could not connect to server");
          return Result<Conn, Failure>::Err(fail_with(COULDNT_CONNECT, m));
        }
      }
    }
  }
}

impl Conn {
  /// Whether TLS chose HTTP/2 for the connection.
  pub fn is_h2(self : &Conn) -> bool {
    return self.stream.is_h2();
  }

  /// Make each wait of the connection from now on give up at `at`.
  pub fn set_deadline(self : &mut Conn, at : Instant) -> void {
    self.stream.set_deadline(at);
  }

  /// Send all of `bytes`.
  pub fn send(self : &mut Conn, bytes : &Vec<u8>) -> Result<i32, Failure> {
    if bytes.len() == 0 {
      return Result<i32, Failure>::Ok(0);
    }
    match self.stream.write_all(bytes) {
      Result<u64, TlsError>::Ok(_n) => {
        return Result<i32, Failure>::Ok(0);
      },
      Result<u64, TlsError>::Err(e) => {
        return Result<i32, Failure>::Err(failure_of(e));
      }
    }
  }

  /// Start TLS for the server `host`, and offer HTTP/2 with ALPN when `offer_h2`. A response
  /// must not be half read.
  pub fn start_tls(self : &mut Conn, config : &TlsConfig, host : &Vec<u8>, host_is_ip : bool,
  offer_h2 : bool) -> Result<i32, Failure> {
    assert(self.start == self.end, "start_tls with bytes in the read buffer");
    match self.stream.start_tls(config, host, host_is_ip, offer_h2) {
      Result<i32, TlsError>::Ok(_v) => {
        return Result<i32, Failure>::Ok(0);
      },
      Result<i32, TlsError>::Err(e) => {
        return Result<i32, Failure>::Err(failure_of(e));
      }
    }
  }

  /// Read more bytes into the empty buffer. Gives false when the peer closed the connection.
  fn fill(self : &mut Conn) -> Result<bool, Failure> {
    if self.closed {
      return Result<bool, Failure>::Ok(false);
    }
    match self.stream.read(&mut self.buffer) {
      Result<u64, TlsError>::Ok(n) => {
        if n == 0u64 {
          self.closed = true;
          return Result<bool, Failure>::Ok(false);
        }
        self.start = 0;
        self.end = n as i32;
        return Result<bool, Failure>::Ok(true);
      },
      Result<u64, TlsError>::Err(e) => {
        return Result<bool, Failure>::Err(failure_of(e));
      }
    }
  }

  /// Add the next line, with its `\n`, to the end of `line`, and give how many bytes it added.
  /// The last line before the peer closes can have no `\n`. 0 means that the peer closed the
  /// connection first. A line longer than `max` bytes fails with `code` and `message` as soon
  /// as it passes `max`, so that a peer that never sends a `\n` cannot fill the memory.
  pub fn read_line(self : &mut Conn, line : &mut Vec<u8>, max : i32, code : i32,
  message : *const i8) -> Result<i32, Failure> {
    let mut count = 0;
    loop {
      if self.start == self.end {
        let more = self.fill()?;
        if !more {
          return Result<i32, Failure>::Ok(count);
        }
      }
      let mut stop = self.start;
      let mut found = false;
      while stop < self.end && !found {
        found = self.buffer.get(stop) == 10u8;
        stop = stop + 1;
      }
      append_range(line, &self.buffer, self.start, stop);
      count = count + (stop - self.start);
      self.start = stop;
      if count > max {
        return Result<i32, Failure>::Err(fail_lit(code, message));
      }
      if found {
        return Result<i32, Failure>::Ok(count);
      }
    }
  }

  /// Give up to `max` bytes, the buffered ones first. An empty result means that the peer
  /// closed the connection.
  pub fn read_some(self : &mut Conn, max : i64) -> Result<Vec<u8>, Failure> {
    if self.start == self.end {
      let more = self.fill()?;
      if !more {
        return Result<Vec<u8>, Failure>::Ok(Vec<u8>::new());
      }
    }
    let mut stop = self.end;
    if ((stop - self.start) as i64) > max {
      stop = self.start + (max as i32);
    }
    let out = range_of(&self.buffer, self.start, stop);
    self.start = stop;
    return Result<Vec<u8>, Failure>::Ok(out);
  }
}
