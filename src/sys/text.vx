// String literals as byte lists.
//
// TRUSTED CODE. A Vx string literal is a `*const i8` that ends in a NUL byte, and a function
// that gets one as a parameter does not get its length (Vx#532). So `lit` reads the bytes in an
// `unsafe` block, up to the NUL. That is correct for a string literal. It is not correct for any
// other pointer, and nothing checks that yet. Pass only string literals to `lit` and `push_lit`.
import std::vec;

/// The bytes of the string literal `s`, without its NUL.
pub fn lit(s : *const i8) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  let mut i = 0;
  let mut b = unsafe { s[0] };
  while b != 0i8 {
    out.push(b as u8);
    i = i + 1;
    b = unsafe { s[i] };
  }
  return out;
}

/// Add the bytes of the string literal `s` to the end of `dst`.
pub fn push_lit(dst : &mut Vec<u8>, s : *const i8) -> void {
  let bytes = lit(s);
  for b in bytes.iter() {
    dst.push(*b);
  }
}
