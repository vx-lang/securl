// The command-line arguments of the program.
//
// TRUSTED CODE. The Rust core of the Vx runtime has the arguments, but `std` has no safe
// wrapper for them yet. Vx PR #3975 adds `root.args`. When it merges, delete this file and
// read the arguments from `root.args` in `main`.
import core::ptr;
import std::vec;

extern {
  fn vx_env_args_count() -> i32;
  fn vx_env_arg(idx : i32) -> *const i8;
}

/// The command-line arguments without the program name. Each argument is a list of bytes.
pub fn args() -> Vec<Vec<u8>> {
  let mut out = Vec<Vec<u8>>::new();
  let count = unsafe { vx_env_args_count() };
  let mut i = 1;
  while i < count {
    // The Rust core gives a NUL-terminated copy that stays valid. It never frees the copy.
    let p = unsafe { vx_env_arg(i) };
    let mut arg = Vec<u8>::new();
    let mut j : i64 = 0i64;
    loop {
      let b = unsafe { p[j] } as u8;
      if b == 0u8 {
        break;
      }
      arg.push(b);
      j = j + 1i64;
    }
    out.push(arg);
    i = i + 1;
  }
  return out;
}
