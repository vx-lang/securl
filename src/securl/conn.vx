// A connection with a read buffer, for reading a response line by line and then its body. The
// connection is plain TCP or a Unix-domain socket, or TLS over one after `start_tls`.
import core::option;
import core::result;
import core::time;
import std::net;
import std::string;
import std::sync::wait;
import std::time;
import std::vec;
import sys::socket;
import sys::text;
import sys::tls;
import securl::bytes;
import securl::failure;

const READ_BUFFER_SIZE : i32 = 16384;

struct Conn {
  stream : NetStream,
  buffer : Vec<u8>,
  // The next byte of `buffer` to give.
  start : i32,
  // The end of the bytes in `buffer` that are not given yet.
  end : i32,
  // The peer closed the connection.
  closed : bool,
  // Each wait gives up at this time.
  deadline : Instant,
  // `--limit-rate`, for the bytes that arrive and for those that go.
  recv_limit : RateLimit,
  send_limit : RateLimit,
}

/// A limit of bytes per second for one direction of a connection.
struct RateLimit {
  // Bytes per second, or 0 for no limit.
  rate : i64,
  // When the limit started, and how many bytes went since.
  started : Instant,
  count : i64,
}

fn no_limit() -> RateLimit {
  return RateLimit {
    rate : 0i64,
    started : Instant::now(),
    count : 0i64
  };
}

/// Count `n` more bytes of `limit`, and wait until its rate allows them, but not past
/// `deadline`. Over the whole transfer, the bytes then go no faster than the rate.
fn pace(limit : &mut RateLimit, n : i64, deadline : Instant) -> void {
  if limit.rate <= 0i64 {
    return;
  }
  limit.count = limit.count + n;
  let due_ms = limit.count / limit.rate * 1000i64 + (limit.count % limit.rate) * 1000i64 / limit.rate;
  match limit.started.checked_add(&Duration::from_millis(due_ms as u64)) {
    Option<Instant>::Some(due) => {
      let mut until = due;
      if deadline < until {
        until = deadline;
      }
      if Instant::now() < until {
        let _slept = sleep_until(until);
      }
      return;
    },
    Option<Instant>::None() => {}
  }
}

/// The options that curl sets on each socket, in the order that libcurl sets them.
struct SocketOptions {
  // TCP_NODELAY.
  nodelay : bool,
  // TCP keepalive, with the seconds before the first probe and between probes, and the
  // probes with no answer before the system drops the connection.
  keepalive : bool,
  idle : i32,
  interval : i32,
  count : i32,
}

/// Connect to `address`, written as `host:port`, and give up at `deadline`.
pub fn connect_by(network : &Network, address : &String, deadline : Instant)
-> Result<TcpStream, NetError> {
  if deadline == Instant::never() {
    return TcpStream::connect(network, address);
  }
  if past_deadline(deadline) {
    return Result<TcpStream, NetError>::Err(NetError::Cancelled);
  }
  return within(deadline - Instant::now(), || -> Result<TcpStream, NetError> {
    return TcpStream::connect(network, address);
  });
}

/// The failure of curl for a TLS or socket error.
fn failure_of(e : TlsError) -> Failure {
  return fail_with(e.code, e.message);
}

/// What the messages of a connect that failed name, as curl 8.23 does.
struct ConnNames {
  // The host of `address` before its lookup, and whether it is a proxy, for "Could not resolve
  // host: NAME" or "Could not resolve proxy: NAME".
  host : Vec<u8>,
  is_proxy : bool,
  // The text after "Failed to connect to ", such as `example.com:443 over proxy 10.0.0.1`.
  label : Vec<u8>,
}

/// Connect to `address`, written as `host:port`, and set the socket options `options`. `names`
/// are for the messages. The connect, and each wait of the connection after it, give up at
/// `deadline`, which `Instant::never()` turns off. The caller needs the network right.
pub fn open_conn(network : &Network, address : &Vec<u8>, names : &ConnNames,
deadline : Instant, options : &SocketOptions) -> Result<Conn, Failure> {
  let started = Instant::now();
  let mut target = String::new();
  match to_string(address) {
    Option<String>::Some(s) => {
      target = s;
    },
    Option<String>::None() => {
      return Result<Conn, Failure>::Err(fail_lit(URL_MALFORMAT,
        "URL rejected: Malformed input to a URL function"));
    }
  }
  match connect_by(network, &target, deadline) {
    Result<TcpStream, NetError>::Ok(stream) => {
      if options.nodelay {
        set_nodelay(&stream);
      }
      if options.keepalive {
        set_keepalive(&stream, options.idle, options.interval, options.count);
      }
      return Result<Conn, Failure>::Ok(conn_of(NetStream::plain(stream), deadline));
    },
    Result<TcpStream, NetError>::Err(e) => {
      match e {
        NetError::BadAddress() => {
          if names.is_proxy {
            let mut m = lit("Could not resolve proxy: ");
            append(&mut m, &names.host);
            return Result<Conn, Failure>::Err(fail_with(COULDNT_RESOLVE_PROXY, m));
          }
          let mut m = lit("Could not resolve host: ");
          append(&mut m, &names.host);
          return Result<Conn, Failure>::Err(fail_with(COULDNT_RESOLVE_HOST, m));
        },
        NetError::Cancelled() => {
          // The time limit of the caller ended the wait. The caller words the message.
          return Result<Conn, Failure>::Err(fail_lit(OPERATION_TIMEDOUT, "Operation timed out"));
        },
        NetError::Refused() => {
          let mut f = fail_with(COULDNT_CONNECT, connect_failure(names, &started));
          f.refused = true;
          return Result<Conn, Failure>::Err(f);
        },
        _ => {
          return Result<Conn, Failure>::Err(fail_with(COULDNT_CONNECT,
            connect_failure(names, &started)));
        }
      }
    }
  }
}

/// The longest path of a Unix-domain socket: `sun_path` holds 108 bytes with the NUL.
const UNIX_PATH_MAX : i32 = 107;

/// Connect to the Unix-domain socket at `path`, for `--unix-socket`. `names` are for the
/// message of a connect that fails. The connect, and each wait of the connection after it,
/// give up at `deadline`. The caller needs the network right.
pub fn open_unix_conn(network : &Network, path : &Vec<u8>, names : &ConnNames,
deadline : Instant) -> Result<Conn, Failure> {
  let started = Instant::now();
  if path.len() > UNIX_PATH_MAX {
    // curl's check, before it tries to connect.
    let mut m = lit("Unix socket path too long: '");
    append(&mut m, path);
    push_lit(&mut m, "'");
    return Result<Conn, Failure>::Err(fail_with(COULDNT_RESOLVE_HOST, m));
  }
  let text = to_string(path);
  let mut target = String::new();
  match text {
    Option<String>::Some(s) => {
      target = s;
    },
    Option<String>::None() => {
      // A path that is not UTF-8 cannot become a `String`.
      return Result<Conn, Failure>::Err(fail_with(COULDNT_CONNECT,
        connect_failure(names, &started)));
    }
  }
  let connected = unix_connect_by(network, &target, deadline);
  match connected {
    Result<UnixStream, NetError>::Ok(stream) => {
      return Result<Conn, Failure>::Ok(conn_of(NetStream::unix(stream), deadline));
    },
    Result<UnixStream, NetError>::Err(e) => {
      match e {
        NetError::Cancelled() => {
          return Result<Conn, Failure>::Err(fail_lit(OPERATION_TIMEDOUT, "Operation timed out"));
        },
        NetError::Refused() => {
          let mut f = fail_with(COULDNT_CONNECT, connect_failure(names, &started));
          f.refused = true;
          return Result<Conn, Failure>::Err(f);
        },
        _ => {
          return Result<Conn, Failure>::Err(fail_with(COULDNT_CONNECT,
            connect_failure(names, &started)));
        }
      }
    }
  }
}

/// `UnixStream::connect`, which gives up at `deadline`.
fn unix_connect_by(network : &Network, path : &String, deadline : Instant)
-> Result<UnixStream, NetError> {
  if deadline == Instant::never() {
    return UnixStream::connect(network, path);
  }
  if past_deadline(deadline) {
    return Result<UnixStream, NetError>::Err(NetError::Cancelled);
  }
  return within(deadline - Instant::now(), || -> Result<UnixStream, NetError> {
    return UnixStream::connect(network, path);
  });
}

/// A connection over `net`, whose waits give up at `deadline`, with an empty read buffer.
fn conn_of(net : NetStream, deadline : Instant) -> Conn {
  let mut buffer = Vec<u8>::new();
  let mut i = 0;
  while i < READ_BUFFER_SIZE {
    buffer.push(0u8);
    i = i + 1;
  }
  let mut stream = net;
  stream.set_deadline(deadline);
  return Conn {
    stream : stream,
    buffer : buffer,
    start : 0,
    end : 0,
    closed : false,
    deadline : deadline,
    recv_limit : no_limit(),
    send_limit : no_limit()
  };
}

impl Conn {
  /// Whether TLS chose HTTP/2 for the connection.
  pub fn is_h2(self : &Conn) -> bool {
    return self.stream.is_h2();
  }

  /// Make each wait of the connection from now on give up at `at`.
  pub fn set_deadline(self : &mut Conn, at : Instant) -> void {
    self.deadline = at;
    self.stream.set_deadline(at);
  }

  /// Limit the bytes that arrive and those that go to `rate` bytes per second from now on, as
  /// curl's `--limit-rate` does after the connect. A slow rate reads less at a time, as curl
  /// does. The read buffer must be empty.
  pub fn limit_rate(self : &mut Conn, rate : i64) -> void {
    assert(self.start == self.end, "limit_rate with bytes in the read buffer");
    self.recv_limit = RateLimit {
      rate : rate,
      started : Instant::now(),
      count : 0i64
    };
    self.send_limit = RateLimit {
      rate : rate,
      started : Instant::now(),
      count : 0i64
    };
    if rate < (self.buffer.len() as i64) {
      let mut smaller = Vec<u8>::new();
      let mut i = 0i64;
      while i < rate || i == 0i64 {
        smaller.push(0u8);
        i = i + 1i64;
      }
      self.buffer = smaller;
      self.start = 0;
      self.end = 0;
    }
  }

  /// Send all of `bytes`. Under `--limit-rate`, in pieces of at most one second's worth.
  pub fn send(self : &mut Conn, bytes : &Vec<u8>) -> Result<i32, Failure> {
    if bytes.len() == 0 {
      return Result<i32, Failure>::Ok(0);
    }
    if self.send_limit.rate > 0i64 {
      let mut piece = READ_BUFFER_SIZE as i64;
      if self.send_limit.rate < piece {
        piece = self.send_limit.rate;
      }
      let mut at = 0;
      while at < bytes.len() {
        let mut end = at + (piece as i32);
        if end > bytes.len() {
          end = bytes.len();
        }
        let _sent = self.send_all(&range_of(bytes, at, end))?;
        pace(&mut self.send_limit, (end - at) as i64, self.deadline);
        at = end;
      }
      return Result<i32, Failure>::Ok(0);
    }
    return self.send_all(bytes);
  }

  fn send_all(self : &mut Conn, bytes : &Vec<u8>) -> Result<i32, Failure> {
    match self.stream.write_all(bytes) {
      Result<u64, TlsError>::Ok(_n) => {
        return Result<i32, Failure>::Ok(0);
      },
      Result<u64, TlsError>::Err(e) => {
        return Result<i32, Failure>::Err(failure_of(e));
      }
    }
  }

  /// Start TLS for the server `host`, and offer HTTP/2 with ALPN when `offer_h2`. A response
  /// must not be half read.
  pub fn start_tls(self : &mut Conn, config : &TlsConfig, host : &Vec<u8>, host_is_ip : bool,
  offer_h2 : bool) -> Result<i32, Failure> {
    assert(self.start == self.end, "start_tls with bytes in the read buffer");
    match self.stream.start_tls(config, host, host_is_ip, offer_h2) {
      Result<i32, TlsError>::Ok(_v) => {
        return Result<i32, Failure>::Ok(0);
      },
      Result<i32, TlsError>::Err(e) => {
        return Result<i32, Failure>::Err(failure_of(e));
      }
    }
  }

  /// Read more bytes into the empty buffer. Gives false when the peer closed the connection.
  fn fill(self : &mut Conn) -> Result<bool, Failure> {
    if self.closed {
      return Result<bool, Failure>::Ok(false);
    }
    match self.stream.read(&mut self.buffer) {
      Result<u64, TlsError>::Ok(n) => {
        if n == 0u64 {
          self.closed = true;
          return Result<bool, Failure>::Ok(false);
        }
        self.start = 0;
        self.end = n as i32;
        pace(&mut self.recv_limit, n as i64, self.deadline);
        return Result<bool, Failure>::Ok(true);
      },
      Result<u64, TlsError>::Err(e) => {
        return Result<bool, Failure>::Err(failure_of(e));
      }
    }
  }

  /// Add the next line, with its `\n`, to the end of `line`, and give how many bytes it added.
  /// The last line before the peer closes can have no `\n`. 0 means that the peer closed the
  /// connection first. A line longer than `max` bytes fails with `code` and `message` as soon
  /// as it passes `max`, so that a peer that never sends a `\n` cannot fill the memory.
  pub fn read_line(self : &mut Conn, line : &mut Vec<u8>, max : i32, code : i32,
  message : *const i8) -> Result<i32, Failure> {
    let mut count = 0;
    loop {
      if self.start == self.end {
        let more = self.fill()?;
        if !more {
          return Result<i32, Failure>::Ok(count);
        }
      }
      let mut stop = self.start;
      let mut found = false;
      while stop < self.end && !found {
        found = self.buffer.get(stop) == 10u8;
        stop = stop + 1;
      }
      append_range(line, &self.buffer, self.start, stop);
      count = count + (stop - self.start);
      self.start = stop;
      if count > max {
        return Result<i32, Failure>::Err(fail_lit(code, message));
      }
      if found {
        return Result<i32, Failure>::Ok(count);
      }
    }
  }

  /// Give up to `max` bytes, the buffered ones first. An empty result means that the peer
  /// closed the connection.
  pub fn read_some(self : &mut Conn, max : i64) -> Result<Vec<u8>, Failure> {
    if self.start == self.end {
      let more = self.fill()?;
      if !more {
        return Result<Vec<u8>, Failure>::Ok(Vec<u8>::new());
      }
    }
    let mut stop = self.end;
    if ((stop - self.start) as i64) > max {
      stop = self.start + (max as i32);
    }
    let out = range_of(&self.buffer, self.start, stop);
    self.start = stop;
    return Result<Vec<u8>, Failure>::Ok(out);
  }
}

/// curl's text for a connection that did not open, which began at `started`.
fn connect_failure(names : &ConnNames, started : &Instant) -> Vec<u8> {
  let mut m = lit("Failed to connect to ");
  append(&mut m, &names.label);
  push_lit(&mut m, " after ");
  push_u64(&mut m, started.elapsed().as_millis());
  push_lit(&mut m, " ms: Could not connect to server");
  return m;
}
