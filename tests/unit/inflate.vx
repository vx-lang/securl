// Checks the DEFLATE, gzip and zlib decoders of securl::inflate with data from Python's zlib,
// fed whole and one byte at a time, so that each symbol and header can be cut. Made by
// tools/gen-inflate-test.py.
import core::result;
import std::vec;
import sys::text;
import securl::bytes;
import securl::inflate;

fn unhex(s : *const i8) -> Vec<u8> {
  let h = lit(s);
  let mut out = Vec<u8>::new();
  let mut i = 0;
  while i + 1 < h.len() {
    out.push((hex_value(h.get(i)) * 16 + hex_value(h.get(i + 1))) as u8);
    i = i + 2;
  }
  return out;
}

/// The output of a decoder of `wrap` for `data`, fed in pieces of `step` bytes. `ok` says
/// whether it took all pieces, `done` whether the data ended, and `error` why it failed.
fn run(wrap : i32, data : &Vec<u8>, step : i32, ok : &mut bool, done : &mut bool,
error : &mut Vec<u8>) -> Vec<u8> {
  let mut d = new_inflate(wrap);
  let mut out = Vec<u8>::new();
  let mut i = 0;
  *ok = true;
  while i < data.len() {
    let mut end = i + step;
    if end > data.len() {
      end = data.len();
    }
    match d.feed(&range_of(data, i, end)) {
      Result<Vec<u8>, i32>::Ok(part) => {
        append(&mut out, &part);
      },
      Result<Vec<u8>, i32>::Err(_e) => {
        *ok = false;
        *error = clone_bytes(&d.error);
        return out;
      }
    }
    i = end;
  }
  *done = d.complete();
  return out;
}

/// Whether `data` decodes to `want`, fed one byte at a time and fed whole.
fn decodes(wrap : i32, data : *const i8, want : *const i8) -> bool {
  let input = unhex(data);
  let expected = unhex(want);
  let mut step = 1;
  while step <= input.len() {
    let mut ok = false;
    let mut done = false;
    let mut error = Vec<u8>::new();
    let got = run(wrap, &input, step, &mut ok, &mut done, &mut error);
    if !ok || !done || !same_bytes(&got, &expected) {
      return false;
    }
    if step == 1 {
      step = input.len();
    } else {
      step = input.len() + 1;
    }
  }
  return true;
}

/// Whether the decoder refuses `data` with `message`.
fn fails_with(wrap : i32, data : *const i8, message : *const i8) -> bool {
  let input = unhex(data);
  let mut ok = true;
  let mut done = false;
  let mut error = Vec<u8>::new();
  let _got = run(wrap, &input, input.len(), &mut ok, &mut done, &mut error);
  return !ok && eq_lit(&error, message);
}

fn main() -> i32 {
  assert(decodes(WRAP_GZIP, "1f8b08000000000000ffcb48cdc9c957c8c020cbf38b7252b832289005001363aae55a000000",
    "68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a"), "gzip, fixed codes");
  assert(decodes(WRAP_GZIP, "",
    ""), "gzip, dynamic codes");
  assert(decodes(WRAP_GZIP, "",
    ""), "gzip, stored blocks");
  assert(decodes(WRAP_GZIP, "1f8b081c0000000000ff040058595a57662e747874006120636f6d6d656e7400cb48cdc9c957c8c020cbf38b7252b830c5899705001363aae55a000000",
    "68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a"), "gzip with FEXTRA, FNAME and FCOMMENT");
  assert(decodes(WRAP_ZLIB, "",
    ""), "zlib, dynamic codes");
  assert(decodes(WRAP_ZLIB, "7801015a00a5ff68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640aeaa62107",
    "68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a"), "zlib, stored");
  assert(decodes(WRAP_ZLIB, "",
    ""), "raw DEFLATE sent as deflate");
  assert(decodes(WRAP_RAW, "cb48cdc9c957c8c020cbf38b7252b83228900500",
    "68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a68656c6c6f2068656c6c6f2068656c6c6f2068656c6c6f20776f726c640a"), "raw DEFLATE");
  assert(fails_with(WRAP_GZIP, "1f8c08000000000000ffcb48cdc9c957c8c020cbf38b7252b832289005001363aae55a000000",
    "incorrect header check"), "a bad gzip magic");
  assert(fails_with(WRAP_GZIP, "1f8b08000000000000ffcb48cdc9c957c8c020cbf38b7252b832289005001263aae55a000000",
    "incorrect data check"), "a bad CRC");
  assert(fails_with(WRAP_RAW, "0700",
    "invalid block type"), "a bad block type");
  assert(fails_with(WRAP_GZIP, "1f8b08000000000000ffcb48cdc9c957c8c020cbf38b7252b832289005001363aae55a0000001f8b08000000000000ffcb48cdc9c957c8c020cbf38b7252b832289005001363aae55a000000",
    "Multi-member gzip response not supported"), "two gzip members");
  // A body that ends inside the data is not complete.
  let mut ok = false;
  let mut done = true;
  let mut error = Vec<u8>::new();
  let _part = run(WRAP_GZIP, &unhex("1f8b08000000000000ffcb48cdc9c957c8c020cbf38b7252b832289005001363aa"), 1000, &mut ok, &mut done, &mut error);
  assert(ok && !done, "a cut gzip body");
  return 0;
}
