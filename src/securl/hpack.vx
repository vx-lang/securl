  t.push(0i64);
  t.push(95i64);
  t.push(0i64);
  t.push(0i64);
  t.push(95i64);
  t.push(0i64);
  t.push(0i64);
  t.push(95i64);
  t.push(0i64);
  t.push(524272i64);
  t.push(95i64);
  t.push(3i64);
  t.push(1048550i64);
  t.push(98i64);
