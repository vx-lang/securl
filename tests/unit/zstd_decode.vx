// Checks securl::zstd against frames that libzstd made, fed whole, a byte at a time, and in
// pieces of 7 bytes. Made by tools/gen-zstd-test.py.
import core::num;
import core::result;
import std::vec;
import sys::text;
import securl::bytes;
import securl::zstd;

fn hex_value(c : u8) -> i32 {
  if c >= 97u8 {
    return (c as i32) - 87;
  }
  return (c as i32) - 48;
}

/// The bytes of the hex text `s`.
fn unhex(s : *const i8) -> Vec<u8> {
  let t = lit(s);
  let mut out = Vec<u8>::new();
  let mut i = 0;
  while i + 1 < t.len() {
    out.push((hex_value(t.get(i)) * 16 + hex_value(t.get(i + 1))) as u8);
    i = i + 2;
  }
  return out;
}

fn fnv(data : &Vec<u8>) -> u64 {
  let mut h : u64 = 14695981039346656037u64;
  for b in data.iter() {
    h = (h ^ (*b as u64)) * 1099511628211u64;
  }
  return h;
}

// What a decoding gave: 0 for a body that ended after a frame, 1 for an error, 2 for a body that
// ended inside a frame.
struct Decoded {
  status : i32,
  out : Vec<u8>,
}

fn decode(data : &Vec<u8>, piece : i32) -> Decoded {
  let mut z = new_zstd();
  let mut out = Vec<u8>::new();
  let mut at = 0;
  while at < data.len() {
    let mut end = at + piece;
    if end > data.len() {
      end = data.len();
    }
    match z.feed(&range_of(data, at, end)) {
      Result<Vec<u8>, i32>::Ok(bytes) => {
        append(&mut out, &bytes);
      },
      Result<Vec<u8>, i32>::Err(_e) => {
        return Decoded {
          status : 1,
          out : out
        };
      }
    }
    at = end;
  }
  let mut status = 0;
  if !z.complete() {
    status = 2;
  }
  return Decoded {
    status : status,
    out : out
  };
}

fn decodes_to(frame : *const i8, length : i32, hash : u64) -> bool {
  let data = unhex(frame);
  let sizes = [1000000, 1, 7];
  let mut k = 0;
  while k < 3 {
    let d = decode(&data, sizes[k]);
    if d.status != 0 || d.out.len() != length || fnv(&d.out) != hash {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn ends_with(frame : *const i8, status : i32) -> bool {
  let data = unhex(frame);
  let sizes = [1000000, 1, 7];
  let mut k = 0;
  while k < 3 {
    if decode(&data, sizes[k]).status != status {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn main() -> i32 {
  assert(decodes_to("28b52ffd2401090000615b6e8ca9",
    1, 12638187200555641996u64), "one byte");
  assert(decodes_to("",
    3000, 4932415133408009903u64), "text, level 1");
  assert(decodes_to("",
    3000, 4932415133408009903u64), "text, level 19");
  assert(decodes_to("",
    3000, 4932415133408009903u64), "text, a fast level");
  assert(decodes_to("",
    3000, 4932415133408009903u64), "text, no checksum");
  assert(decodes_to("",
    3000, 4932415133408009903u64), "text, no content size");
  assert(decodes_to("28b52ffd64d0064d00001000000100cbff000b437e9c99",
    2000, 8769874589106626405u64), "zeros");
  assert(decodes_to("",
    1500, 14149310919810497790u64), "random bytes");
  assert(decodes_to("",
    900, 332187495029631028u64), "two frames and a skippable frame");
  assert(decodes_to("28b52ffd240001000099e9d851",
    0, 14695981039346656037u64), "an empty frame");
  assert(ends_with("", 1), "a bad checksum fails");
  assert(ends_with("", 1), "an unknown magic number fails");
  assert(ends_with("", 1), "a frame after junk fails");
  assert(ends_with("28b52ffd25070529000068656c6c6fa36d9f88", 1), "a frame that names a dictionary fails");
  assert(ends_with("", 1), "a flipped byte in a block fails");
  assert(ends_with("", 2), "a frame cut in its block is incomplete");
  assert(ends_with("", 2), "a frame without its checksum is incomplete");
  return 0;
}
