// Checks securl::brotli against streams that libbrotli made, fed whole, a byte at a time, and
// in pieces of 7 bytes. Made by tools/gen-brotli-test.py.
import core::num;
import core::result;
import std::vec;
import sys::text;
import securl::brotli;
import securl::bytes;

fn hex_value(c : u8) -> i32 {
  if c >= 97u8 {
    return (c as i32) - 87;
  }
  return (c as i32) - 48;
}

/// The bytes of the hex text `s`.
fn unhex(s : *const i8) -> Vec<u8> {
  let t = lit(s);
  let mut out = Vec<u8>::new();
  let mut i = 0;
  while i + 1 < t.len() {
    out.push((hex_value(t.get(i)) * 16 + hex_value(t.get(i + 1))) as u8);
    i = i + 2;
  }
  return out;
}

fn fnv(data : &Vec<u8>) -> u64 {
  let mut h : u64 = 14695981039346656037u64;
  for b in data.iter() {
    h = (h ^ (*b as u64)) * 1099511628211u64;
  }
  return h;
}

// What a decoding gave: 0 for a body that ended after the stream, the exit code of libcurl for an
// error, or 1 for a body that ended inside the stream.
struct Decoded {
  status : i32,
  out : Vec<u8>,
}

fn decode(data : &Vec<u8>, piece : i32) -> Decoded {
  let mut b = new_brotli();
  let mut out = Vec<u8>::new();
  let mut at = 0;
  while at < data.len() {
    let mut end = at + piece;
    if end > data.len() {
      end = data.len();
    }
    match b.feed(&range_of(data, at, end)) {
      Result<Vec<u8>, i32>::Ok(bytes) => {
        append(&mut out, &bytes);
      },
      Result<Vec<u8>, i32>::Err(code) => {
        return Decoded {
          status : code,
          out : out
        };
      }
    }
    at = end;
  }
  let mut status = 0;
  if !b.complete() {
    status = 1;
  }
  return Decoded {
    status : status,
    out : out
  };
}

fn decodes_to(stream : *const i8, length : i32, hash : u64) -> bool {
  let data = unhex(stream);
  let sizes = [1000000, 1, 7];
  let mut k = 0;
  while k < 3 {
    let d = decode(&data, sizes[k]);
    if d.status != 0 || d.out.len() != length || fnv(&d.out) != hash {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn ends_with(stream : *const i8, status : i32) -> bool {
  let data = unhex(stream);
  let sizes = [1000000, 1, 7];
  let mut k = 0;
  while k < 3 {
    if decode(&data, sizes[k]).status != status {
      return false;
    }
    k = k + 1;
  }
  return true;
}

fn main() -> i32 {
  assert(decodes_to("0b00806103",
    1, 12638187200555641996u64), "one byte");
  assert(decodes_to("06",
    0, 14695981039346656037u64), "nothing");
  assert(decodes_to("",
    4000, 14046834365683445016u64), "text, quality 0");
  assert(decodes_to("",
    4000, 14046834365683445016u64), "text, quality 5");
  assert(decodes_to("",
    4000, 14046834365683445016u64), "text, quality 11");
  assert(decodes_to("",
    4000, 14046834365683445016u64), "text, a window of 1 KiB");
  assert(decodes_to("",
    589, 14539472215480876833u64), "English with the dictionary");
  assert(decodes_to("",
    589, 14539472215480876833u64), "English, quality 5");
  assert(decodes_to("1bb70b002400e2b140e2060000",
    3000, 1049713259462413189u64), "zeros");
  assert(decodes_to("",
    1500, 10509552860065434638u64), "random bytes");
  assert(ends_with("", 61), "a flipped byte fails with 61");
  assert(ends_with("", 23), "bytes after the end fails with 23");
  assert(ends_with("1b4c02208c94ab3bc39ecf778ef4bfa315d8a80be46a99a100a66d4a631c5ef7b62c19098217088241204013ec84240885b0d8b67cf41cff60c6cac9a5a1b7eded20e1b17050fc92d90e25cee27b83e204f62685f51ace46765b99ca20a1660ff538dd2024df3b8c8f31e1462f3991e0c6aefd59c6b8ba07859f8589aaca86c05074bd1870d977d5", 1), "a stream cut in half is incomplete");
  assert(ends_with("", 1), "a stream without its last byte is incomplete");
  return 0;
}
