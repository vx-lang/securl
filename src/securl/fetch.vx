// One transfer: connect, send the request, read the response, and follow redirects with `-L`.
//
// The caller gives the network right (`&Network`) and the outputs. This file cannot open a
// file, because it gets no `&Files`.
import core::option;
import core::result;
import core::time;
import std::fs;
import std::net;
import std::sync::wait;
import std::time;
import std::vec;
import sys::socket;
import sys::text;
import sys::tls;
import securl::address;
import securl::auth;
import securl::bytes;
import securl::conn;
import securl::cookie;
import securl::date;
import securl::failure;
import securl::h2;
import securl::hsts;
import securl::http;
import securl::options;
import securl::output;
import securl::pool;
import securl::socks;
import securl::url;

/// What `-w` can print about a transfer.
struct TransferInfo {
  http_code : i32,
  // The status of the reply of a CONNECT proxy, or 0.
  http_connect : i32,
  http_version : i32,
  size_download : i64,
  // The bytes of the body that went to the output, after `--compressed` decoded them.
  size_delivered : i64,
  size_header : i64,
  size_request : i64,
  // The bytes of the body of the last request.
  size_upload : i64,
  num_redirects : i32,
  url_effective : Vec<u8>,
  content_type : Vec<u8>,
  has_redirect_url : bool,
  redirect_url : Vec<u8>,
  method : Vec<u8>,
  num_connects : i32,
  num_headers : i32,
  // The headers of the last response, for `-w %header{name}`.
  headers : Vec<Vec<u8>>,
  // The headers of all responses of the transfer, for `-w %header{name:all:}`.
  all_headers : Vec<Vec<u8>>,
  // The `host:port` of the last connection.
  remote_address : Vec<u8>,
  referer : Vec<u8>,
  // The header bytes of all responses of the transfer, for curl's limit.
  size_header_total : i64,
  // `size_download` when the last request started, and the length of its body when the
  // response says it (else -1). The message of a timeout gives both.
  hop_start_download : i64,
  expected_size : i64,
  // A response of the transfer said HTTP/1.0, so the next requests of the transfer use 1.0.
  received_http10 : bool,
  // The seconds of the Retry-After header of the last response, or 0, for `--retry`.
  retry_after : i64,
  // How many times `--retry` tried the transfer again.
  num_retries : i32,
  // `-J`: the file name that a Content-Disposition or the Location of a redirect gave, and
  // whether a Content-Disposition gave it, after which no header changes it.
  header_name : Vec<u8>,
  has_header_name : bool,
  header_name_final : bool,
  // The file that the output went to, for `%{filename_effective}`, or empty.
  filename_effective : Vec<u8>,
}

/// A `TransferInfo` before the transfer starts.
pub fn new_info() -> TransferInfo {
  return TransferInfo {
    http_code : 0,
    http_connect : 0,
    http_version : 0,
    size_download : 0i64,
    size_delivered : 0i64,
    size_header : 0i64,
    size_request : 0i64,
    size_upload : 0i64,
    num_redirects : 0,
    url_effective : Vec<u8>::new(),
    content_type : Vec<u8>::new(),
    has_redirect_url : false,
    redirect_url : Vec<u8>::new(),
    method : Vec<u8>::new(),
    num_connects : 0,
    num_headers : 0,
    headers : Vec<Vec<u8>>::new(),
    all_headers : Vec<Vec<u8>>::new(),
    remote_address : Vec<u8>::new(),
    referer : Vec<u8>::new(),
    size_header_total : 0i64,
    hop_start_download : 0i64,
    expected_size : -1i64,
    received_http10 : false,
    retry_after : 0i64,
    num_retries : 0,
    header_name : Vec<u8>::new(),
    has_header_name : false,
    header_name_final : false,
    filename_effective : Vec<u8>::new()
  };
}

/// The TLS settings of a run: for the servers, and for an HTTPS proxy, which has its own
/// certificate authorities (`--proxy-cacert`, `--proxy-capath`) and check (`--proxy-insecure`).
struct TlsSettings {
  server : TlsConfig,
  proxy : TlsConfig,
}

/// What the transfers of a run share: the cookies, the HSTS cache, and the connections that
/// stay open for a later transfer.
struct Session {
  jar : CookieJar,
  hsts : Hsts,
  pool : Pool,
}

/// Where the bytes of one transfer go.
struct Sinks {
  body : Output,
  headers : Output,
  has_headers : bool,
  // `-C`: the body goes on from this byte of the file, or -1 for an upload that asks for it.
  resume_from : i64,
  // The upload of `-T` comes from standard input, so its length is not known before.
  upload_from_stdin : bool,
}

/// Write the header lines `raw` to the output when `to_body` (`-i`), and to the file of `-D`.
/// When both get them, curl writes each line to the one and then to the other, which shows
/// when both are standard output.
fn write_head(console : &mut Console, sinks : &mut Sinks, to_body : bool, raw : &Vec<u8>)
-> Result<i32, Failure> {
  if !to_body || !sinks.has_headers {
    if to_body {
      let _w = sinks.body.write(console, raw)?;
    }
    if sinks.has_headers {
      let _w = sinks.headers.write(console, raw)?;
    }
    return Result<i32, Failure>::Ok(0);
  }
  let mut start = 0;
  while start < raw.len() {
    let mut end = find_byte(raw, 10u8, start);
    if end < 0 {
      end = raw.len() - 1;
    }
    let line = range_of(raw, start, end + 1);
    let _b = sinks.body.write(console, &line)?;
    let _h = sinks.headers.write(console, &line)?;
    start = end + 1;
  }
  return Result<i32, Failure>::Ok(0);
}

/// Write `bytes` to standard error with `prefix` before each line, for `-v`.
fn verbose_lines(console : &mut Console, prefix : *const i8, bytes : &Vec<u8>) -> void {
  let mut out = Vec<u8>::new();
  let mut start = 0;
  while start < bytes.len() {
    let mut end = find_byte(bytes, 10u8, start);
    if end < 0 {
      end = bytes.len() - 1;
    }
    push_lit(&mut out, prefix);
    append_range(&mut out, bytes, start, end + 1);
    start = end + 1;
  }
  console.to_stderr(&out);
}

/// The request as `-v` shows it. Over HTTP/2, curl ends the request line with `HTTP/2`, so
/// the HTTP/1.1 text that `build_request` makes gets that version for the display.
fn shown_request(request : &Vec<u8>, h2 : bool) -> Vec<u8> {
  let line_end = find_byte(request, 13u8, 0);
  if !h2 || line_end < 8 {
    return clone_bytes(request);
  }
  let mut out = Vec<u8>::new();
  append_range(&mut out, request, 0, line_end - 8);
  push_lit(&mut out, "HTTP/2");
  append_range(&mut out, request, line_end, request.len());
  return out;
}

fn verbose_info(console : &mut Console, text : &Vec<u8>) -> void {
  let mut out = lit("* ");
  append(&mut out, text);
  push_lit(&mut out, "\n");
  console.to_stderr(&out);
}

/// `host:port` with brackets around an IPv6 address.
fn address_of(host : &Vec<u8>, port : i32) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  let v6 = find_byte(host, 58u8, 0) >= 0 && !(host.len() > 0 && host.get(0) == 91u8);
  if v6 {
    push_lit(&mut out, "[");
  }
  append(&mut out, host);
  if v6 {
    push_lit(&mut out, "]");
  }
  push_lit(&mut out, ":");
  push_u64(&mut out, port as u64);
  return out;
}

/// The fields of `text` split at each `:`, with `[..]` kept whole.
fn colon_fields(text : &Vec<u8>) -> Vec<Vec<u8>> {
  let mut fields = Vec<Vec<u8>>::new();
  let mut cur = Vec<u8>::new();
  let mut in_brackets = false;
  for b in text.iter() {
    if *b == 91u8 {
      in_brackets = true;
    }
    if *b == 93u8 {
      in_brackets = false;
    }
    if *b == 58u8 && !in_brackets {
      fields.push(cur);
      cur = Vec<u8>::new();
    } else {
      cur.push(*b);
    }
  }
  fields.push(cur);
  return fields;
}

fn port_matches(field : &Vec<u8>, port : i32) -> bool {
  if field.len() == 0 {
    return true;
  }
  match parse_u64(field) {
    Option<u64>::Some(p) => {
      return (p as i32) == port;
    },
    Option<u64>::None() => {
      return false;
    }
  }
}

/// The address to connect to for `u`, after `--connect-to` and `--resolve`. A rule with a
/// port that is not a number is an error, as in curl.
fn connect_address(cfg : &Config, u : &Url) -> Result<Vec<u8>, Failure> {
  let target = connect_target(cfg, u)?;
  let host = resolve_rule(cfg, &target.host, target.port)?;
  return Result<Vec<u8>, Failure>::Ok(address_of(&host, target.port));
}

/// The host and port of `u`, or the ones that `--connect-to` gives for them.
fn connect_target(cfg : &Config, u : &Url) -> Result<Target, Failure> {
  let mut host = clone_bytes(&u.host);
  let mut port = u.port;
  // `--connect-to HOST1:PORT1:HOST2:PORT2`. An empty field matches any host or port, or keeps
  // the one of the URL.
  for rule in cfg.connect_to.iter() {
    let f = colon_fields(rule);
    if f.len() == 4 {
      let mut from = clone_bytes(f.get_ref(0));
      if from.len() > 1 && from.get(0) == 91u8 && from.get(from.len() - 1) == 93u8 {
        from = range_of(&from, 1, from.len() - 1);
      }
      let host_ok = from.len() == 0 || eq_nocase(&from, &u.host);
      if host_ok && port_matches(f.get_ref(1), u.port) {
        if f.get_ref(2).len() > 0 {
          host = clone_bytes(f.get_ref(2));
          if host.len() > 1 && host.get(0) == 91u8 {
            host = range_of(&host, 1, host.len() - 1);
          }
        }
        if f.get_ref(3).len() > 0 {
          match parse_u64(f.get_ref(3)) {
            Option<u64>::Some(p) => {
              port = p as i32;
            },
            Option<u64>::None() => {
              let mut m = lit("No valid port number in '");
              append(&mut m, rule);
              push_lit(&mut m, "'");
              return Result<Target, Failure>::Err(fail_with(SETOPT_OPTION_SYNTAX, m));
            }
          }
        }
        break;
      }
    }
  }
  return Result<Target, Failure>::Ok(Target {
    host : host,
    port : port
  });
}

/// The address that `--resolve HOST:PORT:ADDRESS[,ADDRESS]` gives for `name` and `port`, or
/// `name` itself.
fn resolve_rule(cfg : &Config, name : &Vec<u8>, port : i32) -> Result<Vec<u8>, Failure> {
  let mut host = clone_bytes(name);
  for rule in cfg.resolve.iter() {
    let mut text = clone_bytes(rule);
    if text.len() > 0 && text.get(0) == 45u8 {
      // `-HOST:PORT` takes an entry out of libcurl's DNS cache. securl keeps no entry from one
      // `--next` group to the next, so there is nothing to take out.
      continue;
    }
    if text.len() > 0 && text.get(0) == 43u8 {
      text = rest_from(&text, 1);
    }
    let f = colon_fields(&text);
    if f.len() < 3 || parse_u64(f.get_ref(1)).is_none() {
      let mut m = lit("Couldn't parse CURLOPT_RESOLVE entry '");
      append(&mut m, rule);
      push_lit(&mut m, "'");
      return Result<Vec<u8>, Failure>::Err(fail_with(SETOPT_OPTION_SYNTAX, m));
    }
    let any_host = eq_lit(f.get_ref(0), "*");
    if (any_host || eq_nocase(f.get_ref(0), &host)) && port_matches(f.get_ref(1), port) {
      let mut addr = clone_bytes(f.get_ref(2));
      let comma = find_byte(&addr, 44u8, 0);
      if comma >= 0 {
        addr = range_of(&addr, 0, comma);
      }
      if addr.len() > 1 && addr.get(0) == 91u8 {
        addr = range_of(&addr, 1, addr.len() - 1);
      }
      if addr.len() > 0 {
        host = addr;
      }
      break;
    }
  }
  return Result<Vec<u8>, Failure>::Ok(host);
}

/// The addresses of the host name `name`, from the resolver of the system: 4 bytes for IPv4 and
/// 16 for IPv6, in its order. None when the lookup fails, or for a name that is not UTF-8 or
/// holds a NUL byte. A lookup can send the name to the network, so it needs the network right.
fn lookup_addresses(network : &Network, name : &Vec<u8>) -> Option<Vec<Vec<u8>>> {
  match to_string(name) {
    Option<String>::Some(host) => {
      match lookup(network, &host) {
        Result<Vec<IpAddress>, NetError>::Ok(found) => {
          let mut out = Vec<Vec<u8>>::new();
          for a in found.iter() {
            out.push(clone_bytes(&a.bytes));
          }
          return Option<Vec<Vec<u8>>>::Some(out);
        },
        Result<Vec<IpAddress>, NetError>::Err(_e) => {
          return Option<Vec<Vec<u8>>>::None();
        }
      }
    },
    Option<String>::None() => {
      return Option<Vec<Vec<u8>>>::None();
    }
  }
}

/// What the SOCKS proxy `proxy` needs to connect to the server of `u`. SOCKS4 and SOCKS5 send
/// the address of the server, so this looks it up: with `--resolve`, or as an address, or else
/// with the network right.
fn socks_request(network : &Network, cfg : &Config, u : &Url, proxy : &Proxy)
-> Result<SocksRequest, Failure> {
  let target = connect_target(cfg, u)?;
  let mut addresses = Vec<Vec<u8>>::new();
  let mut lookup_failed = false;
  if socks_resolves_locally(proxy.kind) {
    let name = resolve_rule(cfg, &target.host, target.port)?;
    match parse_ipv4(&name) {
      Option<Vec<u8>>::Some(a) => {
        addresses.push(a);
      },
      Option<Vec<u8>>::None() => {
        match parse_ipv6(&name) {
          Option<Vec<u8>>::Some(a) => {
            addresses.push(a);
          },
          Option<Vec<u8>>::None() => {
            if is_localhost_name(&name) {
              addresses = localhost_addresses();
            } else {
              match lookup_addresses(network, &name) {
                Option<Vec<Vec<u8>>>::Some(found) => {
                  addresses = found;
                },
                Option<Vec<Vec<u8>>>::None() => {
                  lookup_failed = true;
                }
              }
            }
          }
        }
      }
    }
  }
  return Result<SocksRequest, Failure>::Ok(SocksRequest {
    kind : proxy.kind,
    host : target.host,
    port : target.port,
    addresses : addresses,
    lookup_failed : lookup_failed,
    proxy : clone_url(&proxy.url),
    credential : clone_credential(&proxy.credential)
  });
}

// The limits of libcurl for response headers: one header line, all headers of one response,
// and the number of headers. The status line and the lines of a chunked body have the limit of
// a header line too.
const MAX_HEADER_LINE : i32 = 102400;
const MAX_HEADERS_SIZE : i64 = 307200i64;
// The longest trailer line, with its CRLF, as libcurl's DYN_H1_TRAILER of 4096 bytes allows.
const MAX_TRAILER_LINE : i32 = 4095;

const MAX_HEADER_COUNT : i32 = 5000;

/// Read one response head: the status line and the headers, up to the empty line. `total`
/// counts the header bytes of all responses of the transfer, which libcurl also limits.
///
/// A status line or header line longer than 100 KiB fails with the text of CURLE_TOO_LARGE, as
/// in curl, where libcurl gives that error with no message of its own. `bad_status` is the
/// failure when the first line is no status line.
///
/// As in libcurl, a line that starts with a blank continues the header line before it, and
/// each whole header line is checked before it counts: `head.raw` holds the lines before a bad
/// one, which curl writes with `-i` before it stops.
fn read_head(c : &mut Conn, raw : bool, tr_encoding : bool, total : &mut i64, bad_status : Failure)
-> Result<ResponseHead, Failure> {
  let mut head = empty_head();
  head.tr_encoding = tr_encoding;
  let mut line = Vec<u8>::new();
  let n = c.read_line(&mut line, MAX_HEADER_LINE, TOO_LARGE,
    "A value or data field grew larger than allowed")?;
  if n == 0 {
    return Result<ResponseHead, Failure>::Err(fail_lit(GOT_NOTHING, "Empty reply from server"));
  }
  if !parse_status_line(&line, &mut head) {
    return Result<ResponseHead, Failure>::Err(bad_status);
  }
  if head.error_code != 0 || !line_is_clean(&line, &mut head) {
    return Result<ResponseHead, Failure>::Ok(head);
  }
  append(&mut head.raw, &line);
  let mut size : i64 = line.len() as i64;
  let mut index = 1;
  // The header line that the next line may continue, and its number.
  let mut pending = Vec<u8>::new();
  let mut pending_index = 0;
  loop {
    let mut h = Vec<u8>::new();
    let got = c.read_line(&mut h, MAX_HEADER_LINE, TOO_LARGE,
      "A value or data field grew larger than allowed")?;
    let last = got == 0 || eq_lit(&h, "\r\n") || eq_lit(&h, "\n");
    if pending.len() > 0 && !last && is_blank(h.get(0)) {
      pending = unfold(&pending, &h);
    } else {
      if pending.len() > 0 {
        parse_header_line(&pending, pending_index, raw, &mut head);
        if head.error_code != 0 {
          return Result<ResponseHead, Failure>::Ok(head);
        }
        append(&mut head.raw, &pending);
        pending = Vec<u8>::new();
      }
      if got == 0 {
        // The peer closed the connection inside the headers.
        return Result<ResponseHead, Failure>::Ok(head);
      }
    }
    index = index + 1;
    size = size + (h.len() as i64);
    *total = *total + (h.len() as i64);
    if index > MAX_HEADER_COUNT {
      return Result<ResponseHead, Failure>::Err(fail_lit(TOO_LARGE,
        "Too many response headers, 5000 is max"));
    }
    if size > MAX_HEADERS_SIZE || *total > MAX_HEADERS_SIZE * 20i64 {
      let mut m = lit("Too large response headers: ");
      push_i64(&mut m, size);
      push_lit(&mut m, " > 307200");
      return Result<ResponseHead, Failure>::Err(fail_with(RECV_ERROR, m));
    }
    if last {
      append(&mut head.raw, &h);
      return Result<ResponseHead, Failure>::Ok(head);
    }
    if pending.len() == 0 {
      pending = h;
      pending_index = index;
    }
  }
}

/// Write the piece `part` of a body to `out`. As libcurl, it counts in `%{size_download}` once
/// the decoders and the output took it, and with `--max-filesize`, the bytes up to the limit
/// count too.
fn write_body(out : &mut Output, console : &mut Console, part : &Vec<u8>, info : &mut TransferInfo)
-> Result<i32, Failure> {
  let before = out.raw_in;
  match out.write(console, part) {
    Result<i32, Failure>::Ok(_n) => {
      info.size_download = info.size_download + (part.len() as i64);
      return Result<i32, Failure>::Ok(0);
    },
    Result<i32, Failure>::Err(f) => {
      info.size_download = info.size_download + (out.raw_in - before);
      return Result<i32, Failure>::Err(f);
    }
  }
}

/// Copy exactly `length` body bytes to `out`.
fn read_length(c : &mut Conn, length : i64, out : &mut Output, console : &mut Console,
info : &mut TransferInfo)
-> Result<i32, Failure> {
  let mut left = length;
  while left > 0i64 {
    let part = c.read_some(left)?;
    if part.len() == 0 {
      let mut m = lit("end of response with ");
      push_i64(&mut m, left);
      push_lit(&mut m, " bytes missing");
      return Result<i32, Failure>::Err(fail_with(PARTIAL_FILE, m));
    }
    left = left - (part.len() as i64);
    let _w = write_body(out, console, &part, info)?;
  }
  return Result<i32, Failure>::Ok(0);
}

/// Copy the body bytes to `out` until the peer closes the connection.
fn read_to_close(c : &mut Conn, out : &mut Output, console : &mut Console, info : &mut TransferInfo)
-> Result<i32, Failure> {
  loop {
    let part = c.read_some(1048576i64)?;
    if part.len() == 0 {
      return Result<i32, Failure>::Ok(0);
    }
    let _w = write_body(out, console, &part, info)?;
  }
}

/// The trailer line `t` as libcurl gives it: checked as a header line, and with CRLF at its end
/// even when the server sent only LF (curl's tests 1417 and 2106). A CR ends the line in
/// libcurl, so a CR that no LF follows is a bad chunk.
fn trailer_line(t : &Vec<u8>) -> Result<Vec<u8>, Failure> {
  let mut line = trim_newline(t);
  let nul = find_byte(&line, 0u8, 0);
  let cr = find_byte(&line, 13u8, 0);
  if cr >= 0 && (nul < 0 || cr < nul) {
    return Result<Vec<u8>, Failure>::Err(fail_lit(RECV_ERROR,
      "Malformed encoding found in chunked-encoding"));
  }
  push_lit(&mut line, "\r\n");
  let mut check = empty_head();
  if !line_is_clean(&line, &mut check) {
    return Result<Vec<u8>, Failure>::Err(fail_with(check.error_code, clone_bytes(&check.error)));
  }
  if !is_blank(line.get(0)) && find_byte(&line, 58u8, 0) < 0 {
    return Result<Vec<u8>, Failure>::Err(fail_lit(WEIRD_SERVER_REPLY, "Header without colon"));
  }
  return Result<Vec<u8>, Failure>::Ok(line);
}

fn bad_chunk() -> Failure {
  return fail_lit(RECV_ERROR, "Illegal or missing hexadecimal sequence in chunked-encoding");
}

/// Decode a chunked body and copy its data to `out`. The trailer headers go to `trailers`.
/// With `raw` (`--raw`), the chunk lines go to `out` as they arrived.
fn read_chunked(c : &mut Conn, out : &mut Output, console : &mut Console, info : &mut TransferInfo,
trailers : &mut Vec<u8>, raw : bool) -> Result<i32, Failure> {
  loop {
    let mut line = Vec<u8>::new();
    let n = c.read_line(&mut line, MAX_HEADER_LINE, RECV_ERROR,
      "Illegal or missing hexadecimal sequence in chunked-encoding")?;
    if n == 0 {
      return Result<i32, Failure>::Err(fail_lit(PARTIAL_FILE,
        "transfer closed with outstanding read data remaining"));
    }
    if raw {
      let _w = out.write(console, &line)?;
    }
    let mut size : i64 = 0i64;
    let mut digits = 0;
    let mut i = 0;
    while i < line.len() && hex_value(line.get(i)) >= 0 {
      // A size of 2^63 or more does not fit in an i64: one more digit would wrap it to a
      // negative length. 576460752303423487 is (2^63 - 1) / 16. curl refuses such a size too.
      if size > 576460752303423487i64 {
        let mut m = lit("invalid chunk size: '");
        append_range(&mut m, &line, 0, i + 1);
        push_lit(&mut m, "'");
        return Result<i32, Failure>::Err(fail_with(RECV_ERROR, m));
      }
      size = size * 16i64 + (hex_value(line.get(i)) as i64);
      digits = digits + 1;
      i = i + 1;
    }
    if digits == 0 || digits > 16 {
      return Result<i32, Failure>::Err(bad_chunk());
    }
    if size == 0i64 {
      let mut trailer_size : i64 = 0i64;
      loop {
        let mut t = Vec<u8>::new();
        let got = c.read_line(&mut t, MAX_TRAILER_LINE, TOO_LARGE,
          "Out of memory in chunked-encoding")?;
        trailer_size = trailer_size + (got as i64);
        if trailer_size > MAX_HEADERS_SIZE {
          let mut m = lit("Too large response headers: ");
          push_i64(&mut m, trailer_size);
          push_lit(&mut m, " > 307200");
          return Result<i32, Failure>::Err(fail_with(RECV_ERROR, m));
        }
        if raw {
          let _w = out.write(console, &t)?;
        }
        if got == 0 || eq_lit(&t, "\r\n") || eq_lit(&t, "\n") {
          return Result<i32, Failure>::Ok(0);
        }
        if !raw {
          let line = trailer_line(&t)?;
          append(trailers, &line);
        }
      }
    }
    let _copied = read_length(c, size, out, console, info)?;
    // The data of a chunk ends with CRLF, as curl requires. Any other byte there is an error.
    let mut end = Vec<u8>::new();
    let got = c.read_line(&mut end, 2, RECV_ERROR, "Malformed encoding found in chunked-encoding")?;
    if raw {
      let _w = out.write(console, &end)?;
    }
    if got == 0 {
      return Result<i32, Failure>::Err(fail_lit(PARTIAL_FILE,
        "transfer closed with outstanding read data remaining"));
    }
    if !eq_lit(&end, "\r\n") && !eq_lit(&end, "\n") {
      return Result<i32, Failure>::Err(fail_lit(RECV_ERROR,
        "Malformed encoding found in chunked-encoding"));
    }
  }
}

/// What one request and its response decided.
struct Hop {
  // The same request must go again, for authentication.
  retry : bool,
  // The response is a redirect that `-L` follows.
  follow : bool,
  status : i32,
  location : Vec<u8>,
}

/// Send one request for `u` and read its response. The body of the response goes to
/// `sinks`, unless curl follows the redirect that the response gives.
fn one_hop(network : &Network, tls : &TlsSettings, cfg : &Config, headers : &Vec<Vec<u8>>, u : &Url,
req_kind : i32, body : &Vec<u8>, creds : &Credential, scope : &Scope, same_host : bool,
has_referer : bool,
referer : &Vec<u8>, deadline : Instant, form_boundary : &Vec<u8>, auth : &mut AuthContext,
session : &mut Session, console : &mut Console, sinks : &mut Sinks, info : &mut TransferInfo,
opener : |&Vec<u8>, bool| -> Result<File, Failure>) -> Result<Hop, Failure> {
  let secure = eq_lit(&u.scheme, "https");
  let resume = sinks.resume_from;
  if resume != 0i64 && (req_kind == REQ_POST || req_kind == REQ_PUT) {
    return Result<Hop, Failure>::Err(fail_lit(BAD_FUNCTION_ARGUMENT, "HTTP upload cannot be resumed"));
  }
  let mut method = lit("GET");
  if cfg.has_method {
    method = clone_bytes(&cfg.method);
  } else {
    if req_kind == REQ_POST {
      method = lit("POST");
    }
    if req_kind == REQ_PUT {
      method = lit("PUT");
    }
    if req_kind == REQ_HEAD {
      method = lit("HEAD");
    }
  }
  info.method = clone_bytes(&method);
  info.referer = Vec<u8>::new();
  if has_referer {
    info.referer = clone_bytes(referer);
  }
  let proxy = proxy_for(console, cfg, u)?;
  let sends_body = req_kind == REQ_POST || req_kind == REQ_PUT;
  // A `-H "Transfer-Encoding: chunked"` header, or an upload from standard input, whose
  // length curl does not know, sends the body in chunks.
  let custom_chunked = custom_header_has(headers, "Transfer-Encoding", "chunked");
  let unknown_length = req_kind == REQ_PUT && sinks.upload_from_stdin
    && !has_custom(headers, "Content-Length");
  if unknown_length && info.received_http10 {
    // The server speaks HTTP/1.0, which has no chunks.
    return Result<Hop, Failure>::Err(fail_lit(UPLOAD_FAILED,
      "Chunky upload is not supported by HTTP 1.0"));
  }
  let chunked_upload = custom_chunked || (unknown_length && !cfg.http10);
  // The credentials go only where their scope allows (`server_credential`).
  let allowed = may_send(creds, u);
  let auth_header = output_auth(&mut auth.host, &mut auth.digest, creds, u, &u.path,
    has_custom(headers, "Authorization"), &method);
  // The credentials of an HTTP proxy go with each request that goes through it. The CONNECT of
  // a tunnel sends its own.
  let tunnel = tunnels(cfg, u, &proxy, secure)?;
  let via_proxy = proxy.used && is_http_proxy(proxy.kind) && !tunnel;
  let mut proxy_creds = no_credential(&proxy.url);
  if via_proxy {
    proxy_creds = clone_credential(&proxy.credential);
  }
  let proxy_allowed = may_send(&proxy_creds, &proxy.url);
  let proxy_header = output_auth(&mut auth.proxy, &mut auth.proxy_digest, &proxy_creds,
    &proxy.url, &u.path, has_custom(headers, "Proxy-Authorization"), &method);
  // Before Digest has its nonce, a POST or a PUT goes with an empty body, as a probe.
  let probe = needs_probe(auth) && sends_body;
  // The cookies of the engine that match the host and the path. `build_request` adds those of
  // `-b`, where the scope allows.
  let cookie_host = cookie_host_of(headers, u, same_host);
  let cookie_path = path_of(&u.path);
  let secure_context = secure || (!proxy.used && (eq_lit_nocase(&cookie_host, "localhost")
    || eq_lit(&cookie_host, "127.0.0.1") || eq_lit(&cookie_host, "::1")));
  let cookies = cookie_header(&session.jar, &cookie_host, &cookie_path, secure_context);
  let sends_body_now = sends_body && !probe;
  let mut body_length = -1i64;
  if sends_body {
    body_length = body.len() as i64;
  }
  if probe {
    body_length = 0i64;
  }
  let mut req_info = RequestInfo {
    method : method,
    kind : req_kind,
    body_length : body_length,
    http10 : cfg.http10 || info.received_http10,
    headers : clone_lines(headers),
    auth : auth_header,
    scope : clone_scope(scope),
    first_host : same_host,
    has_user_agent : cfg.has_user_agent,
    user_agent : clone_bytes(&cfg.user_agent),
    has_referer : has_referer,
    referer : clone_bytes(referer),
    has_range : cfg.has_range || resume > 0i64,
    range : range_of_request(cfg, resume),
    cookie : cookies,
    has_cookie_option : cfg.has_cookie,
    cookie_option : clone_bytes(&cfg.cookie),
    via_proxy : via_proxy,
    proxy : clone_url(&proxy.url),
    proxy_auth : proxy_header,
    chunked : sends_body_now && chunked_upload,
    add_chunked_header : sends_body_now && chunked_upload
      && !has_custom(headers, "Transfer-Encoding"),
    probe : probe,
    form_boundary : form_text(req_kind, form_boundary),
    h2 : false,
    accept_encoding : cfg.compressed,
    tr_encoding : cfg.tr_encoding
  };

  // `--unix-socket` needs no address: `--connect-to` and `--resolve` do not apply to it.
  let mut address = Vec<u8>::new();
  if proxy.used {
    // `--connect-to` is for the server, not for the proxy, as in curl.
    let proxy_host = resolve_rule(cfg, &proxy.url.host, proxy.url.port)?;
    address = address_of(&proxy_host, proxy.url.port);
  } else if !cfg.has_unix_socket {
    address = connect_address(cfg, u)?;
  }
  let via = via_target(cfg, u)?;
  let key = conn_key(cfg, u, &proxy, tunnel, &via);
  info.hop_start_download = info.size_download;
  info.expected_size = -1i64;
  let mut c = pooled_or_new(network, tls, cfg, u, &proxy, &address, secure, tunnel, &key,
    deadline, session, info, console, sinks)?;
  let mut h2 = new_h2();
  let mut use_h2 = false;
  let request_size = info.size_request;
  let header_total = info.size_header_total;
  let mut first = send_request(&mut c, &mut h2, &mut use_h2, cfg, u, secure, via_proxy,
    &mut req_info, body, sends_body_now, chunked_upload, deadline, info, console);
  if c.reused && connection_died(&first) && info.size_header_total == header_total {
    // The server closed the connection while it waited in the pool. As libcurl, send the
    // request again on a new connection.
    if cfg.verbose {
      verbose_info(console, &lit("Connection died, retrying a fresh connect (retry count: 1)"));
    }
    info.size_request = request_size;
    c = new_conn(network, tls, cfg, u, &proxy, &address, secure, tunnel, deadline, session,
      info, console, sinks)?;
    h2 = new_h2();
    first = send_request(&mut c, &mut h2, &mut use_h2, cfg, u, secure, via_proxy,
      &mut req_info, body, sends_body_now, chunked_upload, deadline, info, console);
  }
  let mut head = first?;
  // Skip each informational response, such as `100 Continue`. With `-i`, curl shows it.
  let mut set_cookies = take_cookies(&mut session.jar, &head, &cookie_host, &cookie_path,
    secure_context, 0);
  take_hsts(console, cfg, &mut session.hsts, &head, u, secure);
  while head.error_code == 0 && head.status >= 100 && head.status < 200 && head.status != 101 {
    info.size_header = info.size_header + (head.raw.len() as i64);
    if cfg.verbose {
      verbose_lines(console, "< ", &head.raw);
    }
    let _w = write_head(console, sinks, cfg.include, &head.raw)?;
    head = next_head(&mut c, &mut h2, use_h2, cfg.raw, cfg.tr_encoding,
      &mut info.size_header_total, true)?;
    set_cookies = take_cookies(&mut session.jar, &head, &cookie_host, &cookie_path,
      secure_context, set_cookies);
    take_hsts(console, cfg, &mut session.hsts, &head, u, secure);
  }
  if head.error_code != 0 {
    // curl writes the headers before the bad one, and stops.
    if cfg.include || cfg.head {
      let _w = sinks.body.write(console, &head.raw)?;
    }
    return Result<Hop, Failure>::Err(fail_with(head.error_code, clone_bytes(&head.error)));
  }
  if head.length_overflow && cfg.max_filesize > 0i64 && !has_no_body(head.status, req_kind) {
    return Result<Hop, Failure>::Err(fail_lit(FILESIZE_EXCEEDED, "Maximum file size exceeded"));
  }
  info.http_code = head.status;
  info.retry_after = retry_after_of(&head.headers);
  info.http_version = head.version;
  if head.version == 10 {
    info.received_http10 = true;
  }
  info.num_headers = head.headers.len();
  info.headers = clone_lines(&head.headers);
  for h in head.headers.iter() {
    info.all_headers.push(clone_bytes(h));
  }
  info.content_type = clone_bytes(&head.content_type);
  info.size_header = info.size_header + (head.raw.len() as i64);
  if head.content_length >= 0i64 && !head.has_transfer_encoding {
    info.expected_size = head.content_length;
  }
  if cfg.verbose {
    verbose_lines(console, "< ", &head.raw);
  }

  // The challenges of a 401, and whether to send the request again with credentials.
  if head.status == 401 || head.status == 407 {
    for line in head.headers.iter() {
      let colon = find_byte(line, 58u8, 0);
      if colon > 0 {
        let name = range_of(line, 0, colon);
        let value = trim_blanks(&rest_from(line, colon + 1));
        if head.status == 401 && eq_lit_nocase(&name, "WWW-Authenticate") {
          take_challenge(&value, &mut auth.host, &mut auth.digest, u, &mut auth.problem);
        }
        if head.status == 407 && eq_lit_nocase(&name, "Proxy-Authenticate") {
          take_challenge(&value, &mut auth.proxy, &mut auth.proxy_digest, &proxy.url,
            &mut auth.problem);
        }
      }
    }
  }
  let retry = auth_act(head.status, allowed, proxy_allowed, auth, probe, sends_body);

  let redirect = head.has_location && (head.status == 301 || head.status == 302
    || head.status == 303 || head.status == 307 || head.status == 308);
  let follow = cfg.follow && redirect && !retry;
  if redirect && !follow {
    match resolve_location(u, &head.location) {
      Result<Url, Failure>::Ok(target) => {
        info.has_redirect_url = true;
        info.redirect_url = url_text(&target);
      },
      Result<Url, Failure>::Err(_e) => {}
    }
  }

  // `-C`: as libcurl, a 416 to a resumed GET is no error (the file is complete), and the
  // Content-Range of the response must start at the offset.
  let resumed_get = resume > 0i64 && req_kind == REQ_GET;
  let range = content_range_of(&head.headers);
  if resumed_get && head.status == 416 && range.total >= 0i64 && range.total != resume {
    return Result<Hop, Failure>::Err(fail_lit(RANGE_ERROR,
      "Cannot resume: remote file size differs from offset"));
  }
  if cfg.remote_header_name && head.status >= 200 && head.status < 400 {
    take_header_name(&head, info);
  }
  let failed = !retry && !(resumed_get && head.status == 416)
    && auth_should_fail(head.status, cfg.fail || cfg.fail_with_body, allowed, proxy_allowed,
    auth.problem);
  // As libcurl, the head goes to the output before `-f` fails, for `-i` and `-D`.
  let _w = write_head(console, sinks, cfg.include || cfg.head, &head.raw)?;
  if failed && !cfg.fail_with_body {
    return Result<Hop, Failure>::Err(http_error(head.status));
  }


  // The body of a redirect that curl follows goes nowhere.
  let mut trailers = Vec<u8>::new();
  // curl does not wait for the body of a redirect that it follows when the connection closes
  // after it, or when the body has no known end.
  let unknown_end = (head.content_length < 0i64 || head.has_transfer_encoding) && !head.chunked;
  // The same goes for a response to a request that goes again for authentication.
  let again = follow || retry;
  let mut skip_body = again && (head.close || unknown_end);
  if resumed_get && !again && !has_no_body(head.status, req_kind) {
    let get_everything = range.other && head.status < 300;
    if head.status == 416 {
      // libcurl ignores the body of the 416.
      skip_body = true;
    } else if range.offset != resume && !get_everything {
      if head.content_length == resume {
        // "The entire document is already downloaded."
        skip_body = true;
      } else {
        return Result<Hop, Failure>::Err(fail_lit(RANGE_ERROR,
          "HTTP server does not seem to support byte ranges. Cannot resume."));
      }
    }
  }
  if !again && sinks.body.is_pending() {
    // The response that the output is for: the tool opens the file now, as curl does when the
    // body starts, with the name that a Content-Disposition or a Location gave for `-J`.
    let file = opener(&info.header_name, info.has_header_name)?;
    let _a = sinks.body.attach(file)?;
  }
  if !has_no_body(head.status, req_kind) && !skip_body {
    if again {
      let mut discard = null_output();
      let _b = body_of(&mut c, &mut h2, use_h2, &head, cfg.raw, &mut discard, console,
        info, &mut trailers)?;
    } else {
      // `--compressed` decodes the body as its Content-Encoding says.
      let mut encodings = Vec<u8>::new();
      if cfg.compressed && !cfg.raw {
        encodings = content_encodings(&head);
      }
      // `--max-filesize`: a Content-Length that is too large fails before the body, as in
      // libcurl, and the body itself may not grow past the limit, before or after decoding.
      let known_length = head.content_length >= 0i64 && !head.has_transfer_encoding;
      if cfg.max_filesize > 0i64 && known_length && head.content_length > cfg.max_filesize {
        return Result<Hop, Failure>::Err(fail_lit(FILESIZE_EXCEEDED, "Maximum file size exceeded"));
      }
      sinks.body.limit_body(cfg.max_filesize);
      let _stack = sinks.body.start_body(&head.transfer_codings, &encodings)?;
      let _b = body_of(&mut c, &mut h2, use_h2, &head, cfg.raw, &mut sinks.body,
        console, info, &mut trailers)?;
      info.size_delivered = info.size_delivered + sinks.body.finish_body()?;
    }
  }
  if trailers.len() > 0 {
    let _w = write_head(console, sinks, cfg.include, &trailers)?;
  }
  if failed {
    return Result<Hop, Failure>::Err(http_error(head.status));
  }
  // The connection stays open for the next request when the response ended where its head
  // said, and the server does not close the connection after it. securl keeps no HTTP/2
  // connection yet.
  let ended = has_no_body(head.status, req_kind) || !skip_body;
  let keep = !use_h2 && ended && !closes_after(&head, via_proxy) && c.is_idle();
  if cfg.verbose {
    if keep || use_h2 {
      let mut m = lit("Connection #");
      push_u64(&mut m, c.id as u64);
      push_lit(&mut m, " to host ");
      append(&mut m, &host_text(u));
      push_lit(&mut m, ":");
      push_u64(&mut m, u.port as u64);
      push_lit(&mut m, " left intact");
      verbose_info(console, &m);
    } else {
      verbose_info(console, &shutting_down(&c));
    }
  }
  if keep {
    session.pool.keep(key, c);
  }
  return Result<Hop, Failure>::Ok(Hop {
    retry : retry,
    follow : follow,
    status : head.status,
    location : clone_bytes(&head.location)
  });
}

/// The boundary of a form for a request of `kind`: a POST that a redirect turned into a GET has
/// none.
fn form_text(kind : i32, boundary : &Vec<u8>) -> Vec<u8> {
  if kind == REQ_POST {
    return clone_bytes(boundary);
  }
  return Vec<u8>::new();
}

/// The host that cookies are for: the host of a custom Host header on the first host (without
/// its port), or the host of the URL.
fn cookie_host_of(headers : &Vec<Vec<u8>>, u : &Url, first_host : bool) -> Vec<u8> {
  if first_host {
    for line in headers.iter() {
      let h = split_header(line);
      if !h.ignored && !h.remove && eq_lit_nocase(&h.name, "Host") {
        let v = trim_blanks(&h.value);
        if v.len() == 0 {
          return clone_bytes(&u.host);
        }
        if v.get(0) == 91u8 {
          let close = find_byte(&v, 93u8, 0);
          if close > 0 {
            return range_of(&v, 1, close);
          }
          return rest_from(&v, 1);
        }
        let colon = find_byte(&v, 58u8, 0);
        if colon >= 0 {
          return range_of(&v, 0, colon);
        }
        return v;
      }
    }
  }
  return clone_bytes(&u.host);
}

/// The path of a request target, without its query.
fn path_of(target : &Vec<u8>) -> Vec<u8> {
  let q = find_byte(target, 63u8, 0);
  if q >= 0 {
    return range_of(target, 0, q);
  }
  return clone_bytes(target);
}

/// Give each Set-Cookie header of `head` to the jar, up to libcurl's 50 for one request.
/// `count` is how many the request had so far. Gives the new count.
fn take_cookies(jar : &mut CookieJar, head : &ResponseHead, host : &Vec<u8>, path : &Vec<u8>,
secure : bool, count : i32) -> i32 {
  let mut n = count;
  if !jar.enabled {
    return n;
  }
  let mut flags = COOKIE_HTTPHEADER;
  if secure {
    flags = flags | COOKIE_SECURE;
  }
  for line in head.headers.iter() {
    let colon = find_byte(line, 58u8, 0);
    if colon > 0 && eq_lit_nocase(&range_of(line, 0, colon), "Set-Cookie") && n < 50 {
      add_cookie(jar, &trim_blanks(&rest_from(line, colon + 1)), true, host, path, flags);
      n = n + 1;
    }
  }
  return n;
}

/// Give each `Strict-Transport-Security` header of `head` to the HSTS cache, when the response
/// came over HTTPS. libcurl skips a header that it cannot read, and says so with `-v`.
fn take_hsts(console : &mut Console, cfg : &Config, hsts : &mut Hsts, head : &ResponseHead, u : &Url,
secure : bool) -> void {
  if !hsts.enabled || !secure {
    return;
  }
  for line in head.headers.iter() {
    if starts_lit_nocase(line, "Strict-Transport-Security:") {
      let value = rest_from(line, 26);
      if !hsts_header(hsts, &u.host, &value) && cfg.verbose {
        verbose_info(console, &lit("Illegal STS header skipped"));
      }
    }
  }
}

/// `u` over HTTPS when the HSTS cache says that its host must be reached that way, as
/// libcurl's `hsts_upgrade`. A port that the URL gives stays.
fn hsts_upgrade(console : &mut Console, cfg : &Config, hsts : &mut Hsts, u : Url) -> Url {
  if !eq_lit(&u.scheme, "http") || !hsts_applies(hsts, &u.host) {
    return u;
  }
  let mut up = u;
  up.scheme = lit("https");
  if !up.port_given {
    up.port = 443;
  }
  if cfg.verbose {
    let mut m = lit("Switched from HTTP to HTTPS due to HSTS => ");
    append(&mut m, &url_text(&up));
    verbose_info(console, &m);
  }
  return up;
}

// How many times one transfer sends a request again for authentication.
const MAX_AUTH_ROUNDS : i32 = 50;

/// The time limit of the connect phase: `--connect-timeout`, or the 300 seconds of libcurl.
fn connect_limit_ms(cfg : &Config) -> i64 {
  if cfg.connect_timeout_ms > 0i64 {
    return cfg.connect_timeout_ms;
  }
  return 300000i64;
}

/// The socket options of the command line, with the defaults of libcurl: keepalive after 60
/// seconds, every 60 seconds, 9 times. A time or count above the largest `int` is that `int`,
/// as in libcurl.
fn socket_options(cfg : &Config) -> SocketOptions {
  let mut time = 60i64;
  if cfg.keepalive_time > 0i64 {
    time = cfg.keepalive_time;
  }
  let mut count = 9i64;
  if cfg.keepalive_cnt > 0i64 {
    count = cfg.keepalive_cnt;
  }
  return SocketOptions {
    nodelay : cfg.tcp_nodelay,
    keepalive : cfg.keepalive,
    idle : int_of(time),
    interval : int_of(time),
    count : int_of(count)
  };
}

/// `n`, or the largest `i32` when it is larger.
fn int_of(n : i64) -> i32 {
  if n > 2147483647i64 {
    return 2147483647;
  }
  return n as i32;
}

/// The earlier of two deadlines.
fn earliest(a : Instant, b : Instant) -> Instant {
  if a < b {
    return a;
  }
  return b;
}

/// The place that `--connect-to` gives for `u` when it is not the server of `u` itself: curl's
/// "via peer".
fn via_target(cfg : &Config, u : &Url) -> Result<Option<Target>, Failure> {
  let target = connect_target(cfg, u)?;
  if eq_nocase(&target.host, &u.host) && target.port == u.port {
    return Result<Option<Target>, Failure>::Ok(Option<Target>::None());
  }
  return Result<Option<Target>, Failure>::Ok(Option<Target>::Some(target));
}

/// Whether the request goes through a CONNECT tunnel of an HTTP proxy: for HTTPS, with `-p`,
/// and, as in curl, whenever `--connect-to` sends it to another place.
fn tunnels(cfg : &Config, u : &Url, proxy : &Proxy, secure : bool) -> Result<bool, Failure> {
  if !proxy.used || !is_http_proxy(proxy.kind) {
    return Result<bool, Failure>::Ok(false);
  }
  if secure || cfg.proxytunnel {
    return Result<bool, Failure>::Ok(true);
  }
  return Result<bool, Failure>::Ok(via_target(cfg, u)?.is_some());
}

/// `host:port`, with brackets around an IPv6 address.
fn host_port_text(host : &Vec<u8>, port : i32) -> Vec<u8> {
  let mut m = Vec<u8>::new();
  if find_byte(host, 58u8, 0) >= 0 {
    push_lit(&mut m, "[");
    append(&mut m, host);
    push_lit(&mut m, "]");
  } else {
    append(&mut m, host);
  }
  push_lit(&mut m, ":");
  push_u64(&mut m, port as u64);
  return m;
}

/// `host:port`.
fn host_port(host : &Vec<u8>, port : i32) -> Vec<u8> {
  let mut m = clone_bytes(host);
  push_lit(&mut m, ":");
  push_u64(&mut m, port as u64);
  return m;
}

/// What the messages of a connect that failed name, as curl 8.23 does: the origin, which is the
/// proxy when an HTTP proxy forwards the request and else the server; `via` the place of
/// `--connect-to`; and `over proxy` the name of the proxy.
fn conn_names(cfg : &Config, u : &Url, proxy : &Proxy, tunnel : bool) -> Result<ConnNames, Failure> {
  let forwards = proxy.used && is_http_proxy(proxy.kind) && !tunnel;
  let mut label = Vec<u8>::new();
  if forwards {
    label = host_port(&proxy.url.host, proxy.url.port);
  } else {
    label = host_port(&u.host, u.port);
  }
  if proxy.used {
    push_lit(&mut label, " over proxy ");
    if proxy.unix_path.len() > 0 {
      append(&mut label, &proxy.unix_path);
    } else {
      append(&mut label, &proxy.url.host);
    }
  } else {
    match via_target(cfg, u)? {
      Option<Target>::Some(target) => {
        push_lit(&mut label, " via ");
        append(&mut label, &host_port(&target.host, target.port));
      },
      Option<Target>::None() => {}
    }
  }
  let mut host = clone_bytes(&u.host);
  if proxy.used {
    host = clone_bytes(&proxy.url.host);
  }
  return Result<ConnNames, Failure>::Ok(ConnNames {
    host : host,
    is_proxy : proxy.used,
    label : label
  });
}

/// Connect to `address`, then make the tunnel of a proxy and start TLS when `secure`. Each step
/// gives up at `deadline`.
fn connect_phase(network : &Network, tls : &TlsSettings, cfg : &Config, u : &Url, proxy : &Proxy,
address : &Vec<u8>, secure : bool, tunnel : bool, deadline : Instant, info : &mut TransferInfo,
console : &mut Console, sinks : &mut Sinks) -> Result<Conn, Failure> {
  let mut c = open_peer(network, cfg, u, proxy, address, tunnel, deadline, info, console)?;
  info.num_connects = info.num_connects + 1;
  if cfg.verbose {
    let mut m = lit("Connected to ");
    append(&mut m, &host_text(u));
    push_lit(&mut m, " port ");
    push_u64(&mut m, u.port as u64);
    verbose_info(console, &m);
  }
  // An HTTPS proxy speaks TLS, with ALPN for HTTP/1.1 only, as curl does without
  // `--proxy-http2`.
  if proxy.used && proxy.kind == PROXY_HTTPS {
    let _proxy_tls = c.start_tls(&tls.proxy, &proxy.url.host,
      host_is_address(&proxy.url.host, proxy.url.ipv6), false)?;
    if cfg.verbose {
      verbose_info(console, &lit("TLS handshake with the proxy done"));
    }
  }
  // A SOCKS proxy connects to the server. HTTPS through an HTTP proxy goes through a CONNECT
  // tunnel, and so does HTTP with `-p` or `--connect-to`.
  if proxy.used && is_socks(proxy.kind) {
    let request = socks_request(network, cfg, u, proxy)?;
    let _socks = socks_connect(&mut c, &request)?;
  }
  if tunnel {
    open_tunnel(&mut c, cfg, u, proxy, info, console, sinks)?;
  }
  if secure {
    // curl offers HTTP/2 over TLS unless `--http1.1` or `--http1.0` says no.
    let _tls = c.start_tls(&tls.server, &u.host, host_is_address(&u.host, u.ipv6),
      !cfg.no_h2 && !cfg.http10)?;
    if cfg.verbose {
      verbose_info(console, &lit("TLS handshake done"));
    }
  }
  return Result<Conn, Failure>::Ok(c);
}

/// Open the connection: to the socket file of `--unix-socket`, or else to `address`. With `-v`,
/// curl's line before the connect.
fn open_peer(network : &Network, cfg : &Config, u : &Url, proxy : &Proxy, address : &Vec<u8>,
tunnel : bool, deadline : Instant, info : &mut TransferInfo, console : &mut Console)
-> Result<Conn, Failure> {
  if cfg.has_unix_socket {
    let mut label = host_port_text(&u.host, u.port);
    push_lit(&mut label, " over unix://");
    append(&mut label, &cfg.unix_socket);
    let names = ConnNames {
      host : clone_bytes(&u.host),
      is_proxy : false,
      label : label
    };
    return open_unix_peer(network, cfg, &cfg.unix_socket, &names, deadline, info, console);
  }
  if proxy.unix_path.len() > 0 {
    let names = conn_names(cfg, u, proxy, tunnel)?;
    return open_unix_peer(network, cfg, &proxy.unix_path, &names, deadline, info, console);
  }
  if cfg.verbose {
    let mut m = lit("  Trying ");
    append(&mut m, address);
    push_lit(&mut m, "...");
    verbose_info(console, &m);
  }
  let names = conn_names(cfg, u, proxy, tunnel)?;
  let c = open_conn(network, address, &names, deadline, &socket_options(cfg))?;
  info.remote_address = clone_bytes(address);
  return Result<Conn, Failure>::Ok(c);
}

/// Open the connection to the Unix-domain socket at `path`. curl keeps the path where it keeps
/// an IP address, so `-v` and `%{remote_ip}` show at most 45 bytes of it, with port 0, or -1 in
/// `%{remote_port}`.
fn open_unix_peer(network : &Network, cfg : &Config, path : &Vec<u8>, names : &ConnNames,
deadline : Instant, info : &mut TransferInfo, console : &mut Console) -> Result<Conn, Failure> {
  let mut shown = clone_bytes(path);
  if shown.len() > 45 {
    shown = range_of(&shown, 0, 45);
  }
  if cfg.verbose {
    let mut m = lit("  Trying ");
    append(&mut m, &shown);
    push_lit(&mut m, ":0...");
    verbose_info(console, &m);
  }
  let c = open_unix_conn(network, path, names, deadline)?;
  info.remote_address = shown;
  push_lit(&mut info.remote_address, ":-1");
  return Result<Conn, Failure>::Ok(c);
}

/// A connection for a request with `key`: an open one from the pool, or else a new one.
fn pooled_or_new(network : &Network, tls : &TlsSettings, cfg : &Config, u : &Url, proxy : &Proxy,
address : &Vec<u8>, secure : bool, tunnel : bool, key : &ConnKey, deadline : Instant,
session : &mut Session, info : &mut TransferInfo, console : &mut Console, sinks : &mut Sinks)
-> Result<Conn, Failure> {
  loop {
    match session.pool.take(key) {
      Option<Conn>::Some(pooled) => {
        let mut c = pooled;
        if c.seems_alive() {
          c.reused = true;
          info.remote_address = clone_bytes(&c.remote_address);
          if cfg.verbose {
            verbose_info(console, &reusing(u, proxy));
          }
          return Result<Conn, Failure>::Ok(c);
        }
        if cfg.verbose {
          let mut m = lit("Connection ");
          push_u64(&mut m, c.id as u64);
          push_lit(&mut m, " seems to be dead, terminating");
          verbose_info(console, &m);
          verbose_info(console, &shutting_down(&c));
        }
      },
      Option<Conn>::None() => {
        return new_conn(network, tls, cfg, u, proxy, address, secure, tunnel, deadline, session,
          info, console, sinks);
      }
    }
  }
}

/// Open a new connection for the request.
fn new_conn(network : &Network, tls : &TlsSettings, cfg : &Config, u : &Url, proxy : &Proxy,
address : &Vec<u8>, secure : bool, tunnel : bool, deadline : Instant, session : &mut Session,
info : &mut TransferInfo, console : &mut Console, sinks : &mut Sinks) -> Result<Conn, Failure> {
  // The connect, the CONNECT of a proxy and the TLS handshake end at the deadline of
  // `--connect-timeout`, or at the deadline of `-m` when it is earlier.
  let started = Instant::now();
  let connect_deadline = earliest(deadline,
    deadline_after(Duration::from_millis(connect_limit_ms(cfg) as u64)));
  let mut c = connected(connect_phase(network, tls, cfg, u, proxy, address, secure, tunnel,
    connect_deadline, info, console, sinks), &started)?;
  c.id = session.pool.new_id();
  c.remote_address = clone_bytes(&info.remote_address);
  return Result<Conn, Failure>::Ok(c);
}

/// curl's line for `-v` when it reuses a connection.
fn reusing(u : &Url, proxy : &Proxy) -> Vec<u8> {
  let mut m = lit("Reusing existing ");
  append(&mut m, &u.scheme);
  push_lit(&mut m, ": connection with ");
  if proxy.used {
    push_lit(&mut m, "proxy ");
    append(&mut m, &proxy.url.host);
  } else {
    push_lit(&mut m, "host ");
    append(&mut m, &u.host);
  }
  return m;
}

/// curl's line for `-v` when a connection closes.
fn shutting_down(c : &Conn) -> Vec<u8> {
  let mut m = lit("shutting down connection #");
  push_u64(&mut m, c.id as u64);
  return m;
}

/// Send the request of `req_info` on `c`, with its body when `sends_body_now`, and read the
/// head of the first response. `use_h2` becomes whether the request went with HTTP/2.
fn send_request(c : &mut Conn, h2 : &mut H2, use_h2 : &mut bool, cfg : &Config, u : &Url,
secure : bool, via_proxy : bool, req_info : &mut RequestInfo, body : &Vec<u8>,
sends_body_now : bool, chunked_upload : bool, deadline : Instant, info : &mut TransferInfo,
console : &mut Console) -> Result<ResponseHead, Failure> {
  c.set_deadline(deadline);
  c.renew();
  if cfg.limit_rate > 0i64 {
    c.limit_rate(cfg.limit_rate);
  }
  // HTTP/2 when TLS chose it with ALPN, or with `--http2-prior-knowledge` on plain TCP.
  *use_h2 = c.is_h2() || (cfg.h2_prior_knowledge && !secure && !via_proxy);
  if c.version_seen == 10 {
    req_info.http10 = true;
  }
  if *use_h2 {
    req_info.h2 = true;
    req_info.chunked = false;
    req_info.add_chunked_header = false;
  }
  let request = build_request(u, req_info);
  if cfg.verbose {
    let shown = shown_request(&request, *use_h2);
    verbose_lines(console, "> ", &shown);
  }
  info.size_request = info.size_request + (request.len() as i64);
  // `%{size_upload}` is the body of this request. Chunks count with their framing, as in curl.
  info.size_upload = 0i64;
  if *use_h2 {
    let _start = h2_start(h2, c)?;
    let _sent = h2_send_request(h2, c, &request, &u.scheme, body, sends_body_now)?;
    if sends_body_now {
      info.size_upload = body.len() as i64;
    }
  } else {
    let _sent = c.send(&request)?;
    if sends_body_now {
      if chunked_upload {
        let chunks = chunk_encode(body);
        let _sent_body = c.send(&chunks)?;
        info.size_upload = chunks.len() as i64;
      } else {
        let _sent_body = c.send(body)?;
        info.size_upload = body.len() as i64;
      }
    }
  }
  info.size_request = info.size_request + info.size_upload;
  return next_head(c, h2, *use_h2, cfg.raw, cfg.tr_encoding, &mut info.size_header_total, false);
}

/// Whether a request on a reused connection failed as when the server closed the connection
/// before the request: libcurl then sends the request again on a new connection.
fn connection_died(r : &Result<ResponseHead, Failure>) -> bool {
  match r {
    Result<ResponseHead, Failure>::Ok(_head) => {
      return false;
    },
    Result<ResponseHead, Failure>::Err(f) => {
      return f.code == GOT_NOTHING || f.code == SEND_ERROR || f.code == RECV_ERROR;
    }
  }
}

/// Whether the server closes the connection after the response `head`, as libcurl reads it:
/// HTTP/1.0 closes unless `Connection: keep-alive` says otherwise, and HTTP/1.1 closes after
/// `Connection: close`. A response through an HTTP proxy can say the same with
/// `Proxy-Connection`.
fn closes_after(head : &ResponseHead, via_proxy : bool) -> bool {
  if via_proxy && head.version == 10 && head.proxy_keep_alive {
    return false;
  }
  if via_proxy && head.version == 11 && head.proxy_close {
    return true;
  }
  return head.close;
}

/// The result of `connect_phase`, with curl's message for a timeout in it.
fn connected(opened : Result<Conn, Failure>, started : &Instant) -> Result<Conn, Failure> {
  match opened {
    Result<Conn, Failure>::Ok(c) => {
      return Result<Conn, Failure>::Ok(c);
    },
    Result<Conn, Failure>::Err(f) => {
      if f.code != OPERATION_TIMEDOUT {
        return Result<Conn, Failure>::Err(f);
      }
      let mut m = lit("Connection timed out after ");
      push_u64(&mut m, started.elapsed().as_millis());
      push_lit(&mut m, " milliseconds");
      return Result<Conn, Failure>::Err(fail_with(OPERATION_TIMEDOUT, m));
    }
  }
}

/// `body` as one chunk and the last chunk, for `Transfer-Encoding: chunked`.
fn chunk_encode(body : &Vec<u8>) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  if body.len() > 0 {
    let mut digits = Vec<u8>::new();
    let mut n = body.len();
    while n > 0 {
      digits.push(ascii_lower(hex_digit((n % 16) as u8)));
      n = n / 16;
    }
    let mut i = digits.len() - 1;
    while i >= 0 {
      out.push(digits.get(i));
      i = i - 1;
    }
    push_lit(&mut out, "\r\n");
    append(&mut out, body);
    push_lit(&mut out, "\r\n");
  }
  push_lit(&mut out, "0\r\n\r\n");
  return out;
}

/// Whether a `-H` header called `name` has `word` in its value, in any case.
fn custom_header_has(headers : &Vec<Vec<u8>>, name : *const i8, word : *const i8) -> bool {
  for line in headers.iter() {
    let h = split_header(line);
    if !h.ignored && eq_lit_nocase(&h.name, name)
       && find_seq(&to_lower(&h.value), &lit(word), 0) >= 0 {
      return true;
    }
  }
  return false;
}

fn http_error(status : i32) -> Failure {
  let mut m = lit("The requested URL returned error: ");
  push_u64(&mut m, status as u64);
  return fail_with(HTTP_RETURNED_ERROR, m);
}

/// Whether `--noproxy` names `host`: `*`, the host itself, or a domain that it ends with.
fn no_proxy_for(list : &Vec<u8>, host : &Vec<u8>) -> bool {
  let mut start = 0;
  while start < list.len() {
    let mut end = find_byte(list, 44u8, start);
    if end < 0 {
      end = list.len();
    }
    let mut name = trim_blanks(&range_of(list, start, end));
    start = end + 1;
    if eq_lit(&name, "*") {
      return true;
    }
    if name.len() > 0 && name.get(0) == 46u8 {
      name = rest_from(&name, 1);
    }
    if name.len() == 0 || name.len() > host.len() {
      continue;
    }
    let tail_start = host.len() - name.len();
    if eq_nocase(&rest_from(host, tail_start), &name)
       && (tail_start == 0 || host.get(tail_start - 1) == 46u8) {
      return true;
    }
  }
  return false;
}

/// The first of the proxy variables `a` and `b` that is set, or an empty list. With `-v` it says
/// which one, as libcurl does. `b` may be empty, for no second variable.
fn proxy_env_value(console : &mut Console, cfg : &Config, a : *const i8, b : *const i8)
-> Vec<u8> {
  let mut k = 0;
  while k < 2 {
    let mut name = lit(a);
    if k == 1 {
      name = lit(b);
    }
    for var in cfg.proxy_env.iter() {
      if name.len() > 0 && same_bytes(&var.name, &name) {
        if cfg.verbose {
          let mut m = lit("Uses proxy env variable ");
          append(&mut m, &var.name);
          push_lit(&mut m, " == '");
          append(&mut m, &var.value);
          push_lit(&mut m, "'");
          verbose_info(console, &m);
        }
        return clone_bytes(&var.value);
      }
    }
    k = k + 1;
  }
  return Vec<u8>::new();
}

/// The proxy for a request to `u`, as libcurl chooses it. securl speaks only to HTTP proxies.
/// `--noproxy`, or else `no_proxy` or `NO_PROXY`, names the hosts that go direct. Then `-x`,
/// where an empty value means no proxy. Then the variables: `https_proxy` or `HTTPS_PROXY`
/// for HTTPS, `http_proxy` for HTTP, and last `all_proxy` or `ALL_PROXY`.
fn proxy_for(console : &mut Console, cfg : &Config, u : &Url) -> Result<Proxy, Failure> {
  let none = Proxy {
    used : false,
    kind : PROXY_HTTP,
    url : clone_url(u),
    credential : no_credential(u),
    unix_path : Vec<u8>::new()
  };
  // A Unix-domain socket goes to no proxy, and curl reads no proxy variables for it.
  if cfg.has_unix_socket {
    return Result<Proxy, Failure>::Ok(none);
  }
  let mut noproxy = clone_bytes(&cfg.noproxy);
  if !cfg.has_noproxy {
    noproxy = proxy_env_value(console, cfg, "no_proxy", "NO_PROXY");
  }
  if no_proxy_for(&noproxy, &u.host) {
    return Result<Proxy, Failure>::Ok(none);
  }
  let mut given = clone_bytes(&cfg.proxy);
  if !cfg.proxy_set {
    if eq_lit(&u.scheme, "https") {
      given = proxy_env_value(console, cfg, "https_proxy", "HTTPS_PROXY");
    } else {
      given = proxy_env_value(console, cfg, "http_proxy", "");
    }
    if given.len() == 0 {
      given = proxy_env_value(console, cfg, "all_proxy", "ALL_PROXY");
    }
  }
  if given.len() == 0 {
    return Result<Proxy, Failure>::Ok(none);
  }
  let mut text = clone_bytes(&given);
  // The kind of proxy comes from the scheme of its URL, or else from `--socks5` and the other
  // options that name a SOCKS proxy. A proxy from the environment is HTTP by default.
  let mut kind = PROXY_HTTP;
  if cfg.proxy_set {
    kind = cfg.proxy_kind;
  }
  let sep = find_seq(&text, &lit("://"), 0);
  if sep >= 0 {
    kind = proxy_kind_of_scheme(&range_of(&text, 0, sep));
    if kind < 0 {
      let mut m = lit("Unsupported proxy scheme for '");
      append(&mut m, &given);
      push_lit(&mut m, "'");
      return Result<Proxy, Failure>::Err(fail_with(COULDNT_CONNECT, m));
    }
    // The URL parser takes only http and https.
    text = lit_then("http", &rest_from(&text, sep));
  } else {
    text = lit_then("http://", &text);
  }
  // A proxy that is not a URL is exit 5, as in curl, which names the proxy as it was given.
  let parsed = parse_url(&text, false);
  let mut url = match parsed {
    Result<Url, Failure>::Ok(v) => { v },
    Result<Url, Failure>::Err(f) => {
      return Result<Proxy, Failure>::Err(proxy_syntax_failure(&given, &f));
    }
  };
  if !has_port_in(&text) {
    // libcurl's default ports for a proxy: 443 over TLS, and else 1080.
    url.port = 1080;
    if kind == PROXY_HTTPS {
      url.port = 443;
    }
  }
  let credential = proxy_credential(&url, cfg.has_proxy_user, &cfg.proxy_user);
  // A SOCKS proxy on the host `localhost` with a path is the Unix-domain socket at that path.
  let mut unix_path = Vec<u8>::new();
  if is_socks(kind) && eq_lit_nocase(&url.host, "localhost") {
    let path = percent_decode(&url.path);
    if path.len() > 0 && !eq_lit(&path, "/") {
      unix_path = path;
    }
  }
  return Result<Proxy, Failure>::Ok(Proxy {
    used : true,
    kind : kind,
    url : url,
    credential : credential,
    unix_path : unix_path
  });
}

/// curl's error for a proxy `given` that does not parse as a URL: `f` says why.
fn proxy_syntax_failure(given : &Vec<u8>, f : &Failure) -> Failure {
  let mut reason = clone_bytes(&f.message);
  if starts_lit(&reason, "URL rejected: ") {
    reason = rest_from(&reason, 14);
  }
  let mut m = lit("Unsupported proxy syntax in '");
  append(&mut m, given);
  push_lit(&mut m, "': ");
  append(&mut m, &reason);
  return fail_with(COULDNT_RESOLVE_PROXY, m);
}

/// Whether the authority of the URL `text` gives a port.
fn has_port_in(text : &Vec<u8>) -> bool {
  let start = find_seq(text, &lit("://"), 0) + 3;
  let mut end = find_byte(text, 47u8, start);
  if end < 0 {
    end = text.len();
  }
  let authority = range_of(text, start, end);
  let at = rfind_byte(&authority, 64u8);
  let host_port = rest_from(&authority, at + 1);
  let close = find_byte(&host_port, 93u8, 0);
  return find_byte(&host_port, 58u8, close + 1) >= 0;
}

/// Ask the HTTP proxy for a tunnel to the host of `u` with CONNECT, for HTTPS through a proxy
/// and for `-p`. The head of the reply goes to the output with `-i` and to the file of `-D`, as
/// in curl, unless `--suppress-connect-headers`.
fn open_tunnel(c : &mut Conn, cfg : &Config, u : &Url, proxy : &Proxy, info : &mut TransferInfo,
console : &mut Console, sinks : &mut Sinks) -> Result<i32, Failure> {
  let mut target = host_text(u);
  push_lit(&mut target, ":");
  push_u64(&mut target, u.port as u64);
  match via_target(cfg, u)? {
    Option<Target>::Some(t) => {
      target = host_port_text(&t.host, t.port);
    },
    Option<Target>::None() => {}
  }
  let request = build_connect_request(&target, &proxy.url,
    &connect_auth(&proxy.credential, &proxy.url), cfg.has_user_agent, &cfg.user_agent);
  if cfg.verbose {
    verbose_lines(console, "> ", &request);
  }
  let _sent = c.send(&request)?;
  // A reply that is no HTTP/1 status line is curl's "Invalid response header" (test 750).
  let head = read_head(c, false, false, &mut info.size_header_total,
    fail_lit(WEIRD_SERVER_REPLY, "Invalid response header"))?;
  if cfg.verbose {
    verbose_lines(console, "< ", &head.raw);
  }
  if head.error_code != 0 {
    return Result<i32, Failure>::Err(fail_with(head.error_code, clone_bytes(&head.error)));
  }
  info.size_header = info.size_header + (head.raw.len() as i64);
  info.http_connect = head.status;
  if !cfg.suppress_connect_headers {
    let _w = write_head(console, sinks, cfg.include, &head.raw)?;
  }
  if head.status == 407 {
    // libcurl reads the body of a 407 before it gives up, so that the connection could take
    // a retry with credentials. A body that it cannot read is a receive error.
    let mut discard = null_output();
    let mut scratch = new_info();
    let mut trailers = Vec<u8>::new();
    if head.chunked {
      if cfg.verbose {
        verbose_info(console, &lit("Ignore chunked response-body"));
      }
      let _b = read_chunked(c, &mut discard, console, &mut scratch, &mut trailers, false)?;
    } else if head.content_length > 0i64 && !head.has_transfer_encoding {
      if cfg.verbose {
        let mut m = lit("Ignore ");
        push_i64(&mut m, head.content_length);
        push_lit(&mut m, " bytes of response-body");
        verbose_info(console, &m);
      }
      let _b = read_length(c, head.content_length, &mut discard, console, &mut scratch)?;
    }
  }
  if head.status / 100 != 2 {
    let mut m = lit("CONNECT tunnel failed, response ");
    push_u64(&mut m, head.status as u64);
    return Result<i32, Failure>::Err(fail_with(COULDNT_CONNECT, m));
  }
  // A 2xx reply to CONNECT has no body.
  return Result<i32, Failure>::Ok(0);
}

/// Run the transfer of `url_text`. `body` is the request body for a POST or a PUT. `kind` is
/// `REQ_GET`, `REQ_POST`, `REQ_PUT` or `REQ_HEAD`. With `-m`, the whole transfer, redirects
/// included, has that time limit.
pub fn run_transfer(network : &Network, tls : &TlsSettings, cfg : &Config, headers : &Vec<Vec<u8>>,
url_text : &Vec<u8>, body : &Vec<u8>, kind : i32, form_boundary : &Vec<u8>, session : &mut Session,
console : &mut Console, sinks : &mut Sinks, info : &mut TransferInfo,
opener : |&Vec<u8>, bool| -> Result<File, Failure>) -> Result<i32, Failure> {
  let started = Instant::now();
  let mut deadline = Instant::never();
  if cfg.max_time_ms > 0i64 {
    deadline = deadline_after(Duration::from_millis(cfg.max_time_ms as u64));
  }
  match follow_redirects(network, tls, cfg, headers, url_text, body, kind, deadline, form_boundary,
    session, console, sinks, info, opener) {
    Result<i32, Failure>::Ok(n) => {
      return Result<i32, Failure>::Ok(n);
    },
    Result<i32, Failure>::Err(f) => {
      return Result<i32, Failure>::Err(timeout_message(f, &started, info));
    }
  }
}

/// `f` with curl's message when a time limit ended the transfer after the connect phase:
/// how long it took, and how many bytes of the body arrived.
fn timeout_message(f : Failure, started : &Instant, info : &TransferInfo) -> Failure {
  if f.code != OPERATION_TIMEDOUT || !eq_lit(&f.message, "Operation timed out") {
    return f;
  }
  let mut m = lit("Operation timed out after ");
  push_u64(&mut m, started.elapsed().as_millis());
  push_lit(&mut m, " milliseconds with ");
  push_i64(&mut m, info.size_download - info.hop_start_download);
  if info.expected_size >= 0i64 {
    push_lit(&mut m, " out of ");
    push_i64(&mut m, info.expected_size);
  }
  push_lit(&mut m, " bytes received");
  return fail_with(OPERATION_TIMEDOUT, m);
}

/// The transfer of `url_text`, and of each redirect that it follows, until `deadline`.
fn follow_redirects(network : &Network, tls : &TlsSettings, cfg : &Config,
headers : &Vec<Vec<u8>>, url_text : &Vec<u8>, body : &Vec<u8>, kind : i32, deadline : Instant,
form_boundary : &Vec<u8>, session : &mut Session, console : &mut Console, sinks : &mut Sinks,
info : &mut TransferInfo,
opener : |&Vec<u8>, bool| -> Result<File, Failure>) -> Result<i32, Failure> {
  let parsed = parse_url(url_text, cfg.path_as_is)?;
  let first = hsts_upgrade(console, cfg, &mut session.hsts, parsed);
  // Where the credentials of `-u` and the cookies of the user may go, for the whole transfer.
  let scope = transfer_scope(&first, cfg.location_trusted);
  let mut auth = new_auth_context(cfg.auth_type, cfg.proxy_auth_type);
  // A server that asks for new credentials again and again does not keep securl forever.
  let mut auth_rounds = 0;
  let first_port = first.port;
  let first_scheme = clone_bytes(&first.scheme);
  let first_host = clone_bytes(&first.host);
  let mut u = first;
  let mut req_kind = kind;
  let mut has_referer = cfg.has_referer;
  let mut referer = clone_bytes(&cfg.referer);
  let mut redirects = 0;
  loop {
    info.url_effective = url_text(&u);
    if !eq_lit(&u.scheme, "http") && !eq_lit(&u.scheme, "https") {
      let mut m = lit("Protocol \"");
      append(&mut m, &u.scheme);
      push_lit(&mut m, "\" not supported");
      return Result<i32, Failure>::Err(fail_with(UNSUPPORTED_PROTOCOL, m));
    }
    // A custom Host header goes only to the first host, with the same port and scheme.
    let same_host = eq_nocase(&u.host, &first_host) && u.port == first_port
      && eq_nocase(&u.scheme, &first_scheme);
    let creds = server_credential(&scope, cfg.has_user, &cfg.user, &u);
    let hop = one_hop(network, tls, cfg, headers, &u, req_kind, body, &creds, &scope, same_host,
      has_referer, &referer, deadline, form_boundary, &mut auth, session, console, sinks,
      info, opener)?;
    if hop.retry && auth_rounds < MAX_AUTH_ROUNDS {
      auth_rounds = auth_rounds + 1;
      continue;
    }
    if !hop.follow {
      return Result<i32, Failure>::Ok(0);
    }
    redirects = redirects + 1;
    if cfg.max_redirs >= 0i64 && (redirects as i64) > cfg.max_redirs {
      let mut m = lit("Maximum (");
      push_i64(&mut m, cfg.max_redirs);
      push_lit(&mut m, ") redirects followed");
      return Result<i32, Failure>::Err(fail_with(TOO_MANY_REDIRECTS, m));
    }
    let next = resolve_location(&u, &hop.location)?;
    let next_text = url_text(&next);
    if cfg.verbose {
      let mut m = lit("Issue another request to this URL: '");
      append(&mut m, &next_text);
      push_lit(&mut m, "'");
      verbose_info(console, &m);
    }
    // 301, 302 and 303 turn a POST into a GET, as browsers do. 303 turns a PUT into a GET too.
    // 307 and 308 keep the method and the body.
    let to_get = hop.status == 301 || hop.status == 302 || hop.status == 303;
    if req_kind == REQ_POST && to_get {
      req_kind = REQ_GET;
    }
    if req_kind == REQ_PUT && hop.status == 303 {
      req_kind = REQ_GET;
    }
    if cfg.auto_referer {
      has_referer = true;
      referer = url_text(&u);
    }
    u = hsts_upgrade(console, cfg, &mut session.hsts, next);
    info.num_redirects = redirects;
  }
}

/// The next response head, over HTTP/2 or HTTP/1. `informational` says that a 1xx response
/// came before it.
fn next_head(c : &mut Conn, h2 : &mut H2, use_h2 : bool, raw : bool, tr_encoding : bool,
total : &mut i64, informational : bool)
-> Result<ResponseHead, Failure> {
  if use_h2 {
    return h2_read_head(h2, c);
  }
  // A response that is no HTTP/1 response may be HTTP/0.9, which curl refuses. After a 1xx
  // response, or on a reused connection, it cannot be, so it is a bad response (curl's tests
  // 1479 and 1480).
  let mut bad_status = fail_lit(UNSUPPORTED_PROTOCOL, "Received HTTP/0.9 when not allowed");
  if informational || c.reused {
    bad_status = fail_lit(WEIRD_SERVER_REPLY, "Invalid status line");
  }
  let head = read_head(c, raw, tr_encoding, total, bad_status)?;
  c.version_seen = head.version;
  return Result<ResponseHead, Failure>::Ok(head);
}

/// Copy the body of the response to `out`, over HTTP/2 or HTTP/1. The trailers go to
/// `trailers`.
fn body_of(c : &mut Conn, h2 : &mut H2, use_h2 : bool, head : &ResponseHead, raw : bool,
out : &mut Output, console : &mut Console, info : &mut TransferInfo, trailers : &mut Vec<u8>)
-> Result<i32, Failure> {
  if !use_h2 {
    return read_body(c, head, raw, out, console, info, trailers);
  }
  loop {
    let part = h2_next_data(h2, c)?;
    if part.len() == 0 {
      append(trailers, &h2.trailers);
      return Result<i32, Failure>::Ok(0);
    }
    let _w = write_body(out, console, &part, info)?;
  }
}

fn read_body(c : &mut Conn, head : &ResponseHead, raw : bool, out : &mut Output,
console : &mut Console, info : &mut TransferInfo, trailers : &mut Vec<u8>) -> Result<i32, Failure> {
  if head.chunked {
    return read_chunked(c, out, console, info, trailers, raw);
  }
  if head.content_length >= 0i64 && !head.has_transfer_encoding {
    return read_length(c, head.content_length, out, console, info);
  }
  return read_to_close(c, out, console, info);
}

/// The values of the Content-Encoding headers of `head`, joined with commas.
fn content_encodings(head : &ResponseHead) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  for h in head.headers.iter() {
    let colon = find_byte(h, 58u8, 0);
    if colon > 0 && eq_lit_nocase(&trim_blanks(&range_of(h, 0, colon)), "Content-Encoding") {
      if out.len() > 0 {
        push_lit(&mut out, ",");
      }
      append(&mut out, &trim_blanks(&rest_from(h, colon + 1)));
    }
  }
  return out;
}

/// A copy of each line of `lines`.
pub fn clone_lines(lines : &Vec<Vec<u8>>) -> Vec<Vec<u8>> {
  let mut out = Vec<Vec<u8>>::new();
  for l in lines.iter() {
    out.push(clone_bytes(l));
  }
  return out;
}

/// The Retry-After header of a response in seconds from now, as libcurl reads it: an HTTP date,
/// or else a number of seconds, at most 6 hours. 0 when there is none, or a date in the past.
fn retry_after_of(headers : &Vec<Vec<u8>>) -> i64 {
  let mut out = 0i64;
  for line in headers.iter() {
    if starts_lit_nocase(line, "Retry-After:") {
      let value = trim_blanks(&rest_from(line, 12));
      out = 0i64;
      match parse_date(&value) {
        Option<i64>::Some(date) => {
          let now = unix_timestamp() as i64;
          if date >= now {
            out = date - now;
          }
        },
        Option<i64>::None() => {
          let mut n = 0i64;
          let mut i = 0;
          while i < value.len() && is_digit(value.get(i)) && n < 1000000000000i64 {
            n = n * 10i64 + ((value.get(i) - 48u8) as i64);
            i = i + 1;
          }
          out = n;
        }
      }
      if out > 21600i64 {
        out = 21600i64;
      }
    }
  }
  return out;
}

/// The range of a request: `N-` for `-C N`, or else the one of `-r`.
fn range_of_request(cfg : &Config, resume : i64) -> Vec<u8> {
  if resume > 0i64 {
    let mut r = Vec<u8>::new();
    push_i64(&mut r, resume);
    r.push(45u8);
    return r;
  }
  return clone_bytes(&cfg.range);
}

/// The Content-Range header of a response, as libcurl reads it: the first byte of the range
/// (`offset`), or the total of `*/total` (`total`), or a value with neither (`other`).
struct ContentRange {
  offset : i64,
  total : i64,
  other : bool,
}

fn content_range_of(headers : &Vec<Vec<u8>>) -> ContentRange {
  let mut out = ContentRange {
    offset : -1i64,
    total : -1i64,
    other : false
  };
  for line in headers.iter() {
    if !starts_lit_nocase(line, "Content-Range:") {
      continue;
    }
    let v = rest_from(line, 14);
    let mut i = 0;
    while i < v.len() && !is_digit(v.get(i)) && v.get(i) != 42u8 {
      i = i + 1;
    }
    if i < v.len() && is_digit(v.get(i)) {
      out.offset = leading_number(&v, i);
    } else if i + 1 < v.len() && v.get(i) == 42u8 && v.get(i + 1) == 47u8 {
      let start = i + 2;
      let mut end = start;
      while end < v.len() && is_digit(v.get(end)) {
        end = end + 1;
      }
      let mut k = end;
      while k < v.len() && is_blank(v.get(k)) {
        k = k + 1;
      }
      if end > start && (k == v.len() || v.get(k) == 13u8 || v.get(k) == 10u8) {
        out.total = leading_number(&v, start);
      }
    } else {
      out.other = true;
    }
  }
  return out;
}

/// The decimal number at `at` of `v`, up to the first byte that is not a digit.
fn leading_number(v : &Vec<u8>, at : i32) -> i64 {
  let mut n = 0i64;
  let mut i = at;
  while i < v.len() && is_digit(v.get(i)) && n < 922337203685477580i64 {
    n = n * 10i64 + ((v.get(i) - 48u8) as i64);
    i = i + 1;
  }
  return n;
}

/// `-J`: the file name of a response head, as curl's `content_disposition`: the Location of a
/// redirect gives one until a Content-Disposition with a `filename=` gives the last one.
fn take_header_name(head : &ResponseHead, info : &mut TransferInfo) -> void {
  for line in head.headers.iter() {
    if info.header_name_final {
      return;
    }
    if head.status >= 300 && starts_lit_nocase(line, "Location:") {
      let value = trim_start_blanks(&rest_from(line, 9));
      match file_name_of(&value, 0u8) {
        Option<Vec<u8>>::Some(name) => {
          info.header_name = name;
          info.has_header_name = true;
        },
        Option<Vec<u8>>::None() => {}
      }
      continue;
    }
    if line.len() > 20 && starts_lit_nocase(line, "Content-disposition:") {
      // The `filename=` parameter. Encoded names (`filename*=`) are not taken, as in curl.
      let mut p = 20;
      loop {
        while p < line.len() && !is_alpha(line.get(p)) {
          p = p + 1;
        }
        if p + 9 > line.len() {
          break;
        }
        if !eq_lit(&range_of(line, p, p + 9), "filename=") {
          while p < line.len() && line.get(p) != 59u8 {
            p = p + 1;
          }
          if p < line.len() {
            continue;
          }
          break;
        }
        let value = trim_start_blanks(&rest_from(line, p + 9));
        match file_name_of(&value, 59u8) {
          Option<Vec<u8>>::Some(name) => {
            info.header_name = name;
            info.has_header_name = true;
            info.header_name_final = true;
          },
          Option<Vec<u8>>::None() => {}
        }
        break;
      }
    }
  }
}

fn is_alpha(b : u8) -> bool {
  return (b >= 65u8 && b <= 90u8) || (b >= 97u8 && b <= 122u8);
}

fn trim_start_blanks(v : &Vec<u8>) -> Vec<u8> {
  let mut i = 0;
  while i < v.len() && (v.get(i) == 32u8 || v.get(i) == 9u8) {
    i = i + 1;
  }
  return rest_from(v, i);
}

/// The file name in the value `v` of a header, as curl's `parse_filename`: for a
/// Content-Disposition (`stop` is `;`), up to the stop byte or the end of its quotes; for a
/// Location (`stop` is 0), without the query and the fragment. Only the part after the last
/// `/` or `\\` counts. None for an empty name, `.` or `..`.
fn file_name_of(v : &Vec<u8>, stop : u8) -> Option<Vec<u8>> {
  let mut p = clone_bytes(v);
  if stop != 0u8 {
    let mut end_byte = stop;
    if p.len() > 0 && (p.get(0) == 39u8 || p.get(0) == 34u8) {
      end_byte = p.get(0);
      p = rest_from(&p, 1);
    }
    let q = find_byte(&p, end_byte, 0);
    if q >= 0 {
      p = range_of(&p, 0, q);
    }
  } else {
    let q = find_byte(&p, 63u8, 0);
    if q >= 0 {
      p = range_of(&p, 0, q);
    }
    let h = find_byte(&p, 35u8, 0);
    if h >= 0 {
      p = range_of(&p, 0, h);
    }
  }
  let slash = rfind_byte(&p, 47u8);
  if slash >= 0 {
    p = rest_from(&p, slash + 1);
  }
  let back = rfind_byte(&p, 92u8);
  if back >= 0 {
    p = rest_from(&p, back + 1);
  }
  let cr = find_byte(&p, 13u8, 0);
  if cr >= 0 {
    p = range_of(&p, 0, cr);
  }
  let lf = find_byte(&p, 10u8, 0);
  if lf >= 0 {
    p = range_of(&p, 0, lf);
  }
  if p.len() == 0 || eq_lit(&p, ".") || eq_lit(&p, "..") {
    return Option<Vec<u8>>::None();
  }
  return Option<Vec<u8>>::Some(p);
}
