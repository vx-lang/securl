// Checks how securl::options reads a command line.
import core::result;
import std::vec;
import sys::text;
import securl::bytes;
import securl::failure;
import securl::options;

fn words(a : *const i8, b : *const i8, c : *const i8, d : *const i8, e : *const i8) -> Vec<Vec<u8>> {
  let mut v = Vec<Vec<u8>>::new();
  v.push(lit(a));
  v.push(lit(b));
  v.push(lit(c));
  v.push(lit(d));
  v.push(lit(e));
  return v;
}

fn parsed(args : &Vec<Vec<u8>>) -> Config {
  match parse_args(args) {
    Result<Config, Failure>::Ok(c) => {
      return c;
    },
    Result<Config, Failure>::Err(_f) => {
      panic("a command line that should parse did not");
    }
  }
}

fn error_of(args : &Vec<Vec<u8>>) -> Vec<u8> {
  match parse_args(args) {
    Result<Config, Failure>::Ok(_c) => {
      return lit("no error");
    },
    Result<Config, Failure>::Err(f) => {
      assert(f.code == FAILED_INIT, "a bad option gives exit code 2");
      return f.message;
    }
  }
}

fn main() -> i32 {
  let a = parsed(&words("-sSL", "-ofile.txt", "-H", "X-A: 1", "http://h/"));
  assert(a.silent && a.show_error && a.follow, "a cluster of short options");
  assert(a.outputs.len() == 1 && eq_lit(a.outputs.get_ref(0), "file.txt"), "-o glued value");
  assert(a.headers.len() == 1 && eq_lit(a.headers.get_ref(0), "X-A: 1"), "-H value");
  assert(a.urls.len() == 1 && eq_lit(a.urls.get_ref(0), "http://h/"), "one URL");

  let b = parsed(&words("--location", "--no-location", "-d", "a=1", "-i"));
  assert(b.include, "-i");
  assert(!b.follow, "--no-location turns -L off");
  assert(b.data.len() == 1 && b.data.get_ref(0).kind == DATA_ASCII, "-d is ASCII data");

  let c = parsed(&words("-X", "PUT", "--max-time", "2.5", "-e;auto"));
  assert(eq_lit(&c.method, "PUT"), "-X");
  assert(c.max_time_ms == 2500i64, "2.5 seconds");
  assert(c.auto_referer && !c.has_referer, "-e ;auto alone");

  assert(eq_lit(&error_of(&words("--bogus", "a", "b", "c", "d")), "option --bogus: is unknown"),
    "an unknown long option");
  assert(eq_lit(&error_of(&words("-Z", "a", "b", "c", "d")), "option -Z: is unknown"),
    "an unknown short option");
  assert(eq_lit(&error_of(&words("a", "b", "c", "d", "-H")), "option -H: requires parameter"),
    "a missing value");

  // TCP options: TCP_NODELAY and keepalive are on unless the command line says no.
  let d = parsed(&words("http://h/", "-s", "-s", "-s", "-s"));
  assert(d.tcp_nodelay && d.keepalive && d.keepalive_time == 0i64 && d.keepalive_cnt == 0i64,
    "the defaults of curl");
  let e = parsed(&words("--no-tcp-nodelay", "--no-keepalive", "--keepalive-time", "17", "-s"));
  assert(!e.tcp_nodelay && !e.keepalive && e.keepalive_time == 17i64, "--no- and a time");
  let f = parsed(&words("--keepalive-cnt", "3", "--keepalive-time", "-0", "--keepalive"));
  assert(f.keepalive && f.keepalive_cnt == 3i64 && f.keepalive_time == 0i64, "a count, and -0");
  assert(eq_lit(&error_of(&words("--keepalive-time", "-5", "a", "b", "c")),
    "option --keepalive-time: expected a positive numerical parameter"), "a negative time");
  assert(eq_lit(&error_of(&words("--keepalive-cnt", " 5", "a", "b", "c")),
    "option --keepalive-cnt: expected a proper numerical parameter"), "a blank before the number");
  assert(eq_lit(&error_of(&words("--keepalive-time", "5x", "a", "b", "c")),
    "option --keepalive-time: expected a proper numerical parameter"), "a letter after it");
  assert(eq_lit(&error_of(&words("--keepalive-time", "99999999999999999999", "a", "b", "c")),
    "option --keepalive-time: expected a proper numerical parameter"), "a number too large");
  assert(eq_lit(&error_of(&words("--keepalive-time", "", "a", "b", "c")),
    "option --keepalive-time: expected a proper numerical parameter"), "no number");

  return 0;
}
