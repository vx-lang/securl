// TLS through OpenSSL, and one stream type for plain TCP and TLS connections.
//
// TRUSTED CODE. Each OpenSSL call is an `extern` function. The rest of securl sees only safe
// functions: `TlsConfig::new`, `NetStream::plain`, `start_tls`, `read` and `write_all`.
//
// Rights. `TlsConfig::new` reads the certificates of the certificate authorities from files,
// so it takes a `&Files`. `main` makes the `TlsConfig` and lends it to the transfer, which then
// needs no file right. A TLS connection starts from a `TcpStream`, which needs the network
// right.
//
// The sockets of `std::net` do not block: a read that has to wait parks the task. OpenSSL works
// on the file descriptor of the socket, so it gives "want read" or "want write" when the socket
// is not ready. Then this file waits with `poll` and tries again.
//
// Time limits. Each `NetStream` has a deadline, which the caller sets. A wait of the
// `TcpStream` runs in `std::sync::wait::within`, so it gives `NetError::Cancelled` at the
// deadline. `poll` does not know the deadline, so this file polls in short slices and checks
// the clock between them. A wait that passes the deadline gives `CURLE_OPERATION_TIMEDOUT`.
// The connect, before there is a `NetStream`, is in `securl::conn`.
import core::option;
import core::ptr;
import core::result;
import core::time;
import std::fs;
import std::net;
import std::sync::wait;
import std::time;
import std::vec;
import sys::text;

extern "C" {
  fn TLS_client_method() -> *mut i8;
  fn SSL_CTX_new(method : *mut i8) -> *mut i8;
  fn SSL_CTX_free(ctx : *mut i8) -> void;
  fn SSL_CTX_ctrl(ctx : *mut i8, cmd : i32, larg : i64, parg : *mut i8) -> i64;
  fn SSL_CTX_set_verify(ctx : *mut i8, mode : i32, callback : *mut i8) -> void;
  fn SSL_CTX_load_verify_file(ctx : *mut i8, file : *const i8) -> i32;
  fn SSL_CTX_load_verify_dir(ctx : *mut i8, dir : *const i8) -> i32;
  fn SSL_CTX_set_default_verify_paths(ctx : *mut i8) -> i32;
  fn SSL_CTX_use_certificate_chain_file(ctx : *mut i8, file : *const i8) -> i32;
  fn SSL_CTX_use_certificate_file(ctx : *mut i8, file : *const i8, kind : i32) -> i32;
  fn SSL_CTX_use_PrivateKey_file(ctx : *mut i8, file : *const i8, kind : i32) -> i32;
  fn SSL_CTX_check_private_key(ctx : *mut i8) -> i32;
  // OpenSSL's default password callback takes the password from this pointer.
  fn SSL_CTX_set_default_passwd_cb_userdata(ctx : *mut i8, password : *mut i8) -> void;
  fn SSL_new(ctx : *mut i8) -> *mut i8;
  fn SSL_free(ssl : *mut i8) -> void;
  fn SSL_set_fd(ssl : *mut i8, fd : i32) -> i32;
  fn SSL_ctrl(ssl : *mut i8, cmd : i32, larg : i64, parg : *const i8) -> i64;
  fn SSL_set1_host(ssl : *mut i8, host : *const i8) -> i32;
  fn SSL_get0_param(ssl : *mut i8) -> *mut i8;
  fn X509_VERIFY_PARAM_set1_ip_asc(param : *mut i8, ip : *const i8) -> i32;
  fn SSL_set_alpn_protos(ssl : *mut i8, protos : *const u8, len : u32) -> i32;
  // The protocol that ALPN chose: `data` gets a pointer to its bytes, and `len` their number.
  fn SSL_get0_alpn_selected(ssl : *const i8, data : *mut u64, len : *mut u32) -> void;
  fn SSL_connect(ssl : *mut i8) -> i32;
  fn SSL_read(ssl : *mut i8, buffer : *mut u8, len : i32) -> i32;
  fn SSL_write(ssl : *mut i8, buffer : *const u8, len : i32) -> i32;
  fn SSL_shutdown(ssl : *mut i8) -> i32;
  fn SSL_get_error(ssl : *mut i8, ret : i32) -> i32;
  fn SSL_get_verify_result(ssl : *mut i8) -> i64;
  fn X509_verify_cert_error_string(code : i64) -> *const i8;
  fn ERR_get_error() -> u64;
  fn ERR_clear_error() -> void;
  fn ERR_error_string_n(code : u64, buffer : *mut i8, len : u64) -> void;
  // `fds` points at one `struct pollfd`: an `int` file descriptor, then the `short` events and
  // the `short` events that happened. Two `i32` values hold it on a little-endian machine.
  fn poll(fds : *mut i32, count : u64, timeout_ms : i32) -> i32;
  fn OpenSSL_version(kind : i32) -> *const i8;
}

/// The TLS library and its version, such as `OpenSSL/3.5.9`, for `securl --version`.
pub fn tls_library_version() -> Vec<u8> {
  // OpenSSL_version(0) gives text such as "OpenSSL 3.5.9 30 Sep 2025".
  let text = bytes_of_c_string(unsafe { OpenSSL_version(0) });
  let mut out = Vec<u8>::new();
  let mut spaces = 0;
  for b in text.iter() {
    if *b == 32u8 {
      spaces = spaces + 1;
      if spaces == 1 {
        out.push(47u8);
      }
    } else {
      if spaces < 2 {
        out.push(*b);
      }
    }
  }
  return out;
}

// Values from the OpenSSL headers.
const SSL_CTRL_SET_MIN_PROTO_VERSION : i32 = 123;
const SSL_CTRL_SET_TLSEXT_HOSTNAME : i32 = 55;
const TLSEXT_NAMETYPE_HOST_NAME : i64 = 0i64;
const TLS1_2_VERSION : i64 = 771i64;
const SSL_VERIFY_NONE : i32 = 0;
const SSL_VERIFY_PEER : i32 = 1;
const SSL_ERROR_SSL : i32 = 1;
const SSL_ERROR_WANT_READ : i32 = 2;
const SSL_ERROR_WANT_WRITE : i32 = 3;
const SSL_ERROR_SYSCALL : i32 = 5;
const SSL_ERROR_ZERO_RETURN : i32 = 6;
const POLLIN : i32 = 1;
const POLLOUT : i32 = 4;

// The exit codes of curl for TLS errors.
const CURLE_SEND_ERROR : i32 = 55;
const CURLE_RECV_ERROR : i32 = 56;
const CURLE_SSL_CONNECT_ERROR : i32 = 35;
const CURLE_PEER_FAILED_VERIFICATION : i32 = 60;
const CURLE_SSL_CACERT_BADFILE : i32 = 77;
const CURLE_SSL_CERTPROBLEM : i32 = 58;
const CURLE_BAD_FUNCTION_ARGUMENT : i32 = 43;

// The file types of OpenSSL.
const SSL_FILETYPE_PEM : i32 = 1;
const SSL_FILETYPE_ASN1 : i32 = 2;
const CURLE_OPERATION_TIMEDOUT : i32 = 28;

// How long one `poll` waits before this file checks the time limit again, in milliseconds.
const POLL_SLICE_MS : i32 = 20;

/// Why a TLS step did not work: curl's exit code for it, and its message.
struct TlsError {
  code : i32,
  message : Vec<u8>,
}

fn tls_error(code : i32, message : Vec<u8>) -> TlsError {
  return TlsError {
    code : code,
    message : message
  };
}

/// A NUL-terminated copy of `bytes`, for OpenSSL. None when `bytes` holds a NUL byte.
fn c_string(bytes : &Vec<u8>) -> Option<Vec<i8>> {
  let mut out = Vec<i8>::new();
  for b in bytes.iter() {
    if *b == 0u8 {
      return Option<Vec<i8>>::None();
    }
    out.push(*b as i8);
  }
  out.push(0i8);
  return Option<Vec<i8>>::Some(out);
}

/// The bytes of a C string that OpenSSL owns.
fn bytes_of_c_string(p : *const i8) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  if is_null(p) {
    return out;
  }
  let mut i : i64 = 0i64;
  loop {
    let b = unsafe { p[i] } as u8;
    if b == 0u8 {
      return out;
    }
    out.push(b);
    i = i + 1i64;
  }
}

/// The text of the oldest error in the error queue of OpenSSL, and an empty queue.
fn openssl_error_text() -> Vec<u8> {
  let error = take_openssl_error();
  return error.text;
}

/// The oldest error of OpenSSL: its code, and its text such as "error:0A000126:...".
struct OpenSslError {
  code : u64,
  text : Vec<u8>,
}

/// Take the oldest error from the error queue of OpenSSL, and empty the queue.
fn take_openssl_error() -> OpenSslError {
  let code = unsafe { ERR_get_error() };
  unsafe { ERR_clear_error(); }
  if code == 0u64 {
    return OpenSslError {
      code : 0u64,
      text : Vec<u8>::new()
    };
  }
  let mut buffer = unsafe { Vec<i8>::zeroed(256) };
  unsafe { ERR_error_string_n(code, buffer.as_mut_ptr(), 256u64); }
  return OpenSslError {
    code : code,
    text : bytes_of_c_string(buffer.as_mut_ptr() as *const i8)
  };
}

/// The decimal text of `v`.
fn u64_text(v : u64) -> Vec<u8> {
  let mut digits = Vec<u8>::new();
  let mut n = v;
  loop {
    digits.push(48u8 + ((n % 10u64) as u8));
    n = n / 10u64;
    if n == 0u64 {
      break;
    }
  }
  let mut out = Vec<u8>::new();
  let mut i = digits.len() - 1;
  while i >= 0 {
    out.push(digits.get(i));
    i = i - 1;
  }
  return out;
}

/// The `errno` of a system error of OpenSSL 3, which sets the top bit of the code and keeps the
/// error number in the rest, or 0.
fn errno_of(code : u64) -> u64 {
  if code >= 2147483648u64 && code < 4294967296u64 {
    return code - 2147483648u64;
  }
  return 0u64;
}

/// curl's message for an error of SSL_read with the text `detail` of OpenSSL, such as
/// "OpenSSL SSL_read: OpenSSL/3.5.9: error:0A000126:..., errno 0".
fn read_error(detail : &Vec<u8>) -> TlsError {
  let mut m = lit("OpenSSL SSL_read: ");
  push_bytes(&mut m, &tls_library_version());
  push_bytes(&mut m, &lit(": "));
  push_bytes(&mut m, detail);
  push_bytes(&mut m, &lit(", errno 0"));
  return tls_error(CURLE_RECV_ERROR, m);
}

/// Wait until `fd` is ready for a read (`POLLIN`) or a write (`POLLOUT`). Gives false when
/// `deadline` passed first.
fn wait_for(fd : i32, events : i32, deadline : Instant) -> bool {
  let mut pollfd = Vec<i32>::new();
  pollfd.push(fd);
  pollfd.push(events);
  loop {
    if cancelled() || past_deadline(deadline) {
      return false;
    }
    let n = unsafe { poll(pollfd.as_mut_ptr(), 1u64, POLL_SLICE_MS) };
    if n != 0 {
      // Ready, or an error that the next call of OpenSSL reports.
      return true;
    }
  }
}

/// `tcp.read(buffer)`, which gives up at `deadline`.
fn read_by(tcp : &mut TcpStream, buffer : &mut Vec<u8>, deadline : Instant)
-> Result<u64, NetError> {
  if deadline == Instant::never() {
    return tcp.read(buffer);
  }
  if past_deadline(deadline) {
    return Result<u64, NetError>::Err(NetError::Cancelled);
  }
  return within(deadline - Instant::now(), || -> Result<u64, NetError> {
    return tcp.read(buffer);
  });
}

/// `tcp.write_all(bytes)`, which gives up at `deadline`.
fn write_all_by(tcp : &mut TcpStream, bytes : &Vec<u8>, deadline : Instant)
-> Result<u64, NetError> {
  if deadline == Instant::never() {
    return tcp.write_all(bytes);
  }
  if past_deadline(deadline) {
    return Result<u64, NetError>::Err(NetError::Cancelled);
  }
  return within(deadline - Instant::now(), || -> Result<u64, NetError> {
    return tcp.write_all(bytes);
  });
}

/// Whether ALPN chose `h2` on the connection `ssl`.
fn alpn_is_h2(ssl : *mut i8) -> bool {
  let mut data = Vec<u64>::new();
  data.push(0u64);
  let mut len = Vec<u32>::new();
  len.push(0u32);
  unsafe { SSL_get0_alpn_selected(ssl as *const i8, data.as_mut_ptr(), len.as_mut_ptr()); }
  if len.get(0) != 2u32 || data.get(0) == 0u64 {
    return false;
  }
  // OpenSSL keeps the two bytes as long as the connection lives.
  let first = unsafe { *(data.get(0) as *const u8) };
  let second = unsafe { *add(data.get(0) as *const u8, 1usize) };
  return first == 104u8 && second == 50u8;
}

/// The error of a wait that the time limit ended.
fn timed_out() -> TlsError {
  return tls_error(CURLE_OPERATION_TIMEDOUT, lit("Operation timed out"));
}

/// The error of a failed read or write of a plain `TcpStream`: `code` and `message`, or a
/// timeout when the time limit ended the wait.
fn tcp_error(e : NetError, code : i32, message : *const i8) -> TlsError {
  match e {
    NetError::Cancelled() => {
      return timed_out();
    },
    _ => {
      return tls_error(code, lit(message));
    }
  }
}

/// The settings of TLS that all connections of a run share: the certificate authorities that
/// securl trusts, and whether it checks the certificate of the server at all.
struct TlsConfig {
  ctx : *mut i8,
  verify : bool,
  // The certificate authorities could not be loaded. A TLS connection that checks the server
  // fails with this error.
  has_ca_error : bool,
  ca_error : Vec<u8>,
  // The client certificate could not be loaded. Each TLS connection fails with this error.
  has_cert_error : bool,
  cert_error : TlsError,

  invariant true,
}

/// The client certificate of `--cert`, `--key`, `--pass`, `--cert-type` and `--key-type`.
/// An empty type is PEM, and an empty `key` means that the key is in the file of `cert`.
struct ClientCert {
  cert : Vec<u8>,
  cert_type : Vec<u8>,
  key : Vec<u8>,
  key_type : Vec<u8>,
  has_pass : bool,
  pass : Vec<u8>,
}

/// The OpenSSL file type of `--cert-type` or `--key-type`, as libcurl reads it: PEM (the
/// default) or DER, in any case. -1 for any other type: securl has no PKCS#12, engines or
/// providers yet.
fn file_type_of(name : &Vec<u8>) -> i32 {
  if name.len() == 0 || same_nocase(name, &lit("PEM")) {
    return SSL_FILETYPE_PEM;
  }
  if same_nocase(name, &lit("DER")) {
    return SSL_FILETYPE_ASN1;
  }
  return -1;
}

/// Whether `a` and `b` are the same ASCII text, ignoring case.
fn same_nocase(a : &Vec<u8>, b : &Vec<u8>) -> bool {
  if a.len() != b.len() {
    return false;
  }
  let mut i = 0;
  while i < a.len() {
    let mut x = a.get(i);
    let mut y = b.get(i);
    if x >= 65u8 && x <= 90u8 {
      x = x + 32u8;
    }
    if y >= 65u8 && y <= 90u8 {
      y = y + 32u8;
    }
    if x != y {
      return false;
    }
    i = i + 1;
  }
  return true;
}

/// The files that hold the certificate authorities of common systems: Debian and Ubuntu,
/// Fedora and RHEL, openSUSE, Alpine and macOS.
fn known_ca_bundles() -> Vec<Vec<u8>> {
  let mut out = Vec<Vec<u8>>::new();
  out.push(lit("/etc/ssl/certs/ca-certificates.crt"));
  out.push(lit("/etc/pki/tls/certs/ca-bundle.crt"));
  out.push(lit("/etc/ssl/ca-bundle.pem"));
  out.push(lit("/etc/ssl/cert.pem"));
  out.push(lit("/usr/local/etc/openssl/cert.pem"));
  return out;
}

impl TlsConfig {
  /// The TLS settings for a run. `insecure` (`-k`) turns the check of the server off.
  /// `ca_file` (`--cacert`) and `ca_dir` (`--capath`) name the certificate authorities to
  /// trust. When both are empty, it uses the file of the system. Reading them needs the right
  /// to open files.
  pub fn new(_files : &Files, insecure : bool, ca_file : &Vec<u8>, ca_dir : &Vec<u8>)
  -> Result<TlsConfig, TlsError> {
    let ctx = unsafe { SSL_CTX_new(TLS_client_method()) };
    if is_null(ctx as *const i8) {
      return Result<TlsConfig, TlsError>::Err(tls_error(CURLE_SSL_CONNECT_ERROR,
        lit("SSL: could not create a context")));
    }
    let _min = unsafe {
      SSL_CTX_ctrl(ctx, SSL_CTRL_SET_MIN_PROTO_VERSION, TLS1_2_VERSION, 0 as *mut i8)
    };
    let mut config = TlsConfig {
      ctx : ctx,
      verify : !insecure,
      has_ca_error : false,
      ca_error : Vec<u8>::new(),
      has_cert_error : false,
      cert_error : tls_error(0, Vec<u8>::new())
    };
    if insecure {
      unsafe { SSL_CTX_set_verify(ctx, SSL_VERIFY_NONE, 0 as *mut i8); }
      return Result<TlsConfig, TlsError>::Ok(config);
    }
    unsafe { SSL_CTX_set_verify(ctx, SSL_VERIFY_PEER, 0 as *mut i8); }
    if ca_file.len() > 0 || ca_dir.len() > 0 {
      if ca_file.len() > 0 && !load_ca_file(ctx, ca_file) {
        config.has_ca_error = true;
        config.ca_error = lit("error setting certificate file: ");
        push_bytes(&mut config.ca_error, ca_file);
      }
      if ca_dir.len() > 0 && !load_ca_dir(ctx, ca_dir) {
        config.has_ca_error = true;
        config.ca_error = lit("error setting certificate path: ");
        push_bytes(&mut config.ca_error, ca_dir);
      }
      return Result<TlsConfig, TlsError>::Ok(config);
    }
    // The paths that OpenSSL knows, and its variables SSL_CERT_FILE and SSL_CERT_DIR.
    let _paths = unsafe { SSL_CTX_set_default_verify_paths(ctx) };
    let mut loaded = false;
    for bundle in known_ca_bundles().iter() {
      if !loaded && load_ca_file(ctx, bundle) {
        loaded = true;
      }
    }
    unsafe { ERR_clear_error(); }
    return Result<TlsConfig, TlsError>::Ok(config);
  }
}

fn push_bytes(dst : &mut Vec<u8>, src : &Vec<u8>) -> void {
  for b in src.iter() {
    dst.push(*b);
  }
}

fn load_ca_file(ctx : *mut i8, file : &Vec<u8>) -> bool {
  match c_string(file) {
    Option<Vec<i8>>::Some(c) => {
      return unsafe { SSL_CTX_load_verify_file(ctx, c.as_mut_ptr() as *const i8) } == 1;
    },
    Option<Vec<i8>>::None() => {
      return false;
    }
  }
}

fn load_ca_dir(ctx : *mut i8, dir : &Vec<u8>) -> bool {
  match c_string(dir) {
    Option<Vec<i8>>::Some(c) => {
      return unsafe { SSL_CTX_load_verify_dir(ctx, c.as_mut_ptr() as *const i8) } == 1;
    },
    Option<Vec<i8>>::None() => {
      return false;
    }
  }
}

impl TlsConfig {
  /// Load the client certificate `client` and its key, as libcurl's `client_cert` does, with
  /// its messages. An error waits for the first TLS connection, as in curl, where a plain
  /// `http://` URL does not load the certificate. Reading the files needs the right to open
  /// files.
  pub fn use_client_cert(self : &mut TlsConfig, _files : &Files, client : &ClientCert) -> void {
    match load_client_cert(self.ctx, client) {
      Option<TlsError>::Some(e) => {
        self.has_cert_error = true;
        self.cert_error = e;
      },
      Option<TlsError>::None() => {}
    }
    unsafe { ERR_clear_error(); }
  }
}

/// The error of loading `client` into `ctx`, or None.
fn load_client_cert(ctx : *mut i8, client : &ClientCert) -> Option<TlsError> {
  let mut pass = Vec<i8>::new();
  if client.has_pass {
    match c_string(&client.pass) {
      Option<Vec<i8>>::Some(c) => {
        pass = c;
      },
      Option<Vec<i8>>::None() => {}
    }
  }
  if pass.len() > 0 {
    // OpenSSL reads the password from here while it loads an encrypted key.
    unsafe { SSL_CTX_set_default_passwd_cb_userdata(ctx, pass.as_mut_ptr()); }
  }
  let result = load_cert_and_key(ctx, client);
  if pass.len() > 0 {
    unsafe { SSL_CTX_set_default_passwd_cb_userdata(ctx, 0 as *mut i8); }
  }
  return result;
}

fn load_cert_and_key(ctx : *mut i8, client : &ClientCert) -> Option<TlsError> {
  let cert_kind = file_type_of(&client.cert_type);
  if cert_kind < 0 {
    let mut m = lit("not supported file type '");
    push_bytes(&mut m, &client.cert_type);
    push_bytes(&mut m, &lit("' for certificate"));
    return Option<TlsError>::Some(tls_error(CURLE_BAD_FUNCTION_ARGUMENT, m));
  }
  let mut cert_name = Vec<i8>::new();
  match c_string(&client.cert) {
    Option<Vec<i8>>::Some(c) => {
      cert_name = c;
    },
    Option<Vec<i8>>::None() => {}
  }
  let mut loaded = 0;
  if cert_name.len() > 0 {
    if cert_kind == SSL_FILETYPE_PEM {
      loaded = unsafe { SSL_CTX_use_certificate_chain_file(ctx, cert_name.as_mut_ptr() as *const i8) };
    } else {
      loaded = unsafe {
        SSL_CTX_use_certificate_file(ctx, cert_name.as_mut_ptr() as *const i8, cert_kind)
      };
    }
  }
  if loaded != 1 {
    let mut m = lit("could not load PEM client certificate from ");
    if cert_kind == SSL_FILETYPE_ASN1 {
      m = lit("could not load ASN1 client certificate from ");
    }
    push_bytes(&mut m, &client.cert);
    push_bytes(&mut m, &lit(", OpenSSL error "));
    push_bytes(&mut m, &openssl_error_text());
    push_bytes(&mut m, &lit(", (no key found, wrong passphrase, or wrong file format?)"));
    return Option<TlsError>::Some(tls_error(CURLE_SSL_CERTPROBLEM, m));
  }
  // With no `--key`, the key is in the file of the certificate, of the same type.
  let mut key_file = clone_of(&client.cert);
  let mut key_kind = cert_kind;
  if client.key.len() > 0 {
    key_file = clone_of(&client.key);
    key_kind = file_type_of(&client.key_type);
    if key_kind < 0 {
      return Option<TlsError>::Some(tls_error(CURLE_BAD_FUNCTION_ARGUMENT,
        lit("not supported file type for private key")));
    }
  }
  let mut key_name = Vec<i8>::new();
  match c_string(&key_file) {
    Option<Vec<i8>>::Some(c) => {
      key_name = c;
    },
    Option<Vec<i8>>::None() => {}
  }
  let mut key_loaded = 0;
  if key_name.len() > 0 {
    key_loaded = unsafe {
      SSL_CTX_use_PrivateKey_file(ctx, key_name.as_mut_ptr() as *const i8, key_kind)
    };
  }
  if key_loaded != 1 {
    let mut m = lit("unable to set private key file: '");
    push_bytes(&mut m, &key_file);
    push_bytes(&mut m, &lit("' type "));
    if client.key_type.len() > 0 {
      push_bytes(&mut m, &client.key_type);
    } else {
      push_bytes(&mut m, &lit("PEM"));
    }
    return Option<TlsError>::Some(tls_error(CURLE_BAD_FUNCTION_ARGUMENT, m));
  }
  if unsafe { SSL_CTX_check_private_key(ctx) } != 1 {
    return Option<TlsError>::Some(tls_error(CURLE_SSL_CERTPROBLEM,
      lit("Private key does not match the certificate public key")));
  }
  return Option<TlsError>::None();
}

impl Drop for TlsConfig {
  fn drop(self : &mut TlsConfig) -> void {
    unsafe { SSL_CTX_free(self.ctx); }
  }
}

/// A connection to a server: plain TCP, or TLS over TCP. With TLS, OpenSSL reads and writes the
/// socket of `tcp`. The `TcpStream` closes the socket when the stream drops.
struct NetStream {
  tcp : TcpStream,
  // The OpenSSL connection, or null for plain TCP.
  ssl : *mut i8,
  // Each wait gives up at this time. `Instant::never()` means no time limit.
  deadline : Instant,
  // ALPN chose HTTP/2 in the TLS handshake.
  alpn_h2 : bool,

  invariant true,
}

/// Proof that the handshake checks whom the certificate of the server was issued to: OpenSSL
/// took the name of the server for that check, or its address when the host is an IP address.
/// Only `check_identity` makes one, and the handshake needs one, so a way to the handshake
/// that skips the check does not compile. With `-k`, `checked` is false.
struct PeerIdentity {
  checked : bool,
}

/// Tell OpenSSL to check the certificate of the server against `host`. `name` is `host` as a
/// C string. Each call gives 1 when OpenSSL took the value. When one fails, the handshake would
/// still check the chain of the certificate but not the name in it, so that any certificate
/// from a trusted CA would pass. The transfer fails instead, with curl's exit code 60.
fn check_identity(ssl : *mut i8, config : &TlsConfig, host : &Vec<u8>, name : &mut Vec<i8>,
host_is_ip : bool) -> Result<PeerIdentity, TlsError> {
  if !config.verify {
    return Result<PeerIdentity, TlsError>::Ok(PeerIdentity { checked : false });
  }
  let mut taken = 0;
  if host_is_ip {
    taken = unsafe {
      X509_VERIFY_PARAM_set1_ip_asc(SSL_get0_param(ssl), name.as_mut_ptr() as *const i8)
    };
  } else {
    taken = unsafe { SSL_set1_host(ssl, name.as_mut_ptr() as *const i8) };
  }
  if taken != 1 {
    unsafe { ERR_clear_error(); }
    let mut m = lit("SSL: cannot check the certificate of the server against '");
    push_bytes(&mut m, host);
    push_bytes(&mut m, &lit("'"));
    return Result<PeerIdentity, TlsError>::Err(tls_error(CURLE_PEER_FAILED_VERIFICATION, m));
  }
  return Result<PeerIdentity, TlsError>::Ok(PeerIdentity { checked : true });
}

/// A TLS error with curl's exit code 35, `what` and the reason from OpenSSL's error queue.
fn setup_error(what : *const i8) -> TlsError {
  let mut m = lit(what);
  let detail = openssl_error_text();
  if detail.len() > 0 {
    push_bytes(&mut m, &lit(": "));
    push_bytes(&mut m, &detail);
  }
  return tls_error(CURLE_SSL_CONNECT_ERROR, m);
}

impl NetStream {
  /// A plain TCP connection.
  pub fn plain(tcp : TcpStream) -> NetStream {
    return NetStream {
      tcp : tcp,
      ssl : unsafe { 0 as *mut i8 },
      deadline : Instant::never(),
      alpn_h2 : false
    };
  }

  /// Make each wait of the stream from now on give up at `at`.
  pub fn set_deadline(self : &mut NetStream, at : Instant) -> void {
    self.deadline = at;
  }

  /// Start TLS on this plain connection, for the server `host`, with the settings of `config`.
  /// It checks the certificate of the server against `host`, unless `config` says `-k`. A
  /// tunnel through a proxy starts TLS after the proxy said yes to CONNECT.
  pub fn start_tls(self : &mut NetStream, config : &TlsConfig, host : &Vec<u8>, host_is_ip : bool,
  offer_h2 : bool) -> Result<i32, TlsError> {
    assert(!self.is_tls(), "start_tls on a stream that uses TLS already");
    if config.has_cert_error {
      return Result<i32, TlsError>::Err(tls_error(config.cert_error.code,
        clone_of(&config.cert_error.message)));
    }
    if config.verify && config.has_ca_error {
      return Result<i32, TlsError>::Err(tls_error(CURLE_SSL_CACERT_BADFILE,
        clone_of(&config.ca_error)));
    }
    let mut name = Vec<i8>::new();
    match c_string(host) {
      Option<Vec<i8>>::Some(c) => {
        name = c;
      },
      Option<Vec<i8>>::None() => {
        return Result<i32, TlsError>::Err(tls_error(CURLE_SSL_CONNECT_ERROR,
          lit("SSL: bad host name")));
      }
    }
    let ssl = unsafe { SSL_new(config.ctx) };
    if is_null(ssl as *const i8) {
      return Result<i32, TlsError>::Err(tls_error(CURLE_SSL_CONNECT_ERROR,
        lit("SSL: could not create a connection")));
    }
    // From here, the drop of the stream frees `ssl`.
    self.ssl = ssl;
    let fd = unsafe { vx_tcp_stream_fd(self.tcp.ptr) };
    if unsafe { SSL_set_fd(ssl, fd) } != 1 {
      return Result<i32, TlsError>::Err(setup_error("SSL: SSL_set_fd failed"));
    }
    // A name gets SNI, so that the server can pick its certificate. An address gets none.
    if !host_is_ip {
      let sni = unsafe {
        SSL_ctrl(ssl, SSL_CTRL_SET_TLSEXT_HOSTNAME, TLSEXT_NAMETYPE_HOST_NAME,
          name.as_mut_ptr() as *const i8)
      };
      if sni != 1i64 {
        return Result<i32, TlsError>::Err(setup_error("Failed set SNI"));
      }
    }
    let identity = check_identity(ssl, config, host, &mut name, host_is_ip)?;
    // Offer HTTP/1.1 with ALPN, as curl does when it does not use HTTP/2.
    // With `offer_h2`, offer HTTP/2 first, as curl does for HTTPS.
    let mut alpn = Vec<u8>::new();
    if offer_h2 {
      alpn.push(2u8);
      push_bytes(&mut alpn, &lit("h2"));
    }
    alpn.push(8u8);
    push_bytes(&mut alpn, &lit("http/1.1"));
    // SSL_set_alpn_protos gives 0 when it took the list.
    if unsafe { SSL_set_alpn_protos(ssl, alpn.as_mut_ptr() as *const u8, alpn.len() as u32) } != 0 {
      return Result<i32, TlsError>::Err(setup_error("Error setting ALPN"));
    }
    return self.handshake(fd, &identity);
  }

  /// Run the TLS handshake of `start_tls`. `identity` says that OpenSSL checks the certificate
  /// against the host, unless `-k` turned the check off.
  fn handshake(self : &mut NetStream, fd : i32, identity : &PeerIdentity) -> Result<i32, TlsError> {
    let ssl = self.ssl;
    loop {
      let r = unsafe { SSL_connect(ssl) };
      if r == 1 {
        self.alpn_h2 = alpn_is_h2(ssl);
        return Result<i32, TlsError>::Ok(0);
      }
      let e = unsafe { SSL_get_error(ssl, r) };
      if e == SSL_ERROR_WANT_READ {
        if !wait_for(fd, POLLIN, self.deadline) {
          return Result<i32, TlsError>::Err(timed_out());
        }
        continue;
      }
      if e == SSL_ERROR_WANT_WRITE {
        if !wait_for(fd, POLLOUT, self.deadline) {
          return Result<i32, TlsError>::Err(timed_out());
        }
        continue;
      }
      let verify_result = unsafe { SSL_get_verify_result(ssl) };
      if identity.checked && verify_result != 0i64 {
        unsafe { ERR_clear_error(); }
        let mut m = lit("SSL certificate problem: ");
        push_bytes(&mut m, &bytes_of_c_string(unsafe { X509_verify_cert_error_string(verify_result) }));
        return Result<i32, TlsError>::Err(tls_error(CURLE_PEER_FAILED_VERIFICATION, m));
      }
      let mut m = lit("TLS connect error: ");
      let detail = openssl_error_text();
      if detail.len() > 0 {
        push_bytes(&mut m, &detail);
      } else {
        push_bytes(&mut m, &lit("the connection closed during the handshake"));
      }
      return Result<i32, TlsError>::Err(tls_error(CURLE_SSL_CONNECT_ERROR, m));
    }
  }

  /// Whether ALPN chose HTTP/2 in the TLS handshake.
  pub fn is_h2(self : &NetStream) -> bool {
    return self.alpn_h2;
  }

  /// Whether the stream uses TLS.
  pub fn is_tls(self : &NetStream) -> bool {
    return !is_null(self.ssl as *const i8);
  }

  /// Read up to `buffer.len()` bytes into `buffer` and give how many arrived. 0 means that the
  /// server closed the connection.
  pub fn read(self : &mut NetStream, buffer : &mut Vec<u8>) -> Result<u64, TlsError> {
    if !self.is_tls() {
      match read_by(&mut self.tcp, buffer, self.deadline) {
        Result<u64, NetError>::Ok(n) => {
          return Result<u64, TlsError>::Ok(n);
        },
        Result<u64, NetError>::Err(e) => {
          return Result<u64, TlsError>::Err(tcp_error(e, CURLE_RECV_ERROR,
            "Recv failure: Connection reset by peer"));
        }
      }
    }
    let fd = unsafe { vx_tcp_stream_fd(self.tcp.ptr) };
    loop {
      let r = unsafe { SSL_read(self.ssl, buffer.as_mut_ptr(), buffer.len()) };
      if r > 0 {
        return Result<u64, TlsError>::Ok(r as u64);
      }
      let e = unsafe { SSL_get_error(self.ssl, r) };
      if e == SSL_ERROR_WANT_READ {
        if !wait_for(fd, POLLIN, self.deadline) {
          return Result<u64, TlsError>::Err(timed_out());
        }
        continue;
      }
      if e == SSL_ERROR_WANT_WRITE {
        if !wait_for(fd, POLLOUT, self.deadline) {
          return Result<u64, TlsError>::Err(timed_out());
        }
        continue;
      }
      if e == SSL_ERROR_ZERO_RETURN {
        return Result<u64, TlsError>::Ok(0u64);
      }
      // Only the TLS close message (SSL_ERROR_ZERO_RETURN above) ends the stream. When the
      // connection closes without it, a body that ends with the connection could be cut, so
      // this is an error, as in curl: OpenSSL 3 reports "unexpected eof while reading".
      let detail = openssl_error_text();
      if e == SSL_ERROR_SYSCALL && detail.len() == 0 {
        // No reason from OpenSSL: the socket failed, or (in OpenSSL before 3) it closed.
        if r < 0 {
          return Result<u64, TlsError>::Err(tls_error(CURLE_RECV_ERROR,
            lit("Recv failure: Connection reset by peer")));
        }
        return Result<u64, TlsError>::Err(tls_error(CURLE_RECV_ERROR,
          lit("Connection closed abruptly")));
      }
      return Result<u64, TlsError>::Err(read_error(&detail));
    }
  }

  /// Write all of `bytes`.
  pub fn write_all(self : &mut NetStream, bytes : &Vec<u8>) -> Result<u64, TlsError> {
    if !self.is_tls() {
      match write_all_by(&mut self.tcp, bytes, self.deadline) {
        Result<u64, NetError>::Ok(n) => {
          return Result<u64, TlsError>::Ok(n);
        },
        Result<u64, NetError>::Err(e) => {
          return Result<u64, TlsError>::Err(tcp_error(e, CURLE_SEND_ERROR,
            "Send failure: Connection reset by peer"));
        }
      }
    }
    let fd = unsafe { vx_tcp_stream_fd(self.tcp.ptr) };
    let base = bytes.as_mut_ptr() as *const u8;
    let mut done : i32 = 0;
    while done < bytes.len() {
      let r = unsafe { SSL_write(self.ssl, add(base, done as usize), bytes.len() - done) };
      if r > 0 {
        done = done + r;
        continue;
      }
      let e = unsafe { SSL_get_error(self.ssl, r) };
      if e == SSL_ERROR_WANT_READ {
        if !wait_for(fd, POLLIN, self.deadline) {
          return Result<u64, TlsError>::Err(timed_out());
        }
        continue;
      }
      if e == SSL_ERROR_WANT_WRITE {
        if !wait_for(fd, POLLOUT, self.deadline) {
          return Result<u64, TlsError>::Err(timed_out());
        }
        continue;
      }
      let error = take_openssl_error();
      // The peer may have refused the connection with an alert that is still unread, as a TLS
      // 1.3 server does when it wants a client certificate, and then reset the connection.
      // curl writes a little sooner and reads the alert, so report it as curl does.
      let mut probe = unsafe { Vec<u8>::zeroed(256) };
      let got = unsafe { SSL_read(self.ssl, probe.as_mut_ptr(), 256) };
      if got <= 0 && unsafe { SSL_get_error(self.ssl, got) } == SSL_ERROR_SSL {
        let alert = openssl_error_text();
        if alert.len() > 0 {
          return Result<u64, TlsError>::Err(read_error(&alert));
        }
      }
      unsafe { ERR_clear_error(); }
      // curl's texts for the errors of SSL_write.
      if e == SSL_ERROR_SSL {
        let mut m = lit("SSL_write() error: ");
        push_bytes(&mut m, &tls_library_version());
        push_bytes(&mut m, &lit(": "));
        push_bytes(&mut m, &error.text);
        return Result<u64, TlsError>::Err(tls_error(CURLE_SEND_ERROR, m));
      }
      let mut m = lit("OpenSSL SSL_write: ");
      if error.text.len() > 0 {
        push_bytes(&mut m, &tls_library_version());
        push_bytes(&mut m, &lit(": "));
        push_bytes(&mut m, &error.text);
      } else {
        push_bytes(&mut m, &lit("SSL_ERROR_SYSCALL"));
      }
      push_bytes(&mut m, &lit(", errno "));
      push_bytes(&mut m, &u64_text(errno_of(error.code)));
      return Result<u64, TlsError>::Err(tls_error(CURLE_SEND_ERROR, m));
    }
    return Result<u64, TlsError>::Ok(bytes.len() as u64);
  }
}

fn clone_of(src : &Vec<u8>) -> Vec<u8> {
  let mut out = Vec<u8>::new();
  push_bytes(&mut out, src);
  return out;
}

impl Drop for NetStream {
  /// Send the TLS close message and free the OpenSSL connection. The `TcpStream` closes the
  /// socket after this.
  fn drop(self : &mut NetStream) -> void {
    if self.is_tls() {
      let _closed = unsafe { SSL_shutdown(self.ssl) };
      unsafe { SSL_free(self.ssl); }
    }
  }
}
